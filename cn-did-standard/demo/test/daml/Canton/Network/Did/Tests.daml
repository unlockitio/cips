module Canton.Network.Did.Tests where

import Canton.Network.Did.Seed (runSeed, runSeedStandalone, SeedParties(..))
import Canton.Network.Did.Demo
import Canton.Network.Did.V1
import Daml.Script
import DA.List (head)
import DA.NonEmpty (NonEmpty(..))

main : Script ()
main = script do
  alice <- allocateParty "DidTestAlice"
  bob <- allocateParty "DidTestBob"
  now <- getTime
  aliceCid <- submit alice do
    createCmd DemoDidDocument with
      owner = alice
      document = documentView "did:example:test-alice" "alice"
      registration = registrationView alice now
      aliases = []
  bobCid <- submit bob do
    createCmd DemoDidDocument with
      owner = bob
      document = documentView "did:example:test-bob" "bob"
      registration = registrationView bob now
      aliases = []

  let aliceRegisteredCid = toInterfaceContractId @RegisteredDidDocument aliceCid
  aliceDocument <- queryContractId alice aliceCid
  assertMsg "concrete contract carries the DidDocument interface view"
    (fmap (.document) aliceDocument == Some (documentView "did:example:test-alice" "alice"))
  dso <- allocatePartyByHint (PartyIdHint "DSO")
  let dsoDid = Did ("did:canton:" <> partyToText dso)
  let document = documentView dsoDid.value "dso"
  assertMsg "DSO retains its full runtime DID and controller"
    (document.id == dsoDid && document.controllers.hd == dsoDid && document.controllers.tl == [])
  assertMsg "demo verification methods and relationships are explicit empty lists"
    (document.verificationMethods == []
      && document.verificationRelationships.authentication == []
      && document.verificationRelationships.assertionMethod == []
      && document.verificationRelationships.capabilityInvocation == [])
  let services = document.services
  assertMsg "demo document advertises six core and two demo name-resolution services" (length services == 8)
  assertMsg "core services preserve four ordered endpoints"
    (all (\service ->
      let endpoints = service.serviceEndpoint.endpoints
      in length (endpoints.hd :: endpoints.tl) == 4
        && map (.priority) (endpoints.hd :: endpoints.tl) == [Some 0, Some 1, Some 2, Some 3]) (take 6 services))
  assertMsg "name resolution services advertise four working DID-host ports and ordered priorities"
    (map (\service ->
      let endpoints = service.serviceEndpoint.endpoints
      in (service.serviceEndpoint.version, map (.uri) (endpoints.hd :: endpoints.tl), map (.priority) (endpoints.hd :: endpoints.tl))) (drop 6 services)
      == [("1.0", map (\port -> ServiceEndpointUri ("http://localhost:" <> show port <> "/v1/resolve")) [42003, 42004, 42005, 42006], [Some 0, Some 1, Some 2, Some 3])
         , ("1.0", map (\port -> ServiceEndpointUri ("http://localhost:" <> show port <> "/v1/reverse-resolve")) [42003, 42004, 42005, 42006], [Some 0, Some 1, Some 2, Some 3])])
  standalone <- runSeedStandalone (SeedParties bob)
  standaloneDocument <- queryContractId bob (head standalone)
  assertMsg "standalone seed does not advertise unavailable Credentials proxy routes"
    (fmap (\contract -> length contract.document.services) standaloneDocument == Some 6)
  fresh <- runSeed (SeedParties dso)
  rerun <- runSeed (SeedParties dso)
  assertMsg "fresh seed creates one contract and rerun preserves it" (length fresh == 1 && fresh == rerun)
  seeded <- queryContractId dso (head fresh)
  assertMsg "fresh seed carries the four-endpoint document" (fmap (.document) seeded == Some document)
  legacy <- allocateParty "LegacyDSO"
  let legacyDid = "did:canton:" <> partyToText legacy
  let current = documentView legacyDid "dso"
  let oldServices = map (\service -> service with serviceEndpoint = (service.serviceEndpoint with endpoints = NonEmpty service.serviceEndpoint.endpoints.hd (take 2 service.serviceEndpoint.endpoints.tl))) current.services
  let oldDocument = current with services = oldServices
  oldCid <- submit legacy do createCmd ((demoDocument legacy legacyDid "dso" now) with document = oldDocument)
  preserved <- runSeed (SeedParties legacy)
  oldContract <- queryContractId legacy oldCid
  assertMsg "rerun never silently migrates an existing three-endpoint document"
    (preserved == [oldCid] && fmap (.document) oldContract == Some oldDocument)
  assertMsg "concrete contract carries the RegisteredDidDocument interface view"
    (fmap (\contract -> RegisteredDidDocumentView contract.document contract.registration) aliceDocument
      == Some (RegisteredDidDocumentView (documentView "did:example:test-alice" "alice") (registrationView alice now)))

  fetched <- submit alice do
    exerciseCmd aliceRegisteredCid RegisteredDidDocument_PublicFetch with
      expectedRegistryAdmin = alice
      actor = alice
  assertMsg "public fetch returns the registered view" (fetched.document.id == Did "did:example:test-alice")

  submitMustFail alice do
    exerciseCmd aliceRegisteredCid RegisteredDidDocument_PublicFetch with
      expectedRegistryAdmin = bob
      actor = alice

  bobDocument <- queryContractId bob bobCid
  assertMsg "Alice and Bob have distinct demo Party associations"
    (fmap (\contract -> contract.registration.registryAdmin) bobDocument == Some bob && alice /= bob)

  -- alsoKnownAs aliases are self-claims. Nothing prevents Alice and Bob from
  -- claiming the same alias, or from claiming it for a Party they do not control.
  assertMsg "seeded documents start without self-claimed aliases"
    (fmap (.aliases) aliceDocument == Some [])
  let canonical = demoNameAlias "localnet" "alice.canton" alice
  assertMsg "canonical alias is a urn:fqpn URI carrying network, resolver and name"
    (canonical.alias == "urn:fqpn:localnet:demo:alice.canton")
  aliceAliasCid <- submit alice do
    exerciseCmd aliceCid DemoDidDocument_AssertAliases with assertedAliases = [canonical]
  claimed <- queryContractId alice aliceAliasCid
  assertMsg "the owner's self-claim is recorded verbatim" (fmap (.aliases) claimed == Some [canonical])
  bobAliasCid <- submit bob do
    exerciseCmd bobCid DemoDidDocument_AssertAliases with
      assertedAliases = [canonical, demoNameAlias "localnet" "alice.canton" bob]
  conflicting <- queryContractId bob bobAliasCid
  assertMsg "duplicate and foreign-subject aliases are possible, so allocation is never implied"
    (fmap (.aliases) conflicting
      == Some [canonical, DemoNameAlias "urn:fqpn:localnet:demo:alice.canton" bob])
  submitMustFail bob do
    exerciseCmd aliceAliasCid DemoDidDocument_AssertAliases with assertedAliases = []
  seededAlias <- queryContractId dso (head fresh)
  assertMsg "the seed claims the DSO alias for its own Party only"
    (fmap (.aliases) seededAlias == Some [demoNameAlias "localnet" "dso.canton" dso])

-- The registry factory path. The administrator is a distinct Party here, which
-- is the case the seed cannot exercise because its demo registry is
-- self-administered.
testRegistryFactory : Script ()
testRegistryFactory = script do
  admin <- allocateParty "DidTestRegistryAdmin"
  owner <- allocateParty "DidTestFactoryOwner"
  intruder <- allocateParty "DidTestIntruder"
  factoryCid <- submit admin do createCmd DemoDidRegistryFactory with admin
  let factory = toInterfaceContractId @DidRegistryFactory factoryCid
  let ownerDid = Did ("did:canton:" <> partyToText owner)
  let ownerDocument = documentView ownerDid.value "owner"

  -- The owner is not a stakeholder on the factory, so it cannot use it without
  -- the administrator disclosing the contract.
  submitMustFail owner do
    exerciseCmd factory DidRegistryFactory_Create with
      owner
      expectedRegistryAdmin = admin
      document = ownerDocument

  Some factoryDisclosure <- queryDisclosure admin factoryCid
  created <- submit (actAs owner <> disclose factoryDisclosure) do
    exerciseCmd factory DidRegistryFactory_Create with
      owner
      expectedRegistryAdmin = admin
      document = ownerDocument
  let documentCid = fromInterfaceContractId @DemoDidDocument created.registeredDidDocument
  Some record <- queryContractId owner documentCid
  assertMsg "the created record is owned by the DID subject"
    (record.owner == owner && record.document == ownerDocument)
  assertMsg "registration is attributed to the factory administrator, not chosen by the owner"
    (record.registration.registryAdmin == admin)
  assertMsg "registration time and version come from registry policy"
    (record.registration.registeredAt == record.registration.updatedAt
      && record.registration.versionId == "demo-version-1"
      && not record.registration.deactivated)
  assertMsg "the factory does not claim aliases on the owner's behalf" (record.aliases == [])
  assertMsg "the DID subject is the sole controller"
    (record.document.controllers == NonEmpty ownerDid [])

  -- Both the owner and the administrator see the record, and the administrator
  -- is a co-signatory, which is what makes the attribution above verifiable.
  adminView <- queryContractId admin documentCid
  assertMsg "the registry administrator is a stakeholder on what it co-signed"
    (fmap (.owner) adminView == Some owner)
  registeredView <- submit owner do
    exerciseCmd created.registeredDidDocument RegisteredDidDocument_PublicFetch with
      expectedRegistryAdmin = admin
      actor = owner
  assertMsg "the registered view reports the factory administrator"
    (registeredView.registration.registryAdmin == admin
      && registeredView.document.id == ownerDid)

  -- Content authority stays with the owner alone. The administrator co-signed
  -- the record but cannot rewrite the document or its aliases.
  let claim = demoNameAlias "localnet" "owner.canton" owner
  aliasCid <- submit owner do
    exerciseCmd documentCid DemoDidDocument_AssertAliases with assertedAliases = [claim]
  Some claimed <- queryContractId owner aliasCid
  assertMsg "the owner edits its own document content and keeps the registration"
    (claimed.aliases == [claim] && claimed.registration.registryAdmin == admin
      && claimed.document == ownerDocument && claimed.owner == owner)
  submitMustFail admin do
    exerciseCmd aliasCid DemoDidDocument_AssertAliases with assertedAliases = []
  submitMustFail intruder do
    exerciseCmd aliasCid DemoDidDocument_AssertAliases with assertedAliases = []

  -- Rejected creations.
  submitMustFail (actAs owner <> disclose factoryDisclosure) do
    exerciseCmd factory DidRegistryFactory_Create with
      owner
      expectedRegistryAdmin = admin
      document = documentView ("did:canton:" <> partyToText intruder) "intruder"
  submitMustFail (actAs owner <> disclose factoryDisclosure) do
    exerciseCmd factory DidRegistryFactory_Create with
      owner
      expectedRegistryAdmin = admin
      document = ownerDocument with
        controllers = NonEmpty ownerDid [Did ("did:canton:" <> partyToText intruder)]
  submitMustFail (actAs owner <> disclose factoryDisclosure) do
    exerciseCmd factory DidRegistryFactory_Create with
      owner
      expectedRegistryAdmin = owner
      document = ownerDocument
  -- The owner is the controller, so nobody can register a DID for someone else.
  submitMustFail (actAs intruder <> disclose factoryDisclosure) do
    exerciseCmd factory DidRegistryFactory_Create with
      owner
      expectedRegistryAdmin = admin
      document = ownerDocument

  -- The ledger enforces no global DID uniqueness, so an owner can register the
  -- same DID again. Recording this keeps the demo honest about what the factory
  -- does not provide.
  repeated <- submit (actAs owner <> disclose factoryDisclosure) do
    exerciseCmd factory DidRegistryFactory_Create with
      owner
      expectedRegistryAdmin = admin
      document = ownerDocument
  assertMsg "repeat registration is possible, so the factory is not an allocation authority"
    (repeated.registeredDidDocument /= created.registeredDidDocument)
  duplicates <- queryFilter @DemoDidDocument owner (\contract -> contract.document.id == ownerDid)
  assertMsg "both registrations stay active and are distinguishable only by contract ID"
    (length duplicates == 2)

  -- Direct creation cannot forge the administrator's attribution: the owner
  -- alone has no authority to name a third-party registry administrator.
  now <- getTime
  submitMustFail owner do
    createCmd DemoDidDocument with
      owner
      document = ownerDocument
      registration = registrationView admin now
      aliases = []
  -- Self-administered direct creation remains possible and attributes nothing
  -- to the registry, which is how the pre-factory demo documents read.
  selfCid <- submit owner do
    createCmd DemoDidDocument with
      owner
      document = ownerDocument
      registration = registrationView owner now
      aliases = []
  Some selfRecord <- queryContractId owner selfCid
  assertMsg "a self-created record names only its own owner as registry administrator"
    (selfRecord.registration.registryAdmin == owner)
  assertMsg "so a third-party registryAdmin is evidence of factory-mediated creation"
    (selfRecord.registration.registryAdmin /= admin)

  -- The batch metadata update is deliberately unimplemented in this slice.
  submitMustFail (actAs admin) do
    exerciseCmd factory DidRegistryFactory_UpdateRegisteredDidDocuments with
      actor = admin
      updates = []
