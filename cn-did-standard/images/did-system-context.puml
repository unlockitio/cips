@startuml did-system-context
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Canton Network DID Standard - System Context

Person(subject, "DID Subject / Canton Party", "Entity identified by the DID and associated with a Canton Party ID.")
Person(controller, "DID Controller", "Role that authorizes DID Document lifecycle changes under the selected control model.")

System(standard, "Canton Network DID Standard", "Defines DID Document control and lifecycle, DID resolution, and discovery through DID Document service entries.")
System_Ext(services, "Discoverable Application Services", "Services made discoverable through DID Document service entries. Examples include DID Registries, Credential Registries, and Asset Registries.")

Rel(subject, controller, "May act as or delegate control to")
Rel(subject, standard, "Is identified by a DID governed by")
Rel(controller, standard, "Controls DID Document lifecycle according to")
Rel(standard, services, "Enables discovery through DID Document service entries")

SHOW_LEGEND()
@enduml
