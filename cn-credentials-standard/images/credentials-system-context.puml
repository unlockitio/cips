@startuml credentials-system-context
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Canton Network Credentials Standard - System Context

Person(issuer, "Credential Issuer", "Role that issues credentials through applications and may use wallets or explorers.")
Person(holder, "Credential Holder", "Role that receives and uses credentials through applications and wallets.")
Person(appUser, "App User", "Uses credential applications, wallets, and network explorers.")
Person(dsoParty, "DSO Party / SV Governance", "One DSO Party, collectively controlled by all SVs, that administers and operates the DSO Credential Registry.")

System(standard, "Canton Network Credentials Standard", "Defines portable credentials, access-policy-neutral read APIs, service discovery, and the DSO deployment profile.")

System_Ext(privateIssuance, "Direct Credential Issuance Application", "Supports credential issuance without required registry publication.")
System_Ext(publicIssuance, "Registry-facing Credential Issuance Application", "Supports credential issuance, registration, and HTTP exposure under deployment policy; its promoted DSO deployment profile is one logical registry.")
System_Ext(client, "App / Wallet Provider", "Handles direct credentials and uses registry or discovery services for users.")
System_Ext(explorer, "Network Explorer", "Consumes credential records, lifecycle information, and discovery metadata exposed under deployment policy.")

Rel(issuer, privateIssuance, "Uses for direct issuance")
Rel(issuer, publicIssuance, "Uses to issue and register")
Rel(holder, privateIssuance, "Receives and uses direct credentials")
Rel(appUser, client, "Uses app or wallet")
Rel(appUser, explorer, "Views exposed credential information")
Rel(dsoParty, publicIssuance, "Administers and operates the one logical DSO Credential Registry", "Collective SV control")
Rel(privateIssuance, standard, "Uses base credential capability", "Direct workflow; no registry required")
Rel(publicIssuance, standard, "Issues, registers, and exposes credentials according to deployment policy", "Credential, discovery, and registry APIs")
Rel(client, standard, "Handles direct credentials and invokes services", "Credential, discovery, and registry APIs")
Rel(explorer, standard, "Reads exposed records, history, and discovery metadata", "Discovery and registry read APIs")

SHOW_LEGEND()
@enduml
