@startuml credentials-system-context
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Canton Network Credentials Standard - System Context

Person(issuer, "Credential Issuer", "Role that issues credentials through applications and may use wallets or explorers.")
Person(holder, "Credential Holder", "Role that receives and uses credentials through applications and wallets.")
Person(appUser, "App User", "Uses credential applications, wallets, and network explorers.")
Person(dsoParty, "DSO Party / SV Governance", "One DSO Party, collectively controlled by all SVs, that administers and operates the one logical DSO Credential Registry.")

System(standard, "Canton Network Credentials Standard", "Defines portable credentials, lifecycle rules, and credential and registry APIs, including the Credential Registry API.")

System_Ext(privateIssuance, "Direct Credential Issuance Application", "Supports credential issuance without required registry publication.")
System_Ext(publicIssuance, "Registry-facing Credential Issuance Application", "Supports credential issuance, registration, and HTTP exposure under deployment policy.")
System_Ext(client, "App / Wallet Provider", "Handles direct credentials and uses credential and registry APIs where configured.")
System_Ext(explorer, "Network Explorer", "Consumes credential records and lifecycle information exposed under deployment policy.")
System_Ext(didResolver, "Canton Network DID Registry / Resolver", "Resolves a known registry DID and returns endpoint candidates.")

Rel(issuer, privateIssuance, "Uses for direct issuance")
Rel(issuer, publicIssuance, "Uses to issue and register")
Rel(holder, privateIssuance, "Receives and uses direct credentials")
Rel(appUser, client, "Uses app or wallet")
Rel(appUser, explorer, "Views exposed credential information")
Rel(dsoParty, publicIssuance, "Administers and operates the one logical DSO Credential Registry", "Collective SV control")
Rel(privateIssuance, standard, "Uses base credential capability", "API defined by the standard")
Rel(publicIssuance, didResolver, "Resolves a known registry DID and obtains endpoint candidates")
Rel(publicIssuance, standard, "Invokes the Credential Registry API after discovery", "API defined within the standard")
Rel(client, standard, "Handles direct credentials and invokes services", "Credential and registry APIs defined by the standard")
Rel(explorer, standard, "Reads exposed records and history", "Registry APIs defined by the standard")

SHOW_LEGEND()
@enduml
