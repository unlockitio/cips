@startuml credentials-system-context
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Canton Network Credentials Standard - System Context

Person(issuer, "Credential Issuer", "Issues credentials and identifies its claim-assessment policy.")
Person(holder, "Credential Holder", "Holds credentials and authorizes lifecycle actions.")
Person(appUser, "App User", "Uses applications that consume credentials.")
Person(client, "App / Wallet / Provider Client", "Knows an identity, party, or application context and discovers compatible services, endpoints, and permitted credential data.")
Person(explorer, "Network Explorer", "Indexes deliberately public credential events.")
Person(admin, "Registry Administrator", "Defines registry policy and owns an independent registry party or partition.")
Person(operator, "Registry Operator", "Operates registry infrastructure for an administrator; may be an SV or Validator.")

System(base, "Layer 1A: Base Credential Contract Standard", "Intrinsic issuer, holder, one-or-more credential subjects with typed claims, validity, and holder archive; usable without a registry.")
System(registry, "Layer 1B: Credential Registry Interface and API Standard", "Issuer-operated or third-party/shared RegisteredCredential capability, registration lifecycle, factory, HTTP APIs, visibility, and disclosure.")
System(discovery, "Layer 2: Application and Metadata Discovery", "Standardizes namespaced declarations of availability, endpoints or locations, capabilities, metadata, routing, and interaction details; this CIP currently uses registry APIs without making a preexisting registry a Layer 2 prerequisite.")
System(profile, "DSO Credential Registry Deployment Profile", "Concrete deployment profile, not a third layer; implements both Layer 1 interfaces and applies Layer 2 with DSO-governed policies.")
System_Ext(issuance, "Credential Issuance App", "Issuer-specific custom APIs, UIs, and issuance workflows.")
System_Ext(governance, "DSO Governance", "Controls profile policy and administrator assignment; it is not stakeholder on every credential.")

Rel(holder, issuance, "Uses", "Custom APIs and UIs")
Rel(appUser, client, "Uses application UI")
Rel(issuer, issuance, "Operates")
Rel(issuance, base, "Directly issues credentials", "Daml workflows; registry optional")
Rel(registry, base, "Builds on", "RegisteredCredential requires Credential")
Rel(issuance, registry, "Optionally registers credentials", "Daml workflows")
Rel(admin, registry, "Administers conforming registry and APIs")
Rel(operator, registry, "Operates backend and APIs")
Rel(discovery, registry, "Uses this CIP's current publication and resolution mechanism")
Rel(profile, base, "Implements Credential")
Rel(profile, registry, "Implements shared registry capability and APIs")
Rel(profile, discovery, "Applies Layer 2 with profile-specific bootstrap and routing")
Rel(governance, profile, "Governs control plane")
Rel(governance, admin, "Assigns issuer namespaces")
Rel(admin, discovery, "Publishes namespaced service declarations")
Rel(client, discovery, "Resolves compatible services from known identity or application context")
Rel(client, profile, "Reads permitted credentials", "Registry APIs")
Rel(explorer, profile, "Ingests public events", "Bulk Retrieval API")

SHOW_LEGEND()
@enduml
