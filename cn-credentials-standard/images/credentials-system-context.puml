@startuml credentials-system-context
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Canton Network Credentials Standard - System Context

Person(issuer, "Credential Issuer", "Role that issues credentials through applications and may use wallets or public explorers.")
Person(holder, "Credential Holder", "Role that receives and uses credentials through applications and wallets.")
Person(appUser, "App User", "Uses credential applications, wallets, and network explorers.")
Person(dsoParty, "DSO Party / SV Governance", "One DSO Party, collectively controlled by all SVs, that administers and operates the DSO Credential Registry.")

System(standard, "Canton Network Credentials Standard", "Defines portable credentials, registry APIs, service discovery, and the DSO deployment profile.")

System_Ext(privateIssuance, "Private Credential Issuance Application", "Supports direct or restricted credential issuance without registry publication.")
System_Ext(publicIssuance, "Public Credential Issuance Application", "Supports credential issuance and public registry publication; its promoted DSO deployment profile is one logical registry using both generic standard capabilities.")
System_Ext(client, "App / Wallet Provider", "Handles direct credentials and uses registry or discovery services for users.")
System_Ext(explorer, "Network Explorer", "Presents only publicly registered credentials and discovery metadata.")

Rel(issuer, privateIssuance, "Uses for direct or restricted issuance")
Rel(issuer, publicIssuance, "Uses to issue and publish")
Rel(holder, privateIssuance, "Receives and uses direct credentials")
Rel(appUser, client, "Uses app or wallet")
Rel(appUser, explorer, "Views public credential information")
Rel(dsoParty, publicIssuance, "Administers and operates the one logical DSO Credential Registry", "Collective SV control")
Rel(privateIssuance, standard, "Uses base credential capability", "Direct workflow; no registry required")
Rel(publicIssuance, standard, "Issues, registers, and publicizes credentials according to the DSO profile", "Credential, discovery, and registry APIs")
Rel(client, standard, "Handles direct credentials and invokes services", "Credential, discovery, and registry APIs")
Rel(explorer, standard, "Reads public registrations and discovery metadata", "Discovery and Bulk Retrieval API")

SHOW_LEGEND()
@enduml
