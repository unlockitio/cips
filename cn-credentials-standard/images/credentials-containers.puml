@startuml credentials-containers
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
title Canton Network Credentials Standard - Container View

Person(issuer, "Credential Issuer", "Issues credentials through public or private applications.")
Person(holder, "Credential Holder", "Receives and uses direct or registered credentials.")
Person(appUser, "App User", "Uses credential applications, wallets, and network explorers.")
Person(dsoParty, "DSO Party / SV Governance", "One DSO Party, collectively controlled by all SVs, that administers and operates the DSO Credential Registry.")
System_Ext(client, "App / Wallet Provider", "Handles direct credentials and uses registry or discovery services for its users.")
System_Ext(explorer, "Network Explorer", "Queries and presents only publicly visible registered credentials and discovery metadata.")
Container_Ext(privateIssuance, "Private Credential Issuance Application", "Custom application", "Provides direct or restricted issuance workflows without registry publication.")

System_Boundary(generic, "Layer 1: Credential Contract and Registry Standards") {
  Container(base, "Base Credential Contract", "Daml", "One canonical Credential contract has an intrinsic view and one or more independent holders; direct issuance does not require registration.")
  Container(registry, "Registry Capability and APIs", "Daml + HTTP", "Issuer-operated or third-party/shared mode. RegisteredCredential requires Credential; PQS-backed read APIs associate their interface projections by contract ID.")
}

System_Boundary(discoveryLayer, "Layer 2: Application and Metadata Discovery") {
  Container(discovery, "Namespaced Service Declaration and Resolution", "Layer 2", "Declares and resolves availability, endpoints or locations, capabilities, metadata, and interaction details. This CIP currently uses registry APIs without making a preexisting registry a Layer 2 prerequisite.")
}

System_Boundary(profile, "DSO Public Credential Issuance Deployment (concrete Public Credential Issuance Application instance/profile)") {
  Container(publicIssuance, "Public Credential Issuance Application", "DSO deployment", "Issues credentials, registers them, and publicizes them through registry APIs using the standard's two generic capabilities.")
  Container(dsoRegistry, "DSO Credential Registry", "Daml + PQS-backed HTTP APIs", "One logical registry administered and operated by the DSO Party. PQS continuously indexes visible contracts; physical hosting topology is unspecified.")
}

Rel(issuer, privateIssuance, "Uses for direct or restricted issuance")
Rel(issuer, publicIssuance, "Uses to issue and publish")
Rel(holder, privateIssuance, "Receives and uses direct credentials")
Rel(appUser, client, "Uses application or wallet UI")
Rel(appUser, explorer, "Views public credential information")
Rel(privateIssuance, base, "Directly issues credentials", "Daml; no registry required")
Rel(publicIssuance, base, "Issues credentials", "Daml")
Rel(registry, base, "Builds on", "RegisteredCredential requires Credential")
Rel(publicIssuance, dsoRegistry, "Publishes registrations", "Daml and registry APIs")
Rel(dsoRegistry, registry, "Implements generic registry capability and APIs")
Rel(dsoRegistry, discovery, "Publishes registry and application discovery declarations")
Rel(dsoParty, dsoRegistry, "Administers and operates", "Collective SV control")
Rel(client, discovery, "Resolves compatible services and endpoints")
Rel(explorer, discovery, "Discovers the DSO Registry endpoint")
Rel(client, dsoRegistry, "Queries credentials", "Registry APIs")
Rel(explorer, dsoRegistry, "Retrieves public credentials", "Bulk Retrieval API")

SHOW_LEGEND()
@enduml
