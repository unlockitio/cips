@startuml credentials-containers
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
title Canton Network Credentials Standard - DSO Profile Composition

Person(issuer, "Credential Issuer", "Issues credentials through a direct or registry-facing application.")
Person(clientUser, "App / Wallet User", "Uses a wallet, application, or network explorer.")
Person(dsoParty, "DSO Party / SV Governance", "Collectively administers and operates the DSO Credential Registry.")

System_Boundary(credentials, "Credentials Standard") {
  Container(credentialContract, "Credential Contract Standard", "Daml", "Defines registry-independent credentials and their lifecycle.")
  Container(credentialRegistryApi, "Credential Registry API", "credential-registry-v1 OpenAPI", "Defines the HTTP protocol for registry listing, credential retrieval, registration views, lifecycle capabilities, and event history. Canonical base path: /v1.")
}

System_Boundary(didDiscovery, "DID Resolver and DID Document Service Discovery") {
  Container(didResolver, "DID Resolver", "DID resolution", "Resolves and verifies a DID Document under the selected DID method and trusted resolver configuration.")
  Container(didDocument, "DSO Registry DID Document", "DID Document", "The DSO registry identity document contains a stable, typed, versioned service entry for the Credentials API endpoint.")
}

System_Boundary(dsoProfile, "Exploratory DSO Profile") {
  Container(dsoRegistry, "DSO Credential Registry", "Daml + PQS-backed HTTP API", "One logical registry administered and operated by the DSO Party.")
}

System_Ext(issuance, "Credential Issuance Application", "Issues credentials and, where applicable, registers them with the DSO Credential Registry.")

Rel(issuer, issuance, "Uses to issue credentials")
Rel(clientUser, didResolver, "Resolves DSO registry DID")
Rel(didResolver, didDocument, "Returns and verifies DID Document")
Rel(didDocument, clientUser, "Provides the selected service endpoint after trusted resolution")
Rel(clientUser, credentialRegistryApi, "Calls discovered endpoint", "credential-registry-v1 OpenAPI over HTTP")
Rel(issuance, credentialContract, "Creates credentials", "Daml")
Rel(issuance, dsoRegistry, "Publishes registrations", "DSO profile workflow")
Rel(dsoRegistry, credentialRegistryApi, "Exposes registry operations", "credential-registry-v1 OpenAPI over HTTP")
Rel(dsoRegistry, credentialContract, "Uses credential contracts", "Daml")
Rel(dsoParty, dsoRegistry, "Administers and operates", "Collective SV control")
Rel(dsoRegistry, didDocument, "Publishes DID Document service entry", "DSO profile composition only")

SHOW_LEGEND()
@enduml
