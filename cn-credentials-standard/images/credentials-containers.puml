@startuml
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
title DSO Credential Registry Deployment Profile - Container View

Person(issuer, "Credential Issuer", "Issues and registers credentials through the profile registry.")
Person(holder, "Credential Holder", "Receives and uses credentials through an app or wallet provider.")
Person(appUser, "App User", "Uses app, wallet, and network explorer clients.")
Person(dsoParty, "DSO Party / SV Governance", "Collectively administers and operates both profile registries.")

System_Ext(appWallet, "App / Wallet Provider", "Technical client for credential holder and app user workflows.")
System_Ext(explorer, "Network Explorer", "Technical client for registry and credential exploration.")

System_Boundary(dsoProfile, "DSO Credential Registry Deployment Profile") {
  Container(dsoRegistry, "DSO Credential Registry", "Daml + PQS-backed HTTP API", "One logical credential registry administered and operated by the DSO Party.")
  Container(dsoDidRegistry, "DSO DID Registry", "DID registry and resolution", "Publishes the profile registry DID and returns endpoint candidates under trusted resolver configuration.")
}

System_Ext(credentialsStandard, "Canton Network Credentials Standard", "Defines credential contracts, registry capabilities, and the Credentials HTTP API.")
System_Ext(didStandard, "Canton Network DID Standard", "Defines DID registry, DID Document, and resolution contracts in the current draft.")

Rel(issuer, dsoRegistry, "Issues and registers credentials", "DSO profile workflow")
Rel(holder, appWallet, "Uses")
Rel(appUser, appWallet, "Uses")
Rel(appUser, explorer, "Uses")
Rel(appWallet, dsoDidRegistry, "Resolves registry DID and discovers endpoints", "Trusted DID resolution")
Rel(explorer, dsoDidRegistry, "Resolves registry DID and discovers endpoints", "Trusted DID resolution")
Rel(appWallet, dsoRegistry, "Calls discovered endpoint directly", "credential-registry-v1 OpenAPI over HTTP")
Rel(explorer, dsoRegistry, "Calls discovered endpoint directly", "credential-registry-v1 OpenAPI over HTTP")
Rel(dsoParty, dsoRegistry, "Administers and operates", "Collective SV control")
Rel(dsoParty, dsoDidRegistry, "Administers and operates", "Collective SV control")
Rel(dsoRegistry, dsoDidRegistry, "Publishes and binds registry DID service endpoint", "DSO profile composition")
Rel(dsoRegistry, credentialsStandard, "Implements / uses", "Credential contracts and registry API")
Rel(dsoDidRegistry, didStandard, "Implements / uses", "DID contracts and resolution")

SHOW_LEGEND()
@enduml
