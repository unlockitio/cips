@startuml credentials-containers
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
title Canton Network Credentials Standard - Container View

AddElementTag("partition", $bgColor="#d5e8d4", $borderColor="#82b366", $fontColor="#000000", $legendText="Independent administrator party partitions ACS and workload.")
AddElementTag("ha", $bgColor="#f8cecc", $borderColor="#b85450", $fontColor="#000000", $legendText="Multiple hosts for one party provide HA/BFT reads, not partitioning.")

Person(issuer, "Credential Issuer", "Uses an issuer-specific application.")
Person(client, "App / Wallet / Provider Client", "Knows an identity, party, or application context and discovers compatible services and endpoints.")
Person(explorer, "Network Explorer", "Ingests public credential events across partitions.")
Person(governance, "DSO Governance", "Assigns issuer namespaces and profile policy.")
Container_Ext(issuance, "Credential Issuance App", "Custom application", "Provides issuer-specific workflows, APIs, and UIs.")

System_Boundary(generic, "Layer 1: Credential Contract and Registry Standards") {
  Container(base, "Base Credential Contract", "Daml", "Intrinsic Credential view and holder archive; direct issuance can rely on workflow-provided credentials or references without requiring a registry.")
  Container(registry, "Optional Registry Capability and APIs", "Daml + HTTP", "Issuer-operated or third-party/shared mode. RegisteredCredential requires Credential; registration metadata, candidate CredentialRegistryFactory, backend, and read APIs share one partition boundary.")
}

System_Boundary(discoveryLayer, "Layer 2: Application and Metadata Discovery") {
  Container(discovery, "Namespaced Service Declaration and Resolution", "Layer 2", "Declares and resolves availability, endpoints or locations, capabilities, metadata, routing, and interaction details. This CIP currently uses registry APIs without making a preexisting registry a Layer 2 prerequisite.")
}

System_Boundary(profile, "DSO Credential Registry Deployment Profile (implements Layer 1 and applies Layer 2)") {
  Container(partA, "Registry Partition A", "Administrator party A + backend + APIs", "Own ACS and workload for assigned issuer namespaces.", $tags="partition")
  Container(partN, "Registry Partition B .. N", "Independent administrator parties + backends + APIs", "Own ACS and workload for other assigned namespaces.", $tags="partition")
  Container(svA, "SV Operator Hosts", "SV app + Scan/index", "Multi-host one administrator party for HA and BFT reads.", $tags="ha")
  Container(valN, "Validator Operator Hosts", "Validator + registry backend/API", "May operate an assigned partition or host an administrator party.", $tags="ha")
  Container(proxy, "Registry Router / Scan Proxy", "Validator or application backend", "Discovers partitions, routes reads, and may compare replicas.")
}

Rel(issuer, issuance, "Uses")
Rel(issuance, base, "Directly issues credentials", "Daml; no registry required")
Rel(registry, base, "Builds on", "RegisteredCredential requires Credential")
Rel(issuance, registry, "Optionally runs registration workflows", "Daml")
Rel(discovery, registry, "Uses this CIP's current publication and resolution mechanism", "Registry APIs")
Rel(governance, discovery, "Publishes DSO profile namespace assignments")
Rel(discovery, client, "Returns compatible service, endpoint, capability, and invocation metadata")
Rel(discovery, explorer, "Returns DSO public partitions after the profile-specific bootstrap")
Rel(registry, partA, "Implemented by backend and APIs for assigned namespaces")
Rel(registry, partN, "Implemented by backend and APIs for assigned namespaces")
Rel(partA, svA, "Served by replicas")
Rel(partN, valN, "Served by replicas")
Rel(client, proxy, "Queries credentials", "Registry APIs")
Rel(explorer, proxy, "Ingests public events", "Bulk Retrieval API")
Rel(proxy, partA, "Routes by issuer namespace")
Rel(proxy, partN, "Routes by issuer namespace")

SHOW_LEGEND()
@enduml
