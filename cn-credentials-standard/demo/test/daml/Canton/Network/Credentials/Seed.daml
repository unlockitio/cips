module Canton.Network.Credentials.Seed where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.DemoNames
import Canton.Network.Credentials.DemoNameHolding
import Canton.Network.Credentials.Cip204CredentialsStandardTests qualified as Base204
import Canton.Network.Credentials.Cip204ExternalVcShapeTests qualified as ExternalVc
import Canton.Network.Credentials.Cip204GenericPartyProfileTests qualified as GenericProfile
import Canton.Network.Credentials.Cip169ProfileTests qualified as Profile169
import Canton.Network.Credentials.Cip209NameAllocationTests qualified as Name209
import Canton.Network.Credentials.Cip209NameHoldingTests qualified as Holding209
import Canton.Network.Credentials.Cip249ImportedNameTests qualified as Imported249
import Canton.Network.Credentials.V1
import DA.Foldable (forA_)
import DA.NonEmpty (NonEmpty(..))
import DA.Text qualified as Text
import DA.Time (addRelTime, days)
import DA.TextMap qualified as TextMap
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

seedCount : Int
seedCount = 360

seedBatchSize : Int
seedBatchSize = 30

seedValue : Int
seedValue = 20260918

data SeedParties = SeedParties with
  issuer : Party
  holderA : Party
  holderB : Party
  anchorer : Party
  registryAdmin : Party

main : Script [ContractId DemoCredential]
main = script do
  issuer <- allocatePartyByHint (PartyIdHint "DemoIssuer")
  holderA <- allocatePartyByHint (PartyIdHint "DemoHolderA")
  holderB <- allocatePartyByHint (PartyIdHint "DemoHolderB")
  anchorer <- allocatePartyByHint (PartyIdHint "DemoAnchorer")
  registryAdmin <- allocatePartyByHint (PartyIdHint "DSO")
  runSeed SeedParties with issuer; holderA; holderB; anchorer; registryAdmin

resume : SeedParties -> Script [ContractId DemoCredential]
resume = script . runSeed

runSeed : SeedParties -> Script [ContractId DemoCredential]
runSeed parties = do
  assertMsg "Demo seed parties must have distinct roles"
    (parties.issuer /= parties.registryAdmin
      && parties.anchorer /= parties.registryAdmin
      && parties.anchorer /= parties.issuer
      && parties.anchorer /= parties.holderA
      && parties.anchorer /= parties.holderB
      && parties.issuer /= parties.holderA
      && parties.issuer /= parties.holderB
      && parties.holderA /= parties.holderB)
  ensureRegistryFactory parties.registryAdmin parties.issuer
  seedMissingCredentials parties.issuer parties.holderA parties.holderB parties.registryAdmin
  seedAllCips parties
  verifySeed parties.issuer

ensureRegistryFactory : Party -> Party -> Script ()
ensureRegistryFactory registryAdmin issuer = do
  existing <- queryFilter registryAdmin (isFactoryFor registryAdmin issuer)
  case existing of
    [] -> do
      _ <- submit registryAdmin do
        createCmd DemoCredentialRegistryFactory with
          registryAdminParty = registryAdmin
          anchorers = NonEmpty issuer []
      pure ()
    _ -> pure ()
  verified <- queryFilter registryAdmin (isFactoryFor registryAdmin issuer)
  assertMsg
    ("Expected exactly one DemoCredentialRegistryFactory, found " <> show (length verified))
    (length verified == 1)

isFactoryFor : Party -> Party -> DemoCredentialRegistryFactory -> Bool
isFactoryFor registryAdmin issuer factory =
  factory.registryAdminParty == registryAdmin
    && factory.anchorers == NonEmpty issuer []

seedMissingCredentials : Party -> Party -> Party -> Party -> Script ()
seedMissingCredentials issuer holderA holderB registryAdmin = do
  existing <- queryFilter issuer isSeedCredential
  assertNoDuplicateSeedIds existing
  let missing = filter (\n -> occurrences (seedLogicalId n) existing == 0) [0 .. seedCount - 1]
  createBatches issuer holderA holderB registryAdmin missing

createBatches : Party -> Party -> Party -> Party -> [Int] -> Script ()
createBatches issuer holderA holderB registryAdmin remaining =
  case remaining of
    [] -> pure ()
    _ -> do
      let batch = take seedBatchSize remaining
      now <- getTime
      submit (actAs [issuer, holderA, holderB]) do
        forA_ batch (createCredential issuer holderA holderB registryAdmin now)
      createBatches issuer holderA holderB registryAdmin (drop seedBatchSize remaining)

verifySeed : Party -> Script [ContractId DemoCredential]
verifySeed issuer = do
  existing <- queryFilter issuer isSeedCredential
  assertNoDuplicateSeedIds existing
  assertMsg
    ("Expected " <> show seedCount <> " seeded credentials, found " <> show (length existing))
    (length existing == seedCount)
  pure (map fst existing)

-- Both Docker fresh and resume paths run positive CIP fixtures only. Test scripts
-- include duplicate-name, unverified and archive scenarios and stay on isolated ledgers.
seedAllCips : SeedParties -> Script ()
seedAllCips parties = do
  seedNames parties.registryAdmin parties.holderA parties.holderB
  seedScenarioCredentials parties
  seedNameHolding parties.registryAdmin parties.holderA parties.holderB

seedNames : Party -> Party -> Party -> Script ()
seedNames admin alice bob = do
  factories <- queryFilter admin (isFactoryFor admin admin)
  case factories of
    [] -> do
      _ <- submit admin do
        createCmd DemoCredentialRegistryFactory with registryAdminParty = admin; anchorers = NonEmpty admin []
      pure ()
    [_] -> pure ()
    _ -> abort "multiple demo name factories"
  seedName admin "alice.canton" alice
  seedName admin "bob.canton" bob
  pure ()

-- Uniqueness is the registry's off-ledger responsibility: the seed checks for
-- an existing credential before approving, because the ledger will not refuse a
-- second approval of the same name.
seedName : Party -> Text -> Party -> Script ()
seedName admin name subjectParty = do
  factories <- queryFilter admin (isFactoryFor admin admin)
  factory <- case factories of
    [(factoryId, _)] -> pure (toInterfaceContractId @CredentialRegistryFactory factoryId)
    _ -> abort "expected exactly one demo name factory"
  existing <- queryFilter admin (isNameCredential admin name)
  case existing of
    [_] -> pure ()
    _ :: _ -> abort ("demo name " <> name <> " has duplicate credentials")
    [] -> do
      now <- getTime
      let credential = Name209.seedNameCredential admin subjectParty name now
      let registration = RegisteredCredentialView admin now (Some (addRelTime now (days 180))) TextMap.empty
      request <- submit subjectParty do
        createCmd DemoNameRequest with applicant = subjectParty; registryAdmin = admin; name; credential; registration
      _ <- submit (actAs [admin, subjectParty]) do
        exerciseCmd request DemoNameRequest_AcceptAsRegistryIssued with factory
      pure ()

isNameCredential : Party -> Text -> DemoCredential -> Bool
isNameCredential admin name credential =
  credential.registryAdminParty == admin
    && credential.credential.id == Some ("urn:demo:name:" <> name)

-- Active structural examples, separate from the 360 deterministic generic records.
-- These are assertions published by demo parties, not external verification.
seedScenarioCredentials : SeedParties -> Script ()
seedScenarioCredentials parties = do
  now <- getTime
  let admin = parties.registryAdmin
  let issuer = parties.issuer
  let alice = parties.holderA
  let bob = parties.holderB
  let anchorer = parties.anchorer
  let base logicalId kinds externalIssuer subject holders claims = CredentialView with
        id = Some logicalId
        credentialTypes = "VerifiableCredential" :: kinds
        issuer = externalIssuer
        validFrom = Some now
        validUntil = Some (addRelTime now (days 7))
        credentialSubject = NonEmpty (CredentialSubject subject claims) []
        holders
        anchorers = NonEmpty issuer []
  let examples =
        [ Base204.seedBaseCredential issuer alice now
        , (ExternalVc.externalCredential "urn:demo:scenario:external-did" ["VerifiableCredential", "DiplomaCredential"] "did:ebsi:example-issuer"
            (NonEmpty (CredentialSubject (Some (W3C_VC_Identifier "did:key:example-student"))
              (TextMap.fromList [("achievement", Metadata.AV_Map (TextMap.fromList
                [("name", Metadata.AV_Text "Diploma"), ("courses", Metadata.AV_List [Metadata.AV_Text "Mathematics", Metadata.AV_Text "Physics"])]))])) []) anchorer)
            with validFrom = Some now; validUntil = Some (addRelTime now (days 7))
        , (base "urn:demo:scenario:external-holderless" ["AchievementCredential"]
            (W3C_VC_Identifier "did:key:example-issuer") None []
            (TextMap.fromList [("achievement", Metadata.AV_Map (TextMap.fromList
              [("type", Metadata.AV_Text "CourseCertificate"), ("score", Metadata.AV_Int 85)]))]))
            with anchorers = NonEmpty anchorer []
        , (base "urn:demo:scenario:expired-registration" ["AchievementCredential"]
            (W3C_VC_Identifier_Party issuer) (Some (W3C_VC_Identifier_Party alice)) [alice] TextMap.empty)
            with validUntil = Some (addRelTime now (days 30))
        , Profile169.seedProfile
            (base "urn:demo:scenario:cip169-profile" ["PartyProfile"]
              (W3C_VC_Identifier_Party issuer) (Some (W3C_VC_Identifier_Party alice)) [alice] TextMap.empty)
            issuer alice
        , GenericProfile.seedGenericProfile
            (base "urn:demo:scenario:generic-party-profile" ["PartyProfile"]
              (W3C_VC_Identifier_Party issuer) (Some (W3C_VC_Identifier_Party alice)) [bob] TextMap.empty)
            issuer alice
        , Imported249.seedImportedName alice issuer now
        ]
  forA_ examples (seedScenario admin)

seedScenario : Party -> CredentialView -> Script ()
seedScenario admin view = do
  let anchorer = case view.anchorers of NonEmpty party [] -> party; _ -> error "expected one scenario anchorer"
  existing <- queryFilter admin (\(record : DemoCredential) -> record.registryAdminParty == admin && record.credential.id == view.id)
  case existing of
    [_] -> pure ()
    [] -> do
      now <- getTime
      let expiresAt = if view.id == Some "urn:demo:scenario:expired-registration"
            then Some (addRelTime now (days (-1)))
            else Some (addRelTime now (days 7))
      _ <- submit (actAs (anchorer :: view.holders)) do
        createCmd DemoCredential with
          registryAdminParty = admin
          credential = view
          registeredAt = now
          expiresAt
          registryMeta = TextMap.fromList [("demo.example/seed", Metadata.AV_Int seedValue)]
      pure ()
    _ -> abort "duplicate scenario credential ID"

seedScenarioRolesAndExpiry : Script ()
seedScenarioRolesAndExpiry = script do
  issuer <- allocateParty "ScenarioIssuer"
  holderA <- allocateParty "ScenarioHolderA"
  holderB <- allocateParty "ScenarioHolderB"
  anchorer <- allocateParty "ScenarioAnchorer"
  registryAdmin <- allocateParty "ScenarioAdmin"
  let parties = SeedParties with issuer; holderA; holderB; anchorer; registryAdmin
  seedScenarioCredentials parties
  forA_ ["external-did", "external-holderless"] (\suffix -> do
    records <- queryFilter registryAdmin (\(record : DemoCredential) ->
      record.credential.id == Some ("urn:demo:scenario:" <> suffix))
    case records of
      [(_, record)] -> assertMsg (suffix <> " uses only DemoAnchorer as signatory")
        (record.credential.anchorers == NonEmpty anchorer []
          && record.credential.holders == []
          && credentialSignatories record.credential == [anchorer]
          && case record.credential.issuer of W3C_VC_Identifier _ -> True; _ -> False)
      _ -> abort (suffix <> " missing or duplicated"))
  other <- queryFilter registryAdmin (\(record : DemoCredential) ->
    record.credential.id == Some "urn:demo:scenario:base-credential")
  case other of
    [(_, record)] -> assertMsg "text issuer with a Party holder retains DemoIssuer"
      (record.credential.anchorers == NonEmpty issuer [] && record.credential.holders == [holderA])
    _ -> abort "base scenario missing or duplicated"
  expired <- queryFilter registryAdmin (\(record : DemoCredential) ->
    record.credential.id == Some "urn:demo:scenario:expired-registration")
  now <- getTime
  case expired of
    [(_, record)] -> assertMsg "registration expired while intrinsic validity remains future"
      (record.credential.issuer == W3C_VC_Identifier_Party issuer
        && record.credential.anchorers == NonEmpty issuer []
        && record.credential.holders == [holderA]
        && record.credential.validUntil > Some now
        && record.expiresAt < Some now)
    _ -> abort "expired-registration scenario missing or duplicated"

-- A real HoldingV1 projection, independent of registry-issued name records.
-- No name uniqueness or transfer protocol is inferred from this fixture.
seedNameHolding : Party -> Party -> Party -> Script ()
seedNameHolding admin owner otherHolder = do
  existing <- queryFilter admin (\(holding : DemoNameHolding) -> holding.registryAdminParty == admin && holding.name == "team.canton")
  case existing of
    [_] -> pure ()
    [] -> do
      now <- getTime
      let credential = (Holding209.nameCredential admin admin
            (Some (W3C_VC_Identifier_Party owner)) [owner, otherHolder] "team.canton") with
            id = Some "urn:demo:holding:team.canton"
            validFrom = Some now
            validUntil = Some (addRelTime now (days 180))
      _ <- submit admin do
        createCmd DemoNameHolding with
          registryAdminParty = admin
          name = "team.canton"
          owner
          amount = 1.0
          lock = None
          credential
      pure ()
    _ -> abort "duplicate demo name holding"

isSeedCredential : DemoCredential -> Bool
isSeedCredential credential =
  case credential.credential.id of
    Some logicalId -> Text.isPrefixOf "urn:demo:credential:" logicalId
    None -> False

assertNoDuplicateSeedIds : [(ContractId DemoCredential, DemoCredential)] -> Script ()
assertNoDuplicateSeedIds existing =
  forA_
    [0 .. seedCount - 1]
    (\n -> assertMsg
      ("Duplicate credential logical ID: " <> seedLogicalId n)
      (occurrences (seedLogicalId n) existing <= 1))

occurrences : Text -> [(ContractId DemoCredential, DemoCredential)] -> Int
occurrences logicalId existing =
  length (filter (\(_, credential) -> credential.credential.id == Some logicalId) existing)

createCredential : Party -> Party -> Party -> Party -> Time -> Int -> Commands (ContractId DemoCredential)
createCredential issuer holderA holderB registryAdmin now n = do
  let holders = if n % 3 == 0 then [holderA, holderB] else [holderA]
  let subjectId = if n % 5 == 0 then None else Some (W3C_VC_Identifier ("urn:demo:subject:" <> show (pseudoRandom n % 97)))
  let view = CredentialView with
        id = Some (seedLogicalId n)
        credentialTypes = ["VerifiableCredential", credentialCategory n]
        issuer = W3C_VC_Identifier_Party issuer
        validFrom = Some now
        validUntil = if n % 11 == 0 then None else Some (addRelTime now (days 180))
        credentialSubject = NonEmpty (CredentialSubject subjectId (mkClaims n)) []
        holders
        anchorers = NonEmpty issuer []
  createCmd DemoCredential with
    registryAdminParty = registryAdmin
    credential = view
    registeredAt = now
    expiresAt = if n % 13 == 0 then None else Some (addRelTime now (days 90))
    registryMeta = TextMap.fromList
      [("demo.example/seed", Metadata.AV_Int seedValue)]

seedLogicalId : Int -> Text
seedLogicalId n = "urn:demo:credential:" <> pad3 n

pad3 : Int -> Text
pad3 n
  | n < 10 = "00" <> show n
  | n < 100 = "0" <> show n
  | otherwise = show n

pseudoRandom : Int -> Int
pseudoRandom n = (n * 1103515245 + seedValue) % 2147483647
