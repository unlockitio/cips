-- Draft #204-inspired credential model in this replacement proposal: these
-- scenarios model the STRUCTURE of published external W3C VC examples to show
-- what the demo can carry. They are not draft #204 or W3C VC conformance
-- claim: no JSON-LD processing, cryptographic proof verification, or @context
-- resolution happens on-ledger.
-- https://github.com/danubetech/ebsi4austria-examples/blob/eebf4518d3c35bd5b268e01d226695a813520f0f/verifiablecredentials/diploma-tu-graz.jsonld
-- https://github.com/digitalcredentials/mit-learn-obv3-template/blob/1c8698751e7e725de41d4a7f268450308bdc1635/certificates/courseCertificate.json
-- https://docs.privado.id/docs/js-sdk/js-sdk-example/#output-of-run-command
-- https://docs.cheqd.io/product/api-reference/combined/verifiable-credentials
module Canton.Network.Credentials.Cip204ExternalVcShapeTests where

import Canton.Network.Credentials.TestSupport
import Canton.Network.Credentials.V1
import DA.Date (date, Month(..))
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import DA.Time (days, time)
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

text = Metadata.AV_Text
object = Metadata.AV_Map . TextMap.fromList

-- Demo-local !typed siblings are unrelated to CIP #169's !subject suffix.
-- Keep the external ISO-8601 string under its original key: AV_Time holds a
-- useful typed instant, but loses lexical details needed to re-serialise JSON
-- byte-for-byte (fractional digits, offset spelling and trailing Z).
ebsiAchievementTime : Time
ebsiAchievementTime = time (date 2021 Mar 18) 0 0 0

mitStart : Time
mitStart = time (date 2025 Feb 24) 0 0 0

mitEnd : Time
mitEnd = time (date 2030 Jan 1) 0 0 0

privadoExpiration : Time
privadoExpiration = time (date 2361 Mar 21) 19 14 48

proofCreated : Time
proofCreated = time (date 2021 Oct 17) 12 50 56

single : CredentialView -> CredentialSubject
single view = case view.credentialSubject of
  NonEmpty subject [] -> subject
  _ -> error "expected exactly one subject"

claim : Text -> CredentialSubject -> Optional Metadata.AnyValue
claim key subject = TextMap.lookup key subject.claims

nested : Text -> Metadata.AnyValue -> Optional Metadata.AnyValue
nested key value = case value of
  Metadata.AV_Map entries -> TextMap.lookup key entries
  _ -> None

-- Demo-local encoding: JSON objects become AV_Map and arrays become AV_List.
externalCredential : Text -> [Text] -> Text -> NonEmpty CredentialSubject -> Party -> CredentialView
externalCredential identifier types issuer subjects anchorer = CredentialView with
  id = Some identifier
  credentialTypes = types
  issuer = W3C_VC_Identifier issuer
  validFrom = None
  validUntil = None
  credentialSubject = subjects
  credentialSchema = []
  -- TODO(subtask C): replace structural placeholder with signed external fixture.
  securing = placeholderEnvelope identifier
  holders = []
  anchorers = NonEmpty anchorer []

roundTrip : Text -> Party -> ContractId CredentialRegistryFactory -> RegisteredCredentialView -> CredentialView -> Script CredentialView
roundTrip label anchorer factory registration credential = do
  cid <- anchorCredential [anchorer] factory credential registration
  recorded <- queryContractId anchorer cid
  case recorded of
    None -> abort (label <> ": anchored contract missing")
    Some record -> do
      assertMsg (label <> ": credential round trip") (record.credential == credential)
      pure record.credential

ebsiDiploma : Script ()
ebsiDiploma = script do
  anchorer <- allocateParty "EbsiDiplomaAnchorer"
  admin <- allocateParty "EbsiDiplomaAdmin"
  now <- getTime
  factory <- createCredentialFactory admin (NonEmpty anchorer [])
  let registration = RegisteredCredentialView admin now None TextMap.empty
  let subject = CredentialSubject
        (Some (W3C_VC_Identifier "did:key:z6MkqyYXcBQZ5hZ9BFHBiVnmrZ1C1HCpesgZQoTdgjLdU6Ah"))
        (TextMap.fromList
          [ ("type", Metadata.AV_List [text "Student"])
          , ("studyProgram", text "Master Studies in Computer Science")
          , ("learningAchievement", text "Master of Science")
          , ("dateOfAchievement", text "2021-03-18T00:00:00.000Z")
          , ("dateOfAchievement!typed", Metadata.AV_Time ebsiAchievementTime)
          -- Demo-local date-only narrowing of an external full date-time.
          , ("dateOfAchievementDate!typed", Metadata.AV_Date (date 2021 Mar 18))
          , ("eqfLevel", text "http://data.europa.eu/snb/eqf/7")
          , ("targetFrameworkName", text "European Qualifications Framework for lifelong learning - (2008/C 111/01)")
          ])
  let credential = externalCredential "urn:demo:ebsi-diploma" ["VerifiableCredential", "VerifiableAttestation", "DiplomaCredential"] "did:ebsi:zuoS6VfnmNLduF2dynhsjBU" (NonEmpty subject []) anchorer
  view <- roundTrip "EBSI TU Graz diploma" anchorer factory registration credential
  assertMsg "EBSI: textual DID issuer, not Party" (case view.issuer of
    W3C_VC_Identifier value -> value == "did:ebsi:zuoS6VfnmNLduF2dynhsjBU"
    W3C_VC_Identifier_Party _ -> False)
  assertMsg "EBSI: no holder and all three types" (view.holders == [] && view.credentialTypes == ["VerifiableCredential", "VerifiableAttestation", "DiplomaCredential"])
  assertMsg "EBSI: exact subject and flat claims" (single view == subject)
  assertMsg "EBSI: verbatim timestamp and typed instant/date"
    (claim "dateOfAchievement" (single view) == Some (text "2021-03-18T00:00:00.000Z")
      && claim "dateOfAchievement!typed" (single view) == Some (Metadata.AV_Time (time (date 2021 Mar 18) 0 0 0))
      && claim "dateOfAchievementDate!typed" (single view) == Some (Metadata.AV_Date (date 2021 Mar 18)))
  -- The labelled submitMustFail documents intent; any failure makes it pass.
  issueRejects "ebsi diploma: textual DID issuer cannot use Party Issue path" [anchorer] factory credential registration

-- The README's annotated example differs: it shows a subject id and two proofs.
-- This fixture models the actual courseCertificate.json, whose subject has no id.
-- issuerProfile is a demo-local preservation key, not a VC standard field here.
mitCertificate : Party -> Text -> Text -> Time -> Time -> CredentialView
mitCertificate anchorer kind achievementId from until =
  (externalCredential ("urn:demo:mit:" <> kind) ["VerifiableCredential", "OpenBadgeCredential"]
    "did:key:z6MknNQD1WHLGGraFi6zcbGevuAgkVfdyCdtZnQTGWVVvR5Q"
    (NonEmpty (CredentialSubject None (TextMap.fromList
      [ ("type", Metadata.AV_List [text "AchievementSubject"])
      , ("activityStartDate", text "2025-02-24T00:00:00Z")
      , ("activityStartDate!typed", Metadata.AV_Time mitStart)
      , ("activityEndDate", text "2030-01-01T00:00:00Z")
      , ("activityEndDate!typed", Metadata.AV_Time mitEnd)
      -- Demo-local lexical companions for native CredentialView validity bounds.
      , ("validFrom", text "2025-02-24T00:00:00Z")
      , ("validFrom!typed", Metadata.AV_Time mitStart)
      , ("validUntil", text "2030-01-01T00:00:00Z")
      , ("validUntil!typed", Metadata.AV_Time mitEnd)
      , ("identifier", Metadata.AV_List [object
          [ ("type", text "IdentityObject"), ("identityHash", text "Lucas Delisle-Doray")
          , ("identityType", text "name"), ("hashed", Metadata.AV_Bool False)
          , ("salt", text "not-used") ]])
      , ("issuerProfile", object
          [ ("name", text "MIT Learn"), ("type", Metadata.AV_List [text "Profile"])
          , ("image", object [("id", text "https://example.org/mit-learn-logo"), ("type", text "Image"), ("caption", text "MIT Learn logo")]) ])
      , ("achievement", object
          [ ("id", text achievementId), ("achievementType", text kind)
          , ("type", Metadata.AV_List [text "Achievement"])
          , ("image", object [("id", text "https://example.org/course-image"), ("type", text "Image"), ("caption", text "MIT Learn course image")])
          , ("criteria", object [("narrative", text "Course completion criteria")])
          , ("description", text "Course completion"), ("name", text "Foundations of Universal AI") ])
      ])) []) anchorer) with validFrom = Some from; validUntil = Some until

mitLearnCertificates : Script ()
mitLearnCertificates = script do
  anchorer <- allocateParty "MitLearnAnchorer"
  admin <- allocateParty "MitLearnAdmin"
  now <- getTime
  let registration = RegisteredCredentialView admin now None TextMap.empty
  factory <- createCredentialFactory admin (NonEmpty anchorer [])
  checkMitKind anchorer factory registration ("Course", "https://something.org/theCourse")
  checkMitKind anchorer factory registration ("Module", "https://something.org/theModule")
  checkMitKind anchorer factory registration ("Program", "https://something.org/theProgram")

checkMitKind : Party -> ContractId CredentialRegistryFactory -> RegisteredCredentialView -> (Text, Text) -> Script ()
checkMitKind anchorer factory registration (kind, identifier) = do
  let credential = mitCertificate anchorer kind identifier mitStart mitEnd
  view <- roundTrip ("MIT Learn " <> kind) anchorer factory registration credential
  let subject = single view
  assertMsg "MIT: subject id absent, issuer DID and no Party holder"
    (subject.id == None && view.holders == [] && view.issuer == W3C_VC_Identifier "did:key:z6MknNQD1WHLGGraFi6zcbGevuAgkVfdyCdtZnQTGWVVvR5Q")
  assertMsg "MIT: named identifier array retains boolean false"
    (claim "identifier" subject == Some (Metadata.AV_List [object
      [("type", text "IdentityObject"), ("identityHash", text "Lucas Delisle-Doray"), ("identityType", text "name"), ("hashed", Metadata.AV_Bool False), ("salt", text "not-used")]]))
  assertMsg "MIT: nested achievement id and type"
    (case claim "achievement" subject of
      Some achievement -> nested "id" achievement == Some (text identifier) && nested "achievementType" achievement == Some (text kind)
      _ -> False)
  assertMsg "MIT: nested image caption and criteria narrative survive"
    (case claim "achievement" subject of
      Some achievement -> case (nested "image" achievement, nested "criteria" achievement) of
        (Some image, Some criteria) -> nested "caption" image == Some (text "MIT Learn course image") && nested "narrative" criteria == Some (text "Course completion criteria")
        _ -> False
      _ -> False)
  assertMsg "MIT: published native validity bounds" (view.validFrom == Some (time (date 2025 Feb 24) 0 0 0) && view.validUntil == Some (time (date 2030 Jan 1) 0 0 0))
  assertMsg "MIT: verbatim and typed activity/validity instants"
    (claim "activityStartDate" subject == Some (text "2025-02-24T00:00:00Z")
      && claim "activityStartDate!typed" subject == Some (Metadata.AV_Time mitStart)
      && claim "activityEndDate" subject == Some (text "2030-01-01T00:00:00Z")
      && claim "activityEndDate!typed" subject == Some (Metadata.AV_Time mitEnd)
      && claim "validFrom" subject == Some (text "2025-02-24T00:00:00Z")
      && claim "validFrom!typed" subject == Some (Metadata.AV_Time mitStart)
      && claim "validUntil" subject == Some (text "2030-01-01T00:00:00Z")
      && claim "validUntil!typed" subject == Some (Metadata.AV_Time mitEnd))

privadoAge : Script ()
privadoAge = script do
  anchorer <- allocateParty "PrivadoAnchorer"
  admin <- allocateParty "PrivadoAdmin"
  now <- getTime
  factory <- createCredentialFactory admin (NonEmpty anchorer [])
  let registration = RegisteredCredentialView admin now None TextMap.empty
  -- Demo-local: reuse the published urn as the optional credential id. Schema
  -- is VC-aligned; external status remains an opaque claim, not a view field.
  let credential = (externalCredential "urn:ad777d04-15e9-42ad-bc31-f8acd7191439"
        ["VerifiableCredential", "KYCAgeCredential"]
        "did:iden3:polygon:amoy:wzokvZ6kMoocKJuSbftdZxTD6qvayGpJb3m4FVXth"
        (NonEmpty (CredentialSubject
          (Some (W3C_VC_Identifier "did:iden3:polygon:amoy:wzwAyDLHL6Nhtj3TnFfUnP7osASXb9hS8BTfa2zeo"))
          (TextMap.fromList
            [ ("birthday", Metadata.AV_Int 19960424), ("documentType", Metadata.AV_Int 99)
            , ("type", text "KYCAgeCredential")
            , ("credentialStatus", object [("id", text "https://rhs-staging.polygonid.me"), ("revocationNonce", Metadata.AV_Int 4303), ("type", text "Iden3ReverseSparseMerkleTreeProof")])
            , ("expirationDate", text "2361-03-21T19:14:48.000Z")
            , ("expirationDate!typed", Metadata.AV_Time privadoExpiration) ])) []) anchorer) with
          credentialSchema = [CredentialSchema
            "https://raw.githubusercontent.com/iden3/claim-schema-vocab/main/schemas/json/KYCAgeCredential-v2.json"
            "JsonSchemaValidator2018" None]
  view <- roundTrip "Privado age" anchorer factory registration credential
  assertMsg "Privado: schema is a native credentialSchema entry" (view.credentialSchema == credential.credentialSchema)
  assertMsg "Privado: urn id, DID issuer, no holder" (view.id == Some "urn:ad777d04-15e9-42ad-bc31-f8acd7191439" && view.holders == [])
  assertMsg "Privado: verbatim expiry and typed instant"
    (claim "expirationDate" (single view) == Some (text "2361-03-21T19:14:48.000Z")
      && claim "expirationDate!typed" (single view) == Some (Metadata.AV_Time (time (date 2361 Mar 21) 19 14 48)))
  assertMsg "Privado: numeric claims remain integers" (claim "birthday" (single view) == Some (Metadata.AV_Int 19960424) && claim "documentType" (single view) == Some (Metadata.AV_Int 99))
  assertMsg "Privado: opaque status nonce remains integer" (case claim "credentialStatus" (single view) of
    Some status -> nested "revocationNonce" status == Some (Metadata.AV_Int 4303)
    _ -> False)
  debug "Privado: external revocation state is opaque; archiving does not evaluate Iden3ReverseSparseMerkleTreeProof"
  cid <- anchorCredential [anchorer] factory credential registration
  archiveCredentialAsAnchorers anchorer cid
  archived <- queryContractId anchorer cid
  assertMsg "Privado: ledger contract archived independently of external status" (archived == None)

cheqdSuspension : Script ()
cheqdSuspension = script do
  anchorer <- allocateParty "CheqdAnchorer"
  admin <- allocateParty "CheqdAdmin"
  now <- getTime
  factory <- createCredentialFactory admin (NonEmpty anchorer [])
  let registration = RegisteredCredentialView admin now None TextMap.empty
  let base = TextMap.fromList
        [ ("name", text "Bob"), ("gender", text "male")
        , ("credentialStatus", object
            [ ("id", text "https://resolver.cheqd.net/1.0/identifiers/did:cheqd:testnet:7c2b990c-3d05-4ebf-91af-f4f4d0091d2e?resourceName=cheqd-suspension-1&resourceType=StatusList2021Suspension#20")
            , ("statusIndex", Metadata.AV_Int 20), ("statusPurpose", text "suspension"), ("type", text "StatusList2021Entry") ]) ]
  let subject claims = CredentialSubject (Some (W3C_VC_Identifier "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK")) claims
  let credential = externalCredential "urn:demo:cheqd" ["VerifiableCredential", "Person"]
        "did:cheqd:testnet:7bf81a20-633c-4cc7-bc4a-5a45801005e0" (NonEmpty (subject base) []) anchorer
  view <- roundTrip "cheqd suspension" anchorer factory registration credential
  assertMsg "cheqd: DID issuer, no holder, opaque suspension status" (view.holders == [] && view.issuer == W3C_VC_Identifier "did:cheqd:testnet:7bf81a20-633c-4cc7-bc4a-5a45801005e0" && case claim "credentialStatus" (single view) of
    Some status -> nested "statusIndex" status == Some (Metadata.AV_Int 20) && nested "statusPurpose" status == Some (text "suspension")
    _ -> False)
  -- Demo-local claim encoding of documented API inputs, NOT fields observed in
  -- the displayed issued cheqd credential. No policy or evidence evaluation.
  let prohibition = object
        [ ("assigner", text "https://example.edu/issuers/14"), ("assignee", text "AllVerifiers")
        , ("target", text "http://example.edu/credentials/3732")
        , ("action", Metadata.AV_List [text "Archival"]) ]
  let terms = object
        [ ("type", text "IssuerPolicy"), ("id", text "http://example.com/policies/credential/4")
        , ("profile", text "http://example.com/profiles/credential")
        , ("prohibition", Metadata.AV_List [prohibition]) ]
  let evidence = object
        [ ("type", Metadata.AV_List [text "DocumentVerification"])
        , ("id", text "https://example.edu/evidence/f2aeec97-fc0d-42bf-8ca7-0548192d4231")
        , ("verifier", text "https://example.edu/issuers/14")
        , ("evidenceDocument", text "DriversLicense"), ("subjectPresence", text "Physical")
        , ("documentPresence", text "Physical"), ("licenseNumber", text "123AB4567") ]
  let enriched = credential with id = Some "urn:demo:cheqd:inputs"; credentialSubject = NonEmpty (subject (TextMap.insert "termsOfUse" terms (TextMap.insert "evidence" evidence base))) []
  enrichedView <- roundTrip "cheqd optional API inputs" anchorer factory registration enriched
  assertMsg "cheqd: evidence preserved as nested claim" (claim "evidence" (single enrichedView) == Some evidence)
  assertMsg "cheqd: array of prohibitions containing action array preserved" (case claim "termsOfUse" (single enrichedView) of
    Some value -> nested "prohibition" value == Some (Metadata.AV_List [prohibition]) && nested "action" prohibition == Some (Metadata.AV_List [text "Archival"])
    _ -> False)

-- CIP identifier filtering is a consumer-side predicate, not an HTTP call.
subjectMatches : W3C_VC_Identifier -> CredentialSubject -> Bool
subjectMatches identifier subject = subject.id == Some identifier

multipleSubjects : Script ()
multipleSubjects = script do
  anchorer <- allocateParty "MultipleSubjectsAnchorer"
  admin <- allocateParty "MultipleSubjectsAdmin"
  now <- getTime
  factory <- createCredentialFactory admin (NonEmpty anchorer [])
  let registration = RegisteredCredentialView admin now None TextMap.empty
  let did = W3C_VC_Identifier "did:key:demo-multiple-subjects"
  let first = CredentialSubject (Some did) (TextMap.fromList [("name", text "First")])
  let second = CredentialSubject None (TextMap.fromList [("name", text "Second")])
  -- Demo-local capability fixture: none of the four external examples has two subjects.
  let credential = externalCredential "urn:demo:multiple-subjects" ["VerifiableCredential"] "did:example:issuer" (NonEmpty first [second]) anchorer
  view <- roundTrip "multiple subjects" anchorer factory registration credential
  assertMsg "two subjects survive in order" (view.credentialSubject == NonEmpty first [second])
  assertMsg "absent id never matches identifier filter" (case view.credentialSubject of
    NonEmpty a [b] -> subjectMatches did a && not (subjectMatches did b) && not (subjectMatches (W3C_VC_Identifier "did:example:other") b)
    _ -> False)

opaqueProof : Script ()
opaqueProof = script do
  anchorer <- allocateParty "OpaqueProofAnchorer"
  admin <- allocateParty "OpaqueProofAdmin"
  now <- getTime
  factory <- createCredentialFactory admin (NonEmpty anchorer [])
  let registration = RegisteredCredentialView admin now None TextMap.empty
  -- Demo-local claim key: the external proof is merely opaque claim data.
  -- This fixture uses a placeholder for the published JWS, not a signature test.
  let proof = object
        [ ("type", text "EcdsaSecp256k1Signature2019")
        , ("created", text "2021-10-17T12:50:56Z")
        , ("created!typed", Metadata.AV_Time proofCreated)
        , ("proofPurpose", text "assertionMethod")
        , ("verificationMethod", text "did:ebsi:zuoS6VfnmNLduF2dynhsjBU#keys-1")
        , ("jws", text "<the jws string>") ]
  let credential = externalCredential "urn:demo:opaque-proof" ["VerifiableCredential"] "did:ebsi:zuoS6VfnmNLduF2dynhsjBU"
        (NonEmpty (CredentialSubject None (TextMap.fromList [("externalProof", proof)])) []) anchorer
  view <- roundTrip "opaque external proof" anchorer factory registration credential
  assertMsg "external proof text round trips unchanged" (claim "externalProof" (single view) == Some proof && case claim "externalProof" (single view) of
    Some value -> nested "jws" value == Some (text "<the jws string>")
    _ -> False)
  assertMsg "proof: verbatim created timestamp and typed instant"
    (case claim "externalProof" (single view) of
      Some value -> nested "created" value == Some (text "2021-10-17T12:50:56Z")
        && nested "created!typed" value == Some (Metadata.AV_Time (time (date 2021 Oct 17) 12 50 56))
      _ -> False)
  debug "Ledger does not verify this signature: anchorers only authorize publication, not external proof validity"

-- Synthetic, demo-local constructor coverage, not additional fields observed in
-- any of the four external documents. No source has a decimal-valued claim.
-- The typed re-verification cadence models CIP #249's seven-day interval, not
-- proof that the ledger schedules or performs re-verification.
typedClaimValueCoverage : Script ()
typedClaimValueCoverage = script do
  anchorer <- allocateParty "TypedValueAnchorer"
  admin <- allocateParty "TypedValueAdmin"
  mentioned <- allocateParty "MentionedCantonParty"
  now <- getTime
  factory <- createCredentialFactory admin (NonEmpty anchorer [])
  let registration = RegisteredCredentialView admin now None TextMap.empty
  let predecessor = externalCredential "urn:demo:typed-predecessor" ["VerifiableCredential"] "did:example:external-issuer"
        (NonEmpty (CredentialSubject None TextMap.empty) []) anchorer
  predecessorCid <- anchorCredential [anchorer] factory predecessor registration
  -- AV_ContractId is a ledger-local contract-id reference, not a W3C VC URI.
  -- AV_Party names a statement's subject; it does not make this Party an
  -- issuer, holder or signatory, and grants it no authorization.
  let values = TextMap.fromList
        [ ("syntheticScore", Metadata.AV_Decimal 97.5)
        , ("reverificationCadence", Metadata.AV_RelTime (days 7))
        , ("attestedCantonParty", Metadata.AV_Party mentioned)
        , ("attestationOf", Metadata.AV_ContractId (coerceContractId predecessorCid)) ]
  let credential = externalCredential "urn:demo:typed-claims" ["VerifiableCredential"] "did:example:external-issuer"
        (NonEmpty (CredentialSubject None values) []) anchorer
  view <- roundTrip "synthetic typed claims" anchorer factory registration credential
  assertMsg "typed claims: decimal, duration, Party, and contract id survive"
    (claim "syntheticScore" (single view) == Some (Metadata.AV_Decimal 97.5)
      && claim "reverificationCadence" (single view) == Some (Metadata.AV_RelTime (days 7))
      && claim "attestedCantonParty" (single view) == Some (Metadata.AV_Party mentioned)
      && claim "attestationOf" (single view) == Some (Metadata.AV_ContractId (coerceContractId predecessorCid)))
  assertMsg "typed claims: external DID issuer and no holder"
    (view.issuer == W3C_VC_Identifier "did:example:external-issuer" && view.holders == [] && view.anchorers == NonEmpty anchorer [])
