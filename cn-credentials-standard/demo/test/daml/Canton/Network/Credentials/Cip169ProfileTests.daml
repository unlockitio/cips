-- Draft CIP #169 holder-centric claims, distinct from generic explicit-subject
-- profiles. This ledger fixture does not establish CIP #169 conformance or test
-- HTTP lookup or UI rendering.
module Canton.Network.Credentials.Cip169ProfileTests where

import Canton.Network.Credentials.TestSupport
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, days)
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

-- The CIP number is unassigned. This literal is a test namespace, not a published key prefix.
prefix : Text
prefix = "cip-<nr>/"

profileClaims : TextMap.TextMap Metadata.AnyValue
profileClaims = TextMap.fromList
  [ (prefix <> "display-name", Metadata.AV_Text "Alice")
  , (prefix <> "description", Metadata.AV_Text "A description")
  , (prefix <> "keywords", Metadata.AV_Text "defi, wallet")
  , (prefix <> "notice", Metadata.AV_Text "Notice")
  , (prefix <> "avatar", Metadata.AV_Text "https://cdn.example/a.png")
  , (prefix <> "website", Metadata.AV_Text "https://example.org")
  , (prefix <> "email", Metadata.AV_Text "alice@example.org")
  , (prefix <> "phone", Metadata.AV_Text "+15551234567")
  , (prefix <> "location", Metadata.AV_Text "New York, USA")
  , (prefix <> "mail", Metadata.AV_Text "PO Box 1")
  , (prefix <> "social:telegram", Metadata.AV_Text "alice")
  , (prefix <> "social:x", Metadata.AV_Text "aliceX")
  , (prefix <> "social:github", Metadata.AV_Text "alice-git")
  , (prefix <> "social:linkedin", Metadata.AV_Text "alice-link")
  , (prefix <> "social:discord", Metadata.AV_Text "alice-discord")
  ]

seedProfile : CredentialView -> Party -> Party -> CredentialView
seedProfile base issuer holder = base with
  issuer = W3C_VC_Identifier_Party issuer
  credentialSubject = NonEmpty (CredentialSubject
    (Some (W3C_VC_Identifier_Party holder))
    (TextMap.fromList [(prefix <> "displayName", Metadata.AV_Text "Alice demo profile")])) []
  holders = [holder]

main : Script ()
main = script do
  holder <- allocateParty "ProfileHolder"
  issuer <- allocateParty "ProfileIssuer"
  admin <- allocateParty "ProfileRegistryAdmin"
  now <- getTime
  let subject = NonEmpty (CredentialSubject
        (Some (W3C_VC_Identifier_Party holder)) profileClaims) []
  let self = CredentialView with
        id = Some "urn:test:profile:self"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier_Party holder
        validFrom = Some now
        validUntil = Some (addRelTime now (days 30))
        credentialSubject = subject
        holders = [holder]
        anchorers = NonEmpty holder [admin]
  let other = self with
        id = Some "urn:test:profile:other"
        issuer = W3C_VC_Identifier_Party issuer
        anchorers = NonEmpty issuer [admin]
  let registration = RegisteredCredentialView admin now (Some (addRelTime now (days 12))) TextMap.empty
  factory <- createCredentialFactory admin self.anchorers
  selfCid <- issueCredential [admin, holder] factory self registration
  otherCid <- issueCredential [admin, holder, issuer] factory other registration
  selfRecord <- queryContractId holder selfCid
  otherRecord <- queryContractId holder otherCid
  assertMsg "self-issued profile describes its operational holder"
    (fmap (.credential) selfRecord == Some self
      && self.holders == [holder] && self.issuer == W3C_VC_Identifier_Party holder
      && self.credentialSubject == subject)
  assertMsg "another issuer publishes the same fifteen holder claims without changing the subject"
    (fmap (.credential) otherRecord == Some other
      && other.holders == [holder] && other.issuer == W3C_VC_Identifier_Party issuer
      && other.credentialSubject == subject && TextMap.size profileClaims == 15)
  _ <- submit (actAs [holder, admin]) do
    exerciseCmd (toInterfaceContractId @Credential selfCid) Credential_ArchiveAsAnchorers
  archived <- queryContractId holder selfCid
  remaining <- queryContractId holder otherCid
  assertMsg "archiving the self-issued record leaves the other issuer's claims independent"
    (archived == None && fmap (.credential) remaining == Some other)
