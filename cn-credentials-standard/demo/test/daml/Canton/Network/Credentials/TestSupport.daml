-- Shared cross-CIP test helpers; not evidence of any individual CIP conformance.
module Canton.Network.Credentials.TestSupport where


import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.DemoNames
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import Daml.Script

createCredentialFactory : Party -> NonEmpty Party -> Script (ContractId CredentialRegistryFactory)
createCredentialFactory admin anchorers = do
  cid <- submit admin do
    createCmd DemoCredentialRegistryFactory with registryAdminParty = admin; anchorers
  pure (toInterfaceContractId @CredentialRegistryFactory cid)

issueCredential : [Party] -> ContractId CredentialRegistryFactory -> CredentialView -> RegisteredCredentialView -> Script (ContractId DemoCredential)
issueCredential actors factory credential registration = do
  result <- submit (actAs actors) do
    exerciseCmd factory CredentialRegistryFactory_Issue with credential; registration
  pure (fromInterfaceContractId @DemoCredential @RegisteredCredential result.issuedCredential)

anchorCredential : [Party] -> ContractId CredentialRegistryFactory -> CredentialView -> RegisteredCredentialView -> Script (ContractId DemoCredential)
anchorCredential actors factory credential registration = do
  result <- submit (actAs actors) do
    exerciseCmd factory CredentialRegistryFactory_Anchor with credential; registration
  pure (fromInterfaceContractId @DemoCredential @RegisteredCredential result.issuedCredential)

archiveCredentialAsAnchorers : Party -> ContractId DemoCredential -> Script ()
archiveCredentialAsAnchorers actor cid = do
  _ <- submit actor do
    exerciseCmd (toInterfaceContractId @Credential cid) Credential_ArchiveAsAnchorers
  pure ()

createNameRequest : Party -> Party -> Text -> CredentialView -> RegisteredCredentialView -> Script (ContractId DemoNameRequest)
createNameRequest applicant admin name credential registration = submit applicant do
  createCmd DemoNameRequest with registryAdmin = admin; applicant; name; credential; registration

acceptNameRequestAsRequesterIssued : [Party] -> ContractId DemoNameRequest -> ContractId CredentialRegistryFactory -> Script (ContractId RegisteredCredential)
acceptNameRequestAsRequesterIssued actors request factory = submit (actAs actors) do
  exerciseCmd request DemoNameRequest_AcceptAsRequesterIssued with factory

acceptNameRequestAsRegistryIssued : [Party] -> ContractId DemoNameRequest -> ContractId CredentialRegistryFactory -> Script (ContractId RegisteredCredential)
acceptNameRequestAsRegistryIssued actors request factory = submit (actAs actors) do
  exerciseCmd request DemoNameRequest_AcceptAsRegistryIssued with factory

acceptNameRequestAsRequesterIssuedRejects : Text -> [Party] -> ContractId DemoNameRequest -> ContractId CredentialRegistryFactory -> Script ()
acceptNameRequestAsRequesterIssuedRejects reason actors request factory = do
  debug reason
  submitMustFail (actAs actors) do
    exerciseCmd request DemoNameRequest_AcceptAsRequesterIssued with factory

acceptNameRequestAsRegistryIssuedRejects : Text -> [Party] -> ContractId DemoNameRequest -> ContractId CredentialRegistryFactory -> Script ()
acceptNameRequestAsRegistryIssuedRejects reason actors request factory = do
  debug reason
  submitMustFail (actAs actors) do
    exerciseCmd request DemoNameRequest_AcceptAsRegistryIssued with factory

rejectNameRequestRejects : Text -> Party -> ContractId DemoNameRequest -> Script ()
rejectNameRequestRejects reason actor request = do
  debug reason
  submitMustFail actor do
    exerciseCmd request DemoNameRequest_Reject

createNameRequestRejects : Text -> Party -> Party -> Text -> CredentialView -> RegisteredCredentialView -> Script ()
createNameRequestRejects reason actor admin name credential registration = do
  debug reason
  submitMustFail actor do
    createCmd DemoNameRequest with applicant = actor; registryAdmin = admin; name; credential; registration

rejectNameRequest : Party -> ContractId DemoNameRequest -> Script ()
rejectNameRequest admin request = submit admin do
  exerciseCmd request DemoNameRequest_Reject

assertNameCredentialCount : Party -> Text -> Int -> Text -> Script ()
assertNameCredentialCount admin name expected message = do
  matches <- queryFilter admin (\(c : DemoCredential) -> credentialHasName name c.credential)
  assertMsg (message <> ", found " <> show (length matches)) (length matches == expected)

issueRejects : Text -> [Party] -> ContractId CredentialRegistryFactory -> CredentialView -> RegisteredCredentialView -> Script ()
issueRejects reason actors factory credential registration = do
  debug reason
  submitMustFail (actAs actors) do
    exerciseCmd factory CredentialRegistryFactory_Issue with credential; registration

anchorRejects : Text -> [Party] -> ContractId CredentialRegistryFactory -> CredentialView -> RegisteredCredentialView -> Script ()
anchorRejects reason actors factory credential registration = do
  debug reason
  submitMustFail (actAs actors) do
    exerciseCmd factory CredentialRegistryFactory_Anchor with credential; registration

directCreateRejects : Text -> [Party] -> Party -> CredentialView -> Time -> Optional Time -> Script ()
directCreateRejects reason actors admin credential registeredAt expiresAt = do
  debug reason
  submitMustFail (actAs actors) do
    createCmd DemoCredential with registryAdminParty = admin; credential; registeredAt; expiresAt; registryMeta = TextMap.empty

extendRegistrationRejects : Text -> [Party] -> ContractId DemoCredential -> CredentialView -> Party -> Time -> Script ()
extendRegistrationRejects reason actors cid expectedCredential registryAdmin expiresAt = do
  debug reason
  submitMustFail (actAs actors) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle cid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential; registryAdmin; expiresAt

renewRejects : Text -> [Party] -> ContractId DemoCredential -> CredentialView -> Party -> Time -> Script ()
renewRejects reason actors cid expectedCredential registryAdmin validUntil = do
  debug reason
  submitMustFail (actAs actors) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle cid) RegisteredCredentialLifecycle_Renew with
      expectedCredential; registryAdmin; validUntil; profileAuthorization = None; paymentEvidence = None

removeSelfAsHolderRejects : Text -> Party -> ContractId DemoCredential -> Party -> Script ()
removeSelfAsHolderRejects reason actor cid holder = do
  debug reason
  submitMustFail actor do
    exerciseCmd (toInterfaceContractId @Credential cid) Credential_RemoveSelfAsHolder with holder

intrinsicRenewRejects : Text -> Party -> ContractId DemoCredential -> Time -> Script ()
intrinsicRenewRejects reason actor cid validUntil = do
  debug reason
  submitMustFail actor do
    exerciseCmd (toInterfaceContractId @CredentialLifecycle cid) CredentialLifecycle_Renew with validUntil
