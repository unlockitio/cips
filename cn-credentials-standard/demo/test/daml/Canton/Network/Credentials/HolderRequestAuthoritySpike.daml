module Canton.Network.Credentials.HolderRequestAuthoritySpike where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

main : Script ()
main = script do
  holder <- allocateParty "SpikeHolder"
  issuer <- allocateParty "SpikeIssuer"
  other <- allocateParty "SpikeOtherAnchorer"
  admin <- allocateParty "SpikeRegistryAdmin"
  now <- getTime
  factoryCid <- submit admin do
    createCmd DemoCredentialRegistryFactory with
      registryAdminParty = admin; anchorers = NonEmpty holder []
  let factory = toInterfaceContractId @CredentialRegistryFactory factoryCid
  issuerFactory <- queryContractId issuer factoryCid
  assertMsg "issuer has no factory ACS visibility" (issuerFactory == None)
  let anchorers = NonEmpty issuer []
  requestCid <- submit holder do
    createCmd DemoCredentialRequest with
      holder; requestedIssuer = issuer; requestedType = "Qualification"; registryAdmin = admin; anchorers
  let request = toInterfaceContractId @CredentialRequest requestCid
  issuerView <- queryInterfaceContractId issuer request
  assertMsg "issuer sees only type and routing" (issuerView == Some (CredentialRequestView holder issuer "Qualification" admin anchorers))
  let credential = CredentialView with
        id = Some "urn:test:issuer-filled-claims"
        credentialTypes = ["VerifiableCredential", "Qualification"]
        issuer = W3C_VC_Identifier_Party issuer
        validFrom = Some now
        validUntil = None
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party holder))
          (TextMap.fromList [("demo.example/level", Metadata.AV_Int 7)])) []
        credentialSchema = []
        securing = None
        holders = [holder]
        anchorers
  let registration = RegisteredCredentialView admin now None TextMap.empty
  factoryDisclosure <- queryDisclosure admin factoryCid
  disclosure <- case factoryDisclosure of
    None -> abort "factory admin cannot disclose factory"
    Some d -> pure d
  otherFactoryCid <- submit other do
    createCmd DemoCredentialRegistryFactory with
      registryAdminParty = other; anchorers = NonEmpty holder []
  otherDisclosure <- queryDisclosure other otherFactoryCid
  wrongFactoryDisclosure <- case otherDisclosure of
    None -> abort "factory admin cannot disclose second factory"
    Some d -> pure d
  submitMustFail (actAs other <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential; registration; factory
  submitMustFail issuer do
    exerciseCmd request CredentialRequest_Approve with credential; registration; factory
  submitMustFail (actAs issuer <> disclose wrongFactoryDisclosure) do
    exerciseCmd request CredentialRequest_Approve with
      credential; registration; factory = toInterfaceContractId @CredentialRegistryFactory otherFactoryCid
  submitMustFail (actAs issuer <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential = (credential with holders = [other]); registration; factory
  submitMustFail (actAs issuer <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential = (credential with credentialTypes = ["VerifiableCredential"]); registration; factory
  submitMustFail (actAs issuer <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential = (credential with issuer = W3C_VC_Identifier_Party other); registration; factory
  submitMustFail (actAs issuer <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential; registration = (registration with registryAdmin = other); factory
  submitMustFail (actAs issuer <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential = (credential with anchorers = NonEmpty issuer [other]); registration; factory
  extraRequestCid <- submit holder do
    createCmd DemoCredentialRequest with
      holder; requestedIssuer = issuer; requestedType = "Qualification"; registryAdmin = admin
      anchorers = NonEmpty issuer [other]
  let extraRequest = toInterfaceContractId @CredentialRequest extraRequestCid
  submitMustFail (actAs issuer <> disclose disclosure) do
    exerciseCmd extraRequest CredentialRequest_Approve with
      credential = (credential with anchorers = NonEmpty issuer [other]); registration; factory
  issued <- submit (actAs issuer <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential; registration; factory
  actual <- queryContractId holder (fromInterfaceContractId @DemoCredential @RegisteredCredential issued)
  assertMsg "issuer-filled claims survive direct issuance under inherited holder authority"
    (fmap (.credential) actual == Some credential)
  consumed <- queryInterfaceContractId holder request
  assertMsg "approval consumes the holder request" (consumed == None)
  submitMustFail (actAs issuer <> disclose disclosure) do
    exerciseCmd request CredentialRequest_Approve with credential; registration; factory
