module Canton.Network.Credentials.Tests where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.Time (addRelTime, days)
import DA.TextMap qualified as TextMap
import Daml.Script

template AdminObserverSuccessorProbe
  with
    admin : Party
    anchor : Party
    holder : Party
    expiresAt : Time
  where
    signatory anchor, holder
    observer admin

    choice AdminObserverSuccessorProbe_Extend : ContractId AdminObserverSuccessorProbe
      with later : Time
      controller admin
      do create this with expiresAt = later

main : Script ()
main = script do
  anchor <- allocateParty "Anchor"
  holder <- allocateParty "Holder"
  admin <- allocateParty "Admin"
  other <- allocateParty "Other"
  now <- getTime
  let expiry = addRelTime now (days 30)
  let credential = CredentialView with
        id = Some "urn:test:external-issuer"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier "https://external.example/issuer"
        validFrom = Some now
        validUntil = Some expiry
        credentialSubject = NonEmpty (CredentialSubject None TextMap.empty) []
        holders = [holder]
        anchorers = NonEmpty anchor []
  let registrationExpiry = addRelTime now (days 12)
  let registration = RegisteredCredentialView admin now (Some registrationExpiry) TextMap.empty
  probe <- submit (actAs [anchor, holder]) do
    createCmd AdminObserverSuccessorProbe with admin; anchor; holder; expiresAt = registrationExpiry
  _ <- submit admin do
    exerciseCmd probe AdminObserverSuccessorProbe_Extend with later = expiry
  assertMsg "intrinsic and registration dates differ" (credential.validUntil /= registration.expiresAt)
  assertMsg "stable deduplicated signatories, independent roles"
    (credentialSignatories (credential with anchorers = NonEmpty anchor [holder, anchor]; holders = [holder, other]) == [anchor, holder, other])
  factoryCid <- submit admin do
    createCmd DemoCredentialRegistryFactory with registryAdminParty = admin; anchorers = credential.anchorers
  let factory = toInterfaceContractId @CredentialRegistryFactory factoryCid
  submitMustFail anchor do
    exerciseCmd factory CredentialRegistryFactory_Issue with credential; registration
  submitMustFail (actAs [other, holder]) do
    exerciseCmd factory CredentialRegistryFactory_Issue with credential = (credential with anchorers = NonEmpty other []); registration
  issued <- submit (actAs [anchor, holder]) do
    exerciseCmd factory CredentialRegistryFactory_Issue with credential; registration
  let original = fromInterfaceContractId @DemoCredential @RegisteredCredential issued.issuedCredential
  submitMustFail admin do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle original) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = credential
      registryAdmin = admin
      expiresAt = addRelTime registrationExpiry (days 1)
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle original) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = credential
      registryAdmin = admin
      expiresAt = addRelTime registrationExpiry (days 1)
  submitMustFail other do
    exerciseCmd (toInterfaceContractId @Credential original) Credential_RemoveSelfAsHolder with holder = other
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @Credential original) Credential_RemoveSelfAsHolder with holder
  removed <- submit holder do
    exerciseCmd (toInterfaceContractId @Credential original) Credential_RemoveSelfAsHolder with holder
  let emptyCid = fromInterfaceContractId @DemoCredential @Credential removed.replacementCredential
  empty <- queryContractId anchor emptyCid
  case empty of
    None -> abort "anchorer must retain visibility"
    Some actual -> do
      assertMsg "final holder removal preserves everything else" (actual.credential == credential with holders = [])
      assertMsg "registration unchanged" (registeredView actual == registration)
      assertMsg "only anchorer remains signatory" (credentialSignatories actual.credential == [anchor])
  let later = addRelTime expiry (days 30)
  submitMustFail other do
    exerciseCmd (toInterfaceContractId @CredentialLifecycle emptyCid) CredentialLifecycle_Renew with validUntil = later
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @CredentialLifecycle emptyCid) CredentialLifecycle_Renew with validUntil = later
  let expected = credential with holders = []
  submitMustFail (actAs [other, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle emptyCid) RegisteredCredentialLifecycle_Renew with
      expectedCredential = expected with anchorers = NonEmpty other []
      registryAdmin = admin
      validUntil = later
      profileAuthorization = None
      paymentEvidence = None
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle emptyCid) RegisteredCredentialLifecycle_Renew with
      expectedCredential = expected
      registryAdmin = admin
      validUntil = later
      profileAuthorization = None
      paymentEvidence = None
  submitMustFail (actAs [anchor, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle emptyCid) RegisteredCredentialLifecycle_Renew with
      expectedCredential = expected
      registryAdmin = admin
      validUntil = expiry
      profileAuthorization = None
      paymentEvidence = None
  registered <- submit (actAs [anchor, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle emptyCid) RegisteredCredentialLifecycle_Renew with
      expectedCredential = expected
      registryAdmin = admin
      validUntil = later
      profileAuthorization = None
      paymentEvidence = None
  let renewedCid = fromInterfaceContractId @DemoCredential @RegisteredCredentialLifecycle registered.replacementCredential
  intrinsic <- queryContractId anchor renewedCid
  assertMsg "registered intrinsic renewal changes only validUntil" (fmap (.credential) intrinsic == Some (expected with validUntil = Some later))
  assertMsg "intrinsic renewal retains registration without extension" (fmap registeredView intrinsic == Some registration)
  let extendedExpiry = addRelTime registrationExpiry (days 25)
  submitMustFail (actAs [anchor, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle renewedCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = expected
      registryAdmin = admin
      expiresAt = extendedExpiry
  submitMustFail admin do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle renewedCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = expected with validUntil = Some later
      registryAdmin = admin
      expiresAt = extendedExpiry
  let current = expected with validUntil = Some later
  extended <- submit (actAs [anchor, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle renewedCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = current
      registryAdmin = admin
      expiresAt = extendedExpiry
  let registeredCid = fromInterfaceContractId @DemoCredential @RegisteredCredentialLifecycle extended.replacementCredential
  actual <- queryContractId anchor registeredCid
  assertMsg "registration extension preserves entire credential" (fmap (.credential) actual == Some current)
  assertMsg "registration extension changes only expiresAt" (fmap registeredView actual == Some (registration with expiresAt = Some extendedExpiry))
  submitMustFail admin do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle registeredCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = current
      registryAdmin = admin
      expiresAt = addRelTime extendedExpiry (days 1)
  submitMustFail (actAs [anchor, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle registeredCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = current
      registryAdmin = admin
      expiresAt = extendedExpiry
  noIntrinsic <- submit (actAs [anchor, holder]) do
    exerciseCmd factory CredentialRegistryFactory_Issue with
      credential = credential with validUntil = None
      registration
  let noIntrinsicCid = fromInterfaceContractId @DemoCredential @RegisteredCredential noIntrinsic.issuedCredential
  noIntrinsicView <- queryContractId anchor noIntrinsicCid
  assertMsg "registration expiry can exist without intrinsic expiry" (fmap (.credential.validUntil) noIntrinsicView == Some None)
  submitMustFail (actAs [anchor, holder, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle noIntrinsicCid) RegisteredCredentialLifecycle_Renew with
      expectedCredential = credential with validUntil = None
      registryAdmin = admin
      validUntil = later
      profileAuthorization = None
      paymentEvidence = None
  _ <- submit (actAs [anchor, holder, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle noIntrinsicCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = credential with validUntil = None
      registryAdmin = admin
      expiresAt = extendedExpiry
  noRegistrationExpiry <- submit (actAs [anchor, holder]) do
    exerciseCmd factory CredentialRegistryFactory_Issue with
      credential
      registration = registration with expiresAt = None
  let noRegistrationExpiryCid = fromInterfaceContractId @DemoCredential @RegisteredCredential noRegistrationExpiry.issuedCredential
  noRegistrationExpiryView <- queryContractId anchor noRegistrationExpiryCid
  assertMsg "intrinsic expiry can exist without registration expiry" (fmap (.expiresAt) noRegistrationExpiryView == Some None)
  submitMustFail (actAs [anchor, holder, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle noRegistrationExpiryCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = credential
      registryAdmin = admin
      expiresAt = extendedExpiry
  noRegistrationRenewal <- submit (actAs [anchor, holder, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle noRegistrationExpiryCid) RegisteredCredentialLifecycle_Renew with
      expectedCredential = credential
      registryAdmin = admin
      validUntil = later
      profileAuthorization = None
      paymentEvidence = None
  let noRegistrationRenewalCid = fromInterfaceContractId @DemoCredential @RegisteredCredentialLifecycle noRegistrationRenewal.replacementCredential
  noRegistrationRenewalView <- queryContractId anchor noRegistrationRenewalCid
  assertMsg "renewal does not require or create registration expiry" (fmap registeredView noRegistrationRenewalView == Some (registration with expiresAt = None))
  assertMsg "renewal preserves claims and updates only intrinsic validity" (fmap (.credential) noRegistrationRenewalView == Some (credential with validUntil = Some later))
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle noRegistrationRenewalCid) RegisteredCredentialLifecycle_Renew with
      expectedCredential = credential with validUntil = Some later
      registryAdmin = admin
      validUntil = addRelTime later (days 1)
      profileAuthorization = None
      paymentEvidence = None
  _ <- submit anchor do
    exerciseCmd (toInterfaceContractId @Credential registeredCid) Credential_ArchiveAsAnchorers
  archived <- queryContractId anchor registeredCid
  assertMsg "holderless credential remains archivable" (archived == None)
  holderless <- submit anchor do
    exerciseCmd factory CredentialRegistryFactory_Issue with
      credential = credential with holders = []
      registration
  _ <- submit anchor do
    exerciseCmd (toInterfaceContractId @Credential
      (fromInterfaceContractId @DemoCredential @RegisteredCredential holderless.issuedCredential))
      Credential_ArchiveAsAllHolders
  missing <- queryContractId anchor
    (fromInterfaceContractId @DemoCredential @RegisteredCredential holderless.issuedCredential)
  assertMsg "all-holder archive falls back to anchorers" (missing == None)
