module Canton.Network.Credentials.Tests where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.Time (addRelTime, days)
import DA.TextMap qualified as TextMap
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

main : Script ()
main = script do
  issuer <- allocateParty "TestIssuer"
  holderA <- allocateParty "TestHolderA"
  holderB <- allocateParty "TestHolderB"
  registryAdmin <- allocateParty "TestRegistryAdmin"
  other <- allocateParty "TestOther"

  testTwoHolderSelfRemoval issuer holderA holderB registryAdmin
  testAuthorityTransfer issuer holderA holderB registryAdmin
  testSingleHolderSelfRemovalRejects issuer holderA registryAdmin
  testAllHolderArchiveIsDistinct issuer holderA holderB registryAdmin
  testFactoryIssue issuer holderA registryAdmin other
  testCredentialRenew issuer holderA registryAdmin other
  testRegisteredRenew issuer holderA registryAdmin other

testTwoHolderSelfRemoval : Party -> Party -> Party -> Party -> Script ()
testTwoHolderSelfRemoval issuer holderA holderB registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holderA [holderB]
  let credential = credentialView issuer holders now "urn:test:credential:self-removal"
  let registration = registeredCredentialView registryAdmin now credential.validUntil

  cid <- createDemo issuer holderA holders registryAdmin credential registration
  result <- submit holderB do
    exerciseCmd (toInterfaceContractId @Credential cid)
      Credential_RemoveSelfAsHolder with holder = holderB

  let replacementCid = fromInterfaceContractId @DemoCredential @Credential result.replacementCredential
  old <- queryContractId holderA cid
  assertMsg "self-removal consumes the original contract" (old == None)
  replacement <- queryContractId holderA replacementCid
  case replacement of
    None -> abort "replacement credential should be active"
    Some actual -> do
      let expectedHolders = NonEmpty holderA []
      assertMsg "replacement removes only the exercising holder" (actual.holderParties == expectedHolders)
      assertMsg "credential state is preserved" (actual.credential == credential with holders = expectedHolders)
      assertMsg "registration state is preserved" (testRegisteredView actual == registration)

testAuthorityTransfer : Party -> Party -> Party -> Party -> Script ()
testAuthorityTransfer issuer holderA holderB registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holderA [holderB]
  let credential = credentialView issuer holders now "urn:test:credential:authority-transfer"
  let registration = registeredCredentialView registryAdmin now credential.validUntil
  cid <- createDemo issuer holderA holders registryAdmin credential registration

  result <- submit holderA do
    exerciseCmd (toInterfaceContractId @Credential cid)
      Credential_RemoveSelfAsHolder with holder = holderA
  let replacementCid = fromInterfaceContractId @DemoCredential @Credential result.replacementCredential
  replacement <- queryContractId holderB replacementCid
  case replacement of
    None -> abort "replacement credential should be visible to the remaining holder"
    Some actual -> do
      let expectedHolders = NonEmpty holderB []
      assertMsg "authority transfers to the remaining holder" (actual.authorityParty == holderB)
      assertMsg "credential state survives authority transfer" (actual.credential == credential with holders = expectedHolders)
      assertMsg "registration state survives authority transfer" (testRegisteredView actual == registration)

testSingleHolderSelfRemovalRejects : Party -> Party -> Party -> Script ()
testSingleHolderSelfRemovalRejects issuer holder registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holder []
  let credential = credentialView issuer holders now "urn:test:credential:single-holder"
  let registration = registeredCredentialView registryAdmin now credential.validUntil
  cid <- createDemo issuer holder holders registryAdmin credential registration
  submitMustFail holder do
    exerciseCmd (toInterfaceContractId @Credential cid)
      Credential_RemoveSelfAsHolder with holder

testAllHolderArchiveIsDistinct : Party -> Party -> Party -> Party -> Script ()
testAllHolderArchiveIsDistinct issuer holderA holderB registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holderA [holderB]
  let credential = credentialView issuer holders now "urn:test:credential:archive"
  let registration = registeredCredentialView registryAdmin now credential.validUntil
  cid <- createDemo issuer holderA holders registryAdmin credential registration
  result <- submit (actAs [holderA, holderB]) do
    exerciseCmd (toInterfaceContractId @Credential cid) Credential_ArchiveAsAllHolders
  assertMsg "all-holder archive returns the archived credential" (result.archivedCredential == credential)
  assertMsg "all-holder archive returns no replacement" (result.meta == Metadata.emptyMetadata)
  old <- queryContractId holderA cid
  assertMsg "all-holder archive consumes the credential" (old == None)

testFactoryIssue : Party -> Party -> Party -> Party -> Script ()
testFactoryIssue issuer holder registryAdmin other = script do
  now <- getTime
  let holders = NonEmpty holder []
  let credential = credentialView issuer holders now "urn:test:credential:issue"
  let registration = registeredCredentialView registryAdmin now credential.validUntil
  factoryCid <- submit registryAdmin do
    createCmd DemoCredentialRegistryFactory with registryAdminParty = registryAdmin; issuerParty = issuer
  let factory = toInterfaceContractId @CredentialRegistryFactory factoryCid
  submitMustFail other do
    exerciseCmd factory CredentialRegistryFactory_Issue with issuer = other; credential; registration
  issued <- submit issuer do
    exerciseCmd factory CredentialRegistryFactory_Issue with issuer; credential; registration
  actual <- fetchDemo issuer issued.issuedCredential
  assertMsg "issue preserves the supplied credential" (actual.credential == credential)
  assertMsg "issue preserves the supplied registration" (testRegisteredView actual == registration)
  assertFactoryActive registryAdmin factoryCid

testCredentialRenew : Party -> Party -> Party -> Party -> Script ()
testCredentialRenew issuer holder registryAdmin other = script do
  now <- getTime
  let holders = NonEmpty holder []
  let credential = credentialView issuer holders now "urn:test:credential:intrinsic-renew"
  let registration = registeredCredentialView registryAdmin now credential.validUntil
  cid <- createDemo issuer holder holders registryAdmin credential registration
  let lifecycle = toInterfaceContractId @CredentialLifecycle cid
  let Some initialExpiry = credential.validUntil
  let renewedExpiry = addRelTime initialExpiry (days 30)

  submitMustFail other do
    exerciseCmd lifecycle CredentialLifecycle_Renew with issuer = other; validUntil = renewedExpiry
  submitMustFail issuer do
    exerciseCmd lifecycle CredentialLifecycle_Renew with issuer; validUntil = initialExpiry
  renewed <- submit issuer do
    exerciseCmd lifecycle CredentialLifecycle_Renew with issuer; validUntil = renewedExpiry
  let renewedCid = fromInterfaceContractId @DemoCredential @CredentialLifecycle renewed.replacementCredential
  actual <- queryContractId issuer renewedCid
  case actual of
    None -> abort "renewed credential should be active"
    Some replacement -> do
      assertMsg "intrinsic renewal extends validUntil" (replacement.credential.validUntil == Some renewedExpiry)
      assertMsg "intrinsic renewal preserves registration expiry" (replacement.expiresAt == registration.expiresAt)
      assertMsg "intrinsic renewal preserves other fields" (replacement.credential == credential with validUntil = Some renewedExpiry)

testRegisteredRenew : Party -> Party -> Party -> Party -> Script ()
testRegisteredRenew issuer holder registryAdmin other = script do
  now <- getTime
  let holders = NonEmpty holder []
  let credential = credentialView issuer holders now "urn:test:credential:registered-renew"
  let registration = registeredCredentialView registryAdmin now credential.validUntil
  cid <- createDemo issuer holder holders registryAdmin credential registration
  let registeredLifecycle = toInterfaceContractId @RegisteredCredentialLifecycle cid
  let Some initialExpiry = credential.validUntil
  let renewedExpiry = addRelTime initialExpiry (days 60)
  let noProfileAuthorization = None
  let noPaymentEvidence = None

  submitMustFail (actAs [other, registryAdmin]) do
    exerciseCmd registeredLifecycle RegisteredCredentialLifecycle_Renew with expectedCredential = credential; issuer = other; registryAdmin; validUntil = renewedExpiry; profileAuthorization = noProfileAuthorization; paymentEvidence = noPaymentEvidence
  submitMustFail (actAs [issuer, other]) do
    exerciseCmd registeredLifecycle RegisteredCredentialLifecycle_Renew with expectedCredential = credential; issuer; registryAdmin = other; validUntil = renewedExpiry; profileAuthorization = noProfileAuthorization; paymentEvidence = noPaymentEvidence
  submitMustFail (actAs [issuer, registryAdmin]) do
    exerciseCmd registeredLifecycle RegisteredCredentialLifecycle_Renew with expectedCredential = (credential with id = Some "urn:test:credential:stale"); issuer; registryAdmin; validUntil = renewedExpiry; profileAuthorization = noProfileAuthorization; paymentEvidence = noPaymentEvidence
  submitMustFail (actAs [issuer, registryAdmin]) do
    exerciseCmd registeredLifecycle RegisteredCredentialLifecycle_Renew with expectedCredential = credential; issuer; registryAdmin; validUntil = initialExpiry; profileAuthorization = noProfileAuthorization; paymentEvidence = noPaymentEvidence
  renewed <- submit (actAs [issuer, registryAdmin]) do
    exerciseCmd registeredLifecycle RegisteredCredentialLifecycle_Renew with expectedCredential = credential; issuer; registryAdmin; validUntil = renewedExpiry; profileAuthorization = Some TextMap.empty; paymentEvidence = Some TextMap.empty
  renewedCid <- pure (fromInterfaceContractId @DemoCredential @RegisteredCredentialLifecycle renewed.replacementCredential)
  found <- queryContractId issuer renewedCid
  actual <- case found of
    None -> abort "replacement DemoCredential should be active"
    Some replacement -> pure replacement
  assertMsg "registered renewal extends intrinsic validity" (actual.credential.validUntil == Some renewedExpiry)
  assertMsg "registered renewal extends registration expiry equally" (actual.expiresAt == Some renewedExpiry)
  assertMsg "registered renewal preserves credential fields" (actual.credential == credential with validUntil = Some renewedExpiry)
  assertMsg "registered renewal preserves registration fields" (testRegisteredView actual == registration with expiresAt = Some renewedExpiry)

createDemo : Party -> Party -> NonEmpty Party -> Party -> CredentialView -> RegisteredCredentialView -> Script (ContractId DemoCredential)
createDemo issuer authority holders registryAdmin credential registration = submit issuer do
  createCmd DemoCredential with
    issuerParty = issuer
    authorityParty = authority
    holderParties = holders
    registryAdminParty = registryAdmin
    credential
    registeredAt = registration.registeredAt
    expiresAt = registration.expiresAt
    registryMeta = registration.meta

fetchDemo : Party -> ContractId RegisteredCredential -> Script DemoCredential
fetchDemo party registeredCid = script do
  let cid = fromInterfaceContractId @DemoCredential @RegisteredCredential registeredCid
  found <- queryContractId party cid
  case found of
    None -> abort "replacement DemoCredential should be active"
    Some credential -> pure credential

assertFactoryActive : Party -> ContractId DemoCredentialRegistryFactory -> Script ()
assertFactoryActive party cid = script do
  found <- queryContractId party cid
  assertMsg "factory choices must be nonconsuming" (found /= None)

credentialView : Party -> NonEmpty Party -> Time -> Text -> CredentialView
credentialView issuer holders now credentialId = CredentialView with
  id = Some credentialId
  credentialTypes = ["VerifiableCredential", "TestCredential"]
  issuer = W3C_VC_Identifier_Party issuer
  validFrom = Some now
  validUntil = Some (addRelTime now (days 90))
  credentialSubject = NonEmpty
    (CredentialSubject
      (Some (W3C_VC_Identifier "urn:test:subject:001"))
      (TextMap.fromList
        [ ("test.example/name", Metadata.AV_Text "Alice")
        , ("test.example/active", Metadata.AV_Bool True)
        ]))
    []
  holders

registeredCredentialView : Party -> Time -> Optional Time -> RegisteredCredentialView
registeredCredentialView registryAdmin registeredAt expiresAt = RegisteredCredentialView with
  registryAdmin
  registeredAt
  expiresAt
  meta = TextMap.empty

testRegisteredView : DemoCredential -> RegisteredCredentialView
testRegisteredView credential = RegisteredCredentialView with
  registryAdmin = credential.registryAdminParty
  registeredAt = credential.registeredAt
  expiresAt = credential.expiresAt
  meta = credential.registryMeta
