-- Generic Party-subject credential/profile demo under the draft #204-inspired
-- replacement credential proposal, adjacent to but NOT CIP #169 conformance.
-- Monolithic and decomposed profiles allow explicit subject != operational holder;
-- these scenarios do not test CIP #169 resolution.
module Canton.Network.Credentials.Cip204GenericPartyProfileTests where

import Canton.Network.Credentials.DemoProfiles
import Canton.Network.Credentials.TestSupport
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, days)
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

seedGenericProfile : CredentialView -> Party -> Party -> CredentialView
seedGenericProfile base issuer subject =
  partyProfileCredential base issuer subject
    (TextMap.fromList [("demo.example/license", Metadata.AV_Text "Sample license")])

main : Script ()
main = script do
  anchor <- allocateParty "Anchor"
  holder <- allocateParty "Holder"
  admin <- allocateParty "Admin"
  other <- allocateParty "Other"
  now <- getTime
  let credential = CredentialView with
        id = Some "urn:test:external-issuer"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier "https://external.example/issuer"
        validFrom = Some now
        validUntil = Some (addRelTime now (days 30))
        credentialSubject = NonEmpty (CredentialSubject None TextMap.empty) []
        holders = [holder]
        anchorers = NonEmpty anchor []
  let registration = RegisteredCredentialView admin now (Some (addRelTime now (days 12))) TextMap.empty
  factory <- createCredentialFactory admin credential.anchorers
  let profileSubject = W3C_VC_Identifier_Party other
  let profileClaims = TextMap.fromList
        [("profile.example/displayName", Metadata.AV_Text "ACME"), ("profile.example/licenseStatus", Metadata.AV_Text "active")]
  let monoProfile = partyProfileCredential credential anchor other profileClaims
  let licenseProfile = partyProfileCredential credential anchor other
        (TextMap.fromList [("profile.example/licenseStatus", Metadata.AV_Text "active")])
  let nameProfile = partyProfileCredential credential admin other
        (TextMap.fromList [("profile.example/displayName", Metadata.AV_Text "ACME")])
  monoCid <- issueCredential [anchor, holder] factory monoProfile registration
  licenseCid <- issueCredential [anchor, holder] factory licenseProfile registration
  nameCid <- issueCredential [anchor, holder, admin] factory nameProfile registration
  monoRecord <- queryContractId holder monoCid
  licenseRecord <- queryContractId holder licenseCid
  nameRecord <- queryContractId holder nameCid
  assertMsg "monolithic profile has two readable claims about its explicit Party subject"
    (fmap (.credential) monoRecord == Some monoProfile
      && monoProfile.credentialSubject == NonEmpty (CredentialSubject (Some profileSubject) profileClaims) [])
  assertMsg "decomposed profile has independently addressable credentials about the same Party"
    (licenseCid /= nameCid && fmap (.credential) licenseRecord == Some licenseProfile
      && fmap (.credential) nameRecord == Some nameProfile
      && licenseProfile.credentialSubject == NonEmpty (CredentialSubject (Some profileSubject)
        (TextMap.fromList [("profile.example/licenseStatus", Metadata.AV_Text "active")])) []
      && nameProfile.credentialSubject == NonEmpty (CredentialSubject (Some profileSubject)
        (TextMap.fromList [("profile.example/displayName", Metadata.AV_Text "ACME")])) [])
  assertMsg "profile subject differs from holder and can differ from issuer"
    (other /= holder && other /= anchor && other /= admin
      && monoProfile.holders == [holder] && nameProfile.holders == [holder])
  archiveCredentialAsAnchorers anchor monoCid
  archiveCredentialAsAnchorers anchor licenseCid
  archivedMono <- queryContractId holder monoCid
  archivedLicense <- queryContractId holder licenseCid
  survivingName <- queryContractId holder nameCid
  assertMsg "archiving one monolithic claim archives the entire profile credential"
    (archivedMono == None)
  assertMsg "archiving the decomposed license leaves the independent name claim live"
    (archivedLicense == None && fmap (.credential) survivingName == Some nameProfile)
