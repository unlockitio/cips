-- Draft CIP #249 imported-name shape scenarios, PR #249 at
-- 293acf0b53468ae484e267b5928b5746ac580da6. Capability demonstration,
-- not conformance. The external DNS assertion uses a textual issuer ("dns" is a
-- local identifier, not a CIP-defined issuer format); publisher maps to anchorers,
-- subject maps to credentialSubject.id, and holder maps to holders. Multiple
-- anchorers must all sign; this does not implement an attestor protocol.
module Canton.Network.Credentials.Cip249ImportedNameTests where

import Canton.Network.Credentials.TestSupport
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, days)
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

-- These predicates are consumer-side examples, not ledger invariants. The native
-- Time values are supplied with the encoded claims; a production consumer must
-- parse and validate the ISO-8601 claim text itself before comparing times.
claimText : Text -> CredentialView -> Optional Text
claimText key credential = case credential.credentialSubject of
  NonEmpty subject [] -> case TextMap.lookup key subject.claims of
    Some (Metadata.AV_Text value) -> Some value
    _ -> None
  _ -> None

-- DEMO-LOCAL derived consistency rules, not additional CIP #249 requirements.
dnsClaimsConsistent : Text -> Text -> CredentialView -> Bool
dnsClaimsConsistent network domain credential =
  claimText "cprp/source" credential == Some "dns"
    && claimText "cprp/verification-method" credential == Some "dnssec-txt"
    && claimText "cprp/network" credential == Some network
    && claimText "cprp/fqpn" credential == Some (network <> ":dns:" <> domain)

-- Explicitly check the text claim against the paired native time. This only
-- demonstrates a consumer supplied with already-parsed, trustworthy time values.
claimValidUntil : Time -> Text -> CredentialView -> Bool
claimValidUntil until encoded credential =
  credential.validUntil == Some until
    && claimText "cprp/valid-until" credential == Some encoded

expiredAt : Time -> Time -> Text -> CredentialView -> Bool
expiredAt now until encoded credential =
  claimValidUntil until encoded credential && now > until

-- Checks the encoded interval, NOT whether DNS was re-verified after issuance.
withinSevenDays : Time -> Time -> Text -> Text -> CredentialView -> Bool
withinSevenDays verified until verifiedText untilText credential =
  claimText "cprp/verified-at" credential == Some verifiedText
    && claimValidUntil until untilText credential
    && until >= verified && until <= addRelTime verified (days 7)

importedName : Party -> NonEmpty Party -> Text -> Text -> Time -> Time -> Text -> Text -> CredentialView
importedName subject registrars network domain verified until verifiedText untilText = CredentialView with
  id = Some ("urn:test:cip249:" <> domain)
  credentialTypes = ["VerifiableCredential"]
  issuer = W3C_VC_Identifier "dns"
  validFrom = Some verified
  validUntil = Some until
  credentialSubject = NonEmpty (CredentialSubject
    (Some (W3C_VC_Identifier_Party subject))
    (TextMap.fromList
      [ ("cprp/fqpn", Metadata.AV_Text (network <> ":dns:" <> domain))
      , ("cprp/network", Metadata.AV_Text network)
      , ("cprp/source", Metadata.AV_Text "dns")
      , ("cprp/verification-method", Metadata.AV_Text "dnssec-txt")
      , ("cprp/verified-at", Metadata.AV_Text verifiedText)
      , ("cprp/valid-until", Metadata.AV_Text untilText)
      ])) []
  credentialSchema = []
  -- TODO(subtask C): replace structural DNS securing placeholder with real evidence.
  securing = placeholderEnvelope (network <> ":dns:" <> domain)
  holders = [subject]
  anchorers = registrars

seedImportedName : Party -> Party -> Time -> CredentialView
seedImportedName subject registrar verified =
  (importedName subject (NonEmpty registrar []) "testnet" "unverified.example"
    verified (addRelTime verified (days 7)) (show verified) (show (addRelTime verified (days 7)))) with
      id = Some "urn:demo:scenario:dns-unverified"
      credentialTypes = ["VerifiableCredential", "ImportedPartyName"]

assertImported : Text -> Party -> NonEmpty Party -> Text -> Text -> Time -> Time -> Text -> Text -> CredentialView -> Script ()
assertImported label subject registrars network domain verified until verifiedText untilText credential = do
  assertMsg (label <> ": external issuer") (credential.issuer == W3C_VC_Identifier "dns")
  assertMsg (label <> ": registrars sign as anchorers") (credential.anchorers == registrars)
  assertMsg (label <> ": subject and holder are the same verified Party")
    (credential.holders == [subject] && case credential.credentialSubject of
      NonEmpty s [] -> s.id == Some (W3C_VC_Identifier_Party subject)
      _ -> False)
  assertMsg (label <> ": exactly six text claims") (case credential.credentialSubject of
    NonEmpty s [] -> TextMap.size s.claims == 6
    _ -> False)
  assertMsg (label <> ": full FQPN and DNS method") (dnsClaimsConsistent network domain credential)
  assertMsg (label <> ": verification and validity claims")
    (claimText "cprp/verified-at" credential == Some verifiedText
      && claimValidUntil until untilText credential && credential.validFrom == Some verified)
  assertMsg (label <> ": encoded interval is at most seven days")
    (withinSevenDays verified until verifiedText untilText credential)

main : Script ()
main = script do
  registrar <- allocateParty "ImporterRegistrar"
  second <- allocateParty "OtherImporterRegistrar"
  subject <- allocateParty "VerifiedCantonParty"
  admin <- allocateParty "RegistryAdmin"
  now <- getTime
  let until = addRelTime now (days 7)
  let verifiedText = show now
  let untilText = show until
  let registrars = NonEmpty registrar [second]
  let apex = importedName subject registrars "mainnet" "blackrock.com" now until verifiedText untilText
  let subdomain = importedName subject registrars "mainnet" "tmmf.lloyds.com" now until verifiedText untilText
  let registration = RegisteredCredentialView admin now (Some until) TextMap.empty
  factory <- createCredentialFactory admin registrars

  anchorRejects "#249: one of two importer anchorers cannot publish alone" [registrar, subject] factory apex registration
  apexCid <- anchorCredential [registrar, second, subject] factory apex registration
  apexRecord <- queryContractId subject apexCid
  case apexRecord of
    None -> abort "apex import missing after anchoring"
    Some record -> assertImported "apex" subject registrars "mainnet" "blackrock.com" now until verifiedText untilText record.credential

  subCid <- anchorCredential [registrar, second, subject] factory subdomain registration
  subRecord <- queryContractId subject subCid
  case subRecord of
    None -> abort "subdomain import missing after anchoring"
    Some record -> assertImported "subdomain" subject registrars "mainnet" "tmmf.lloyds.com" now until verifiedText untilText record.credential

  issueRejects "#249: textual DNS issuer cannot use Party Issue path" [registrar, second, subject] factory apex registration

  -- DEMO-LOCAL rules: the draft lists keys and example values but does not
  -- mandate this cross-key rejection behavior; the ledger accepts the claims.
  let apexClaims = case apex.credentialSubject of
        NonEmpty s [] -> s.claims
        _ -> TextMap.empty
  let methodClaims = TextMap.insert "cprp/verification-method" (Metadata.AV_Text "gleif-api") apexClaims
  let mismatchedMethod = apex with credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party subject)) methodClaims) []
  assertMsg "demo-local: reject dns claim paired with gleif-api" (not (dnsClaimsConsistent "mainnet" "blackrock.com" mismatchedMethod))
  let networkClaims = TextMap.insert "cprp/network" (Metadata.AV_Text "testnet") apexClaims
  let mismatchedNetwork = apex with credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party subject)) networkClaims) []
  assertMsg "demo-local: reject network that differs from FQPN" (not (dnsClaimsConsistent "mainnet" "blackrock.com" mismatchedNetwork))
  let late = addRelTime now (days 8)
  let lateCredential = importedName subject registrars "mainnet" "blackrock.com" now late verifiedText (show late)
  assertMsg "encoding only: eight-day interval fails seven-day check"
    (not (withinSevenDays now late verifiedText (show late) lateCredential))
  let oldVerified = addRelTime now (days (-8))
  let oldUntil = addRelTime now (days (-1))
  let old = importedName subject registrars "mainnet" "blackrock.com" oldVerified oldUntil (show oldVerified) (show oldUntil)
  assertMsg "consumer treats past claim validity as expired" (expiredAt now oldUntil (show oldUntil) old)
  assertMsg "consumer treats future claim validity as fresh" (not (expiredAt now until untilText apex))
  assertMsg "past interval still encodes a seven-day cadence" (withinSevenDays oldVerified oldUntil (show oldVerified) (show oldUntil) old)

-- This test demonstrates what the ledger DOES NOT prove. No DNSSEC validation,
-- TXT lookup, domain control check, re-verification or importer governance runs.
-- Even a manifestly unverified domain is accepted if actors sign the template.
ledgerDoesNotVerifyDns : Script ()
ledgerDoesNotVerifyDns = script do
  registrar <- allocateParty "UnverifiedImporter"
  subject <- allocateParty "UnverifiedSubject"
  admin <- allocateParty "UnverifiedRegistryAdmin"
  now <- getTime
  let until = addRelTime now (days 7)
  let credential = importedName subject (NonEmpty registrar []) "testnet" "unverified.example" now until (show now) (show until)
  let registration = RegisteredCredentialView admin now (Some until) TextMap.empty
  factory <- createCredentialFactory admin credential.anchorers
  cid <- anchorCredential [registrar, subject] factory credential registration
  recorded <- queryContractId subject cid
  assertMsg "ledger accepts unverified DNS claim without any DNS evidence"
    (fmap (.credential) recorded == Some credential)
