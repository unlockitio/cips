-- Draft #204-inspired base credential issuance, anchoring, holder uniqueness and
-- lifecycle in this replacement proposal; not conformance to draft #204 or proof
-- of interoperability with other registries.
module Canton.Network.Credentials.Cip204CredentialsStandardTests where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.TestSupport
import Canton.Network.Credentials.V1
import DA.List (unique)
import DA.NonEmpty (NonEmpty(..))
import DA.NonEmpty qualified as NonEmpty
import DA.Time (addRelTime, days)
import DA.TextMap qualified as TextMap
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

template DemoUnregisteredCredential
  with
    credential : CredentialView
  where
    signatory credentialSignatories credential
    ensure unique credential.holders && unique (NonEmpty.toList credential.anchorers)
      && partyIssuerIsAnchorer credential && credentialStructurallyValid credential

    interface instance Credential for DemoUnregisteredCredential where
      view = credential

      credential_publicFetchImpl _ _ = pure credential

      credential_removeSelfAsHolderImpl _ _ = abort "test-only unregistered credential"

      credential_archiveAsAllHoldersImpl _ _ = pure Credential_ArchiveResult with
        archivedCredential = credential
        meta = Metadata.emptyMetadata

    interface instance CredentialLifecycle for DemoUnregisteredCredential where
      view = credential

      credentialLifecycle_renewImpl _ arg = do
        replacement <- create this with
          credential = credential with validUntil = Some arg.validUntil; securing = arg.newSecuring
        pure CredentialLifecycle_RenewResult with
          replacementCredential = toInterfaceContractId @CredentialLifecycle replacement

directUnregisteredCreateRejects : Text -> [Party] -> CredentialView -> Script ()
directUnregisteredCreateRejects reason actors credential = do
  debug reason
  submitMustFail (actAs actors) do
    createCmd DemoUnregisteredCredential with credential

-- Explicit disclosure lets a non-stakeholder exercise the public fetch choices.
disclosureOf : Template t => Party -> ContractId t -> Script Disclosure
disclosureOf stakeholder cid = do
  blob <- queryDisclosure stakeholder cid
  case blob of
    None -> abort "stakeholder cannot disclose the credential"
    Some disclosure -> pure disclosure

publicFetchRejects : Text -> Party -> Disclosure -> ContractId RegisteredCredential -> Party -> Script ()
publicFetchRejects reason actor disclosure cid expectedRegistryAdmin = do
  debug reason
  submitMustFail (actAs actor <> disclose disclosure) do
    exerciseCmd cid RegisteredCredential_PublicFetch with expectedRegistryAdmin; actor

template AdminObserverSuccessorProbe
  with
    admin : Party
    anchor : Party
    holder : Party
    expiresAt : Time
  where
    signatory anchor, holder
    observer admin

    choice AdminObserverSuccessorProbe_Extend : ContractId AdminObserverSuccessorProbe
      with later : Time
      controller admin
      do create this with expiresAt = later

seedBaseCredential : Party -> Party -> Time -> CredentialView
seedBaseCredential anchor holder now = CredentialView with
  id = Some "urn:demo:scenario:base-credential"
  credentialTypes = ["VerifiableCredential"]
  issuer = W3C_VC_Identifier "https://external.example/issuer"
  validFrom = Some now
  validUntil = Some (addRelTime now (days 7))
  credentialSubject = NonEmpty (CredentialSubject None TextMap.empty) []
  credentialSchema = [CredentialSchema "https://external.example/schemas/base.json" "JsonSchema" None]
  securing = placeholderEnvelope "scenario-base-credential"
  holders = [holder]
  anchorers = NonEmpty anchor []

main : Script ()
main = script do
  anchor <- allocateParty "Anchor"
  holder <- allocateParty "Holder"
  admin <- allocateParty "Admin"
  other <- allocateParty "Other"
  now <- getTime
  let expiry = addRelTime now (days 30)
  let schema = [CredentialSchema "https://external.example/schemas/test.json" "JsonSchema" (Some "sha384-placeholder")]
  let credential = CredentialView with
        id = Some "urn:test:external-issuer"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier "https://external.example/issuer"
        validFrom = Some now
        validUntil = Some expiry
        credentialSubject = NonEmpty (CredentialSubject None TextMap.empty) []
        credentialSchema = schema
        securing = placeholderEnvelope "test-external-issuer"
        holders = [holder]
        anchorers = NonEmpty anchor []
  let registrationExpiry = addRelTime now (days 12)
  let registration = RegisteredCredentialView admin now (Some registrationExpiry) TextMap.empty
  probe <- submit (actAs [anchor, holder]) do
    createCmd AdminObserverSuccessorProbe with admin; anchor; holder; expiresAt = registrationExpiry
  _ <- submit admin do
    exerciseCmd probe AdminObserverSuccessorProbe_Extend with later = expiry
  assertMsg "intrinsic and registration dates differ" (credential.validUntil /= registration.expiresAt)
  assertMsg "unique signatories concatenate anchorers then holders"
    (credentialSignatories (credential with anchorers = NonEmpty anchor [other]; holders = [holder]) == [anchor, other, holder])
  factory <- createCredentialFactory admin credential.anchorers
  let unsecured = credential with securing = None
  anchorRejects "textual issuer without securing" [anchor, holder] factory unsecured registration
  directCreateRejects "textual issuer without securing" [anchor, holder] admin unsecured now (Some registrationExpiry)
  directUnregisteredCreateRejects "unregistered textual issuer without securing" [anchor, holder] unsecured
  let malformedEnvelope = credential with securing = Some (EnvelopedProof with mediaType = "application/json"; encoded = "not-a-vc-envelope")
  anchorRejects "unsupported envelope media type" [anchor, holder] factory malformedEnvelope registration
  directCreateRejects "unsupported envelope media type" [anchor, holder] admin malformedEnvelope now (Some registrationExpiry)
  let emptyEnvelope = credential with securing = Some (EnvelopedProof with mediaType = "application/vc+cose"; encoded = "")
  anchorRejects "empty envelope" [anchor, holder] factory emptyEnvelope registration
  let proof = DataIntegrityProofSummary None "DataIntegrityProof" (Some "eddsa-rdfc-2022") (Some "2026-10-22T00:00:00Z") None
        (Some "did:example:issuer#key-1") "assertionMethod" []
  let embeddedSecuring = EmbeddedProof with
        securedDocument = "{\"proof\":{\"type\":\"DataIntegrityProof\",\"proofValue\":\"placeholder\"}}"
        proofs = NonEmpty proof []
  let embedded = credential with securing = Some embeddedSecuring
  embeddedCid <- anchorCredential [anchor, holder] factory embedded registration
  embeddedView <- queryContractId anchor embeddedCid
  assertMsg "embedded secured document and proof index survive in view" (fmap (.credential) embeddedView == Some embedded)
  let missingCryptosuite = embedded with securing = Some (EmbeddedProof with securedDocument = "{\"proof\":{}}"; proofs = NonEmpty (proof with cryptosuite = None) [])
  anchorRejects "DataIntegrityProof requires cryptosuite" [anchor, holder] factory missingCryptosuite registration
  directCreateRejects "DataIntegrityProof requires cryptosuite" [anchor, holder] admin missingCryptosuite now (Some registrationExpiry)
  let emptyDocument = embedded with securing = Some (EmbeddedProof with securedDocument = ""; proofs = NonEmpty proof [])
  anchorRejects "empty embedded secured document" [anchor, holder] factory emptyDocument registration
  let missingPurpose = embedded with securing = Some (EmbeddedProof with securedDocument = "{}"; proofs = NonEmpty (proof with proofPurpose = "") [])
  anchorRejects "embedded proof needs a purpose" [anchor, holder] factory missingPurpose registration
  let missingType = embedded with securing = Some (EmbeddedProof with securedDocument = "{}"; proofs = NonEmpty (proof with proofType = "") [])
  anchorRejects "embedded proof needs a type" [anchor, holder] factory missingType registration
  let malformedSchema = credential with credentialSchema = [CredentialSchema "" "JsonSchema" None]
  anchorRejects "credentialSchema requires id" [anchor, holder] factory malformedSchema registration
  directCreateRejects "credentialSchema requires id" [anchor, holder] admin malformedSchema now (Some registrationExpiry)
  let missingSchemaType = credential with credentialSchema = [CredentialSchema "https://example.org/schema" "" None]
  anchorRejects "credentialSchema requires type" [anchor, holder] factory missingSchemaType registration
  let duplicateHolders = credential with holders = [holder, holder]
  let duplicateAnchorers = credential with anchorers = NonEmpty anchor [anchor]; holders = []
  issueRejects "duplicate holders" [anchor, holder] factory duplicateHolders registration
  anchorRejects "duplicate holders" [anchor, holder] factory duplicateHolders registration
  directCreateRejects "duplicate holders" [anchor, holder] admin duplicateHolders now (Some registrationExpiry)
  issueRejects "duplicate anchorers" [anchor] factory duplicateAnchorers registration
  anchorRejects "duplicate anchorers" [anchor] factory duplicateAnchorers registration
  directCreateRejects "duplicate anchorers" [anchor] admin duplicateAnchorers now (Some registrationExpiry)
  anchorRejects "holder signature missing" [anchor] factory credential registration
  differentlyAnchored <- anchorCredential [anchor, other, holder] factory (credential with anchorers = NonEmpty other []) registration
  differentlyAnchoredRecord <- queryContractId other differentlyAnchored
  assertMsg "one factory anchors credentials with different anchorers" (fmap (.credential.anchorers) differentlyAnchoredRecord == Some (NonEmpty other []))
  issueRejects "external issuer cannot be issued by Party" [anchor, holder] factory credential registration
  let partyCredential = credential with issuer = W3C_VC_Identifier_Party other; anchorers = NonEmpty other []
  assertMsg "Party issuer is an anchorer" (partyIssuerIsAnchorer partyCredential)
  let unapprovedIssuer = partyCredential with anchorers = NonEmpty anchor []
  directCreateRejects "direct create rejects Party issuer absent from anchorers" [anchor, holder, other] admin unapprovedIssuer now (Some registrationExpiry)
  issueRejects "factory rejects Party issuer absent from anchorers" [anchor, holder, other] factory unapprovedIssuer registration
  assertMsg "Party issuer absent from anchorers is invalid" (not (partyIssuerIsAnchorer unapprovedIssuer))
  issueRejects "issuer party signature missing" [anchor, holder] factory partyCredential registration
  anchorRejects "issuer party cannot use external anchor path" [other, holder] factory partyCredential registration
  partyIssuedCid <- issueCredential [anchor, holder, other] factory partyCredential registration
  partyIssuedView <- queryContractId other partyIssuedCid
  assertMsg "Party issuer issuance preserves the credential" (fmap (.credential) partyIssuedView == Some partyCredential)
  let partyWithoutSecuring = partyCredential with securing = None
  partyWithoutSecuringCid <- issueCredential [anchor, other, holder] factory partyWithoutSecuring registration
  partyWithoutSecuringView <- queryContractId other partyWithoutSecuringCid
  assertMsg "Party issuer may omit securing" (fmap (.credential) partyWithoutSecuringView == Some partyWithoutSecuring)
  let partyMalformed = partyCredential with securing = Some (EnvelopedProof with mediaType = "application/vc+jwt"; encoded = "")
  issueRejects "Party issuer cannot carry malformed securing" [other, holder] factory partyMalformed registration
  directCreateRejects "Party issuer cannot carry malformed securing" [other, holder] admin partyMalformed now (Some registrationExpiry)
  let partyLater = addRelTime expiry (days 1)
  renewWithSecuringRejects "Party issuer cannot reuse stale securing" [other, admin] partyIssuedCid partyCredential admin partyLater partyCredential.securing
  let replacedPartySecuring = placeholderEnvelope "party-replacement"
  replacedPartyCid <- renewCredentialWithSecuring [other, admin] partyIssuedCid partyCredential admin partyLater replacedPartySecuring
  replacedPartyView <- queryContractId other replacedPartyCid
  assertMsg "Party issuer renewal replaces securing and retains schema"
    (fmap (.credential) replacedPartyView == Some (partyCredential with validUntil = Some partyLater; securing = replacedPartySecuring))
  clearedPartyCid <- renewCredentialWithSecuring [other, admin] replacedPartyCid
    (partyCredential with validUntil = Some partyLater; securing = replacedPartySecuring) admin
    (addRelTime partyLater (days 1)) None
  clearedPartyView <- queryContractId other clearedPartyCid
  assertMsg "Party issuer renewal can explicitly clear stale securing"
    (fmap (.credential) clearedPartyView == Some (partyCredential with validUntil = Some (addRelTime partyLater (days 1)); securing = None))
  original <- anchorCredential [anchor, holder] factory credential registration
  let registeredCredentialCid = toInterfaceContractId @Credential original
  originalDisclosure <- disclosureOf anchor original
  publicRegistered <- submit (actAs other <> disclose originalDisclosure) do
    exerciseCmd registeredCredentialCid Credential_PublicFetch with actor = other
  assertMsg "non-stakeholder fetch gets full registered credential view" (publicRegistered == credential)
  publicRegistration <- submit (actAs other <> disclose originalDisclosure) do
    exerciseCmd (toInterfaceContractId @RegisteredCredential original) RegisteredCredential_PublicFetch with
      expectedRegistryAdmin = admin
      actor = other
  assertMsg "registration public fetch returns both credential and registration views"
    (publicRegistration == RegisteredCredential_PublicFetchResult credential registration)
  publicFetchRejects "registration public fetch rejects an unexpected registry admin" other originalDisclosure
    (toInterfaceContractId @RegisteredCredential original) anchor
  unregistered <- submit (actAs [anchor, holder]) do
    createCmd DemoUnregisteredCredential with credential
  unregisteredDisclosure <- disclosureOf anchor unregistered
  unregisteredFetch <- submit (actAs other <> disclose unregisteredDisclosure) do
    exerciseCmd (toInterfaceContractId @Credential unregistered) Credential_PublicFetch with actor = other
  assertMsg "non-stakeholder fetch gets full unregistered credential view" (unregisteredFetch == credential)
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @CredentialLifecycle unregistered) CredentialLifecycle_Renew with
      validUntil = addRelTime expiry (days 2)
      newSecuring = None
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @CredentialLifecycle unregistered) CredentialLifecycle_Renew with
      validUntil = addRelTime expiry (days 2)
      newSecuring = credential.securing
  unregisteredRenewed <- submit anchor do
    exerciseCmd (toInterfaceContractId @CredentialLifecycle unregistered) CredentialLifecycle_Renew with
      validUntil = addRelTime expiry (days 2)
      newSecuring = placeholderEnvelope "unregistered-renewal"
  unregisteredRenewedView <- queryInterfaceContractId anchor
    (toInterfaceContractId @Credential (fromInterfaceContractId @DemoUnregisteredCredential @CredentialLifecycle unregisteredRenewed.replacementCredential))
  assertMsg "intrinsic renewal replaces securing and preserves schema"
    (unregisteredRenewedView == Some (credential with validUntil = Some (addRelTime expiry (days 2)); securing = placeholderEnvelope "unregistered-renewal"))
  directUnregisteredCreateRejects "unregistered direct create rejects Party issuer absent from anchorers" [anchor, holder, other] unapprovedIssuer
  unregisteredParty <- submit (actAs [other, holder]) do
    createCmd DemoUnregisteredCredential with credential = partyCredential
  unregisteredPartyView <- queryInterfaceContractId other (toInterfaceContractId @Credential unregisteredParty)
  assertMsg "unregistered Party issuer in anchorers creates successfully" (unregisteredPartyView == Some partyCredential)
  extendRegistrationRejects "admin alone lacks anchorer authority" [admin] original credential admin (addRelTime registrationExpiry (days 1))
  extendRegistrationRejects "anchorer alone lacks admin authority" [anchor] original credential admin (addRelTime registrationExpiry (days 1))
  removeSelfAsHolderRejects "non-holder cannot remove holder" other original other
  removeSelfAsHolderRejects "anchorer cannot remove holder" anchor original holder
  removed <- submit holder do
    exerciseCmd (toInterfaceContractId @Credential original) Credential_RemoveSelfAsHolder with holder
  let emptyCid = fromInterfaceContractId @DemoCredential @Credential removed.replacementCredential
  empty <- queryContractId anchor emptyCid
  case empty of
    None -> abort "anchorer must retain visibility"
    Some actual -> do
      assertMsg "final holder removal preserves everything else" (actual.credential == credential with holders = [])
      assertMsg "registration unchanged" (registeredView actual == registration)
      assertMsg "only anchorer remains signatory" (credentialSignatories actual.credential == [anchor])
  let later = addRelTime expiry (days 30)
  intrinsicRenewRejects "unregistered renewal rejects non-anchorer" other emptyCid later
  intrinsicRenewRejects "registered credential rejects intrinsic-only renewal" anchor emptyCid later
  let expected = credential with holders = []
  renewRejects "expected anchorers do not match credential" [other, admin] emptyCid (expected with anchorers = NonEmpty other []) admin later
  renewRejects "anchorer alone lacks admin authority" [anchor] emptyCid expected admin later
  renewRejects "validUntil not extended" [anchor, admin] emptyCid expected admin expiry
  renewWithSecuringRejects "textual issuer renewal without new securing" [anchor, admin] emptyCid expected admin later None
  renewWithSecuringRejects "textual issuer renewal reusing the old securing" [anchor, admin] emptyCid expected admin later expected.securing
  renewWithSecuringRejects "renewal with a malformed securing media type" [anchor, admin] emptyCid expected admin later
    (Some (EnvelopedProof with mediaType = "application/json"; encoded = "placeholder.jws.rejected"))
  renewedCid <- renewCredential [anchor, admin] emptyCid expected admin later
  intrinsic <- queryContractId anchor renewedCid
  let renewedSecuring = renewalSecuring expected
  assertMsg "registered intrinsic renewal changes only validUntil and securing"
    (fmap (.credential) intrinsic == Some (expected with validUntil = Some later; securing = renewedSecuring))
  assertMsg "intrinsic renewal retains registration without extension" (fmap registeredView intrinsic == Some registration)
  let extendedExpiry = addRelTime registrationExpiry (days 25)
  extendRegistrationRejects "expected credential is stale" [anchor, admin] renewedCid expected admin extendedExpiry
  extendRegistrationRejects "admin alone lacks anchorer authority" [admin] renewedCid (expected with validUntil = Some later; securing = renewedSecuring) admin extendedExpiry
  let current = expected with validUntil = Some later; securing = renewedSecuring
  extended <- submit (actAs [anchor, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle renewedCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = current
      registryAdmin = admin
      expiresAt = extendedExpiry
  let registeredCid = fromInterfaceContractId @DemoCredential @RegisteredCredentialLifecycle extended.replacementCredential
  actual <- queryContractId anchor registeredCid
  assertMsg "registration extension preserves entire credential" (fmap (.credential) actual == Some current)
  assertMsg "registration extension changes only expiresAt" (fmap registeredView actual == Some (registration with expiresAt = Some extendedExpiry))
  extendRegistrationRejects "admin alone lacks anchorer authority" [admin] registeredCid current admin (addRelTime extendedExpiry (days 1))
  extendRegistrationRejects "registration expiry not extended" [anchor, admin] registeredCid current admin extendedExpiry
  noIntrinsic <- submit (actAs [anchor, holder]) do
    exerciseCmd factory CredentialRegistryFactory_Anchor with
      credential = credential with validUntil = None
      registration
  let noIntrinsicCid = fromInterfaceContractId @DemoCredential @RegisteredCredential noIntrinsic.issuedCredential
  noIntrinsicView <- queryContractId anchor noIntrinsicCid
  assertMsg "registration expiry can exist without intrinsic expiry" (fmap (.credential.validUntil) noIntrinsicView == Some None)
  renewRejects "intrinsic validity absent, cannot renew" [anchor, holder, admin] noIntrinsicCid (credential with validUntil = None) admin later
  _ <- submit (actAs [anchor, holder, admin]) do
    exerciseCmd (toInterfaceContractId @RegisteredCredentialLifecycle noIntrinsicCid) RegisteredCredentialLifecycle_ExtendRegistration with
      expectedCredential = credential with validUntil = None
      registryAdmin = admin
      expiresAt = extendedExpiry
  noRegistrationExpiry <- submit (actAs [anchor, holder]) do
    exerciseCmd factory CredentialRegistryFactory_Anchor with
      credential
      registration = registration with expiresAt = None
  let noRegistrationExpiryCid = fromInterfaceContractId @DemoCredential @RegisteredCredential noRegistrationExpiry.issuedCredential
  noRegistrationExpiryView <- queryContractId anchor noRegistrationExpiryCid
  assertMsg "intrinsic expiry can exist without registration expiry" (fmap (.expiresAt) noRegistrationExpiryView == Some None)
  extendRegistrationRejects "registration expiry absent, cannot extend" [anchor, holder, admin] noRegistrationExpiryCid credential admin extendedExpiry
  noRegistrationRenewalCid <- renewCredential [anchor, holder, admin] noRegistrationExpiryCid credential admin later
  noRegistrationRenewalView <- queryContractId anchor noRegistrationRenewalCid
  assertMsg "renewal does not require or create registration expiry" (fmap registeredView noRegistrationRenewalView == Some (registration with expiresAt = None))
  assertMsg "renewal preserves claims, schema and updates intrinsic validity with new securing"
    (fmap (.credential) noRegistrationRenewalView == Some (credential with validUntil = Some later; securing = renewedSecuring)
      && fmap (.credential.credentialSchema) noRegistrationRenewalView == Some schema)
  renewRejects "anchorer alone lacks admin authority" [anchor] noRegistrationRenewalCid (credential with validUntil = Some later; securing = renewedSecuring) admin (addRelTime later (days 1))
  archiveCredentialAsAnchorers anchor registeredCid
  archived <- queryContractId anchor registeredCid
  assertMsg "holderless credential remains archivable" (archived == None)
  holderless <- submit anchor do
    exerciseCmd factory CredentialRegistryFactory_Anchor with
      credential = credential with holders = []
      registration
  _ <- submit anchor do
    exerciseCmd (toInterfaceContractId @Credential
      (fromInterfaceContractId @DemoCredential @RegisteredCredential holderless.issuedCredential))
      Credential_ArchiveAsAllHolders
  missing <- queryContractId anchor
    (fromInterfaceContractId @DemoCredential @RegisteredCredential holderless.issuedCredential)
  assertMsg "all-holder archive falls back to anchorers" (missing == None)
  holderDisclosedFactoryPartyIssue
  holderDisclosedFactoryTextAnchor
  unsolicitedOfferPartyIssue
  unsolicitedOfferTextAnchor

holderDisclosedFactoryPartyIssue : Script ()
holderDisclosedFactoryPartyIssue = script do
  admin <- allocateParty "DisclosureFactoryAdmin"
  factoryAnchor <- allocateParty "DisclosureFactoryAnchor"
  anchor <- allocateParty "DisclosureCredentialAnchor"
  issuer <- allocateParty "DisclosurePartyIssuer"
  holder <- allocateParty "DisclosureHolder"
  now <- getTime
  factoryCid <- submit admin do
    createCmd DemoCredentialRegistryFactory with
      registryAdminParty = admin
      anchorers = NonEmpty factoryAnchor []
  let factory = toInterfaceContractId @CredentialRegistryFactory factoryCid
  let credential = CredentialView with
        id = Some "urn:test:disclosed-party-issue"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier_Party issuer
        validFrom = Some now
        validUntil = Some (addRelTime now (days 7))
        credentialSubject = NonEmpty (CredentialSubject None TextMap.empty) []
        credentialSchema = []
        securing = None
        holders = [holder]
        anchorers = NonEmpty anchor [issuer]
  let registration = RegisteredCredentialView admin now None TextMap.empty
  invisibleBefore <- queryContractId holder factoryCid
  assertMsg "holder is not a factory stakeholder" (invisibleBefore == None)
  request <- submit holder do
    createCmd DemoCredentialRequest with
      holder; requestedIssuer = issuer; requestedType = "VerifiableCredential"; registryAdmin = admin
      anchorers = credential.anchorers
  let requestInterface = toInterfaceContractId @CredentialRequest request
  requestView <- queryInterfaceContractId holder requestInterface
  assertMsg "public request exposes only type and routing, not proposed claims"
    (requestView == Some (CredentialRequestView holder issuer "VerifiableCredential" admin credential.anchorers))
  routedRequest <- queryInterfaceContractId admin requestInterface
  assertMsg "routed admin sees active type-only request" (routedRequest == requestView)
  hiddenRequest <- queryInterfaceContractId factoryAnchor requestInterface
  assertMsg "unrouted factory anchor cannot see request" (hiddenRequest == None)
  let makeOffer c = DemoCredentialOffer with
        request = Some requestInterface
        holder; requestedType = "VerifiableCredential"; registryAdmin = admin
        anchorers = credential.anchorers; factory; credential = c; registration
  submitMustFail (actAs [anchor, issuer, admin]) do
    createCmd (makeOffer (credential with holders = [admin]))
  submitMustFail (actAs [anchor, issuer, admin]) do
    createCmd (DemoCredentialOffer with
      request = Some (toInterfaceContractId @CredentialRequest request)
      holder; requestedType = "WrongType"; registryAdmin = admin
      anchorers = credential.anchorers; factory; credential; registration)
  submitMustFail (actAs [anchor, admin]) do
    createCmd (makeOffer credential)
  let filledSubject = CredentialSubject (Some (W3C_VC_Identifier_Party holder))
        (TextMap.fromList [("demo.example/level", Metadata.AV_Int 7)])
  let filledCredential = credential with credentialSubject = NonEmpty filledSubject []
  offer <- submit (actAs [anchor, issuer, admin]) do
    createCmd (makeOffer filledCredential)
  alternate <- submit (actAs [anchor, issuer, admin]) do
    createCmd (makeOffer credential)
  offerView <- queryInterfaceContractId holder (toInterfaceContractId @CredentialOffer offer)
  assertMsg "holder sees complete signed public offer"
    (fmap (.credential) offerView == Some filledCredential
      && fmap (.registration) offerView == Some registration)
  submitMustFail admin do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Reject
  submitMustFail holder do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Withdraw
  submitMustFail holder do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  factoryDisclosure <- disclosureOf admin factoryCid
  issued <- submit (actAs [holder] <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  let issuedCid = fromInterfaceContractId @DemoCredential @RegisteredCredential issued
  holderView <- queryContractId holder issuedCid
  consumedRequest <- queryInterfaceContractId holder requestInterface
  assertMsg "acceptance consumes the request" (consumedRequest == None)
  assertMsg "holder Accept preserves issuer-filled claims and subject"
    (fmap (.credential) holderView == Some filledCredential)
  submitMustFail (actAs [holder] <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer alternate) CredentialOffer_Accept
  invisibleAfter <- queryContractId holder factoryCid
  assertMsg "disclosure does not add holder to factory ACS visibility" (invisibleAfter == None)
  rejectedRequest <- submit holder do
    createCmd DemoCredentialRequest with
      holder; requestedIssuer = issuer; requestedType = "VerifiableCredential"; registryAdmin = admin
      anchorers = credential.anchorers
  rejectedOffer <- submit (actAs [anchor, issuer, admin]) do
    createCmd DemoCredentialOffer with
      request = Some (toInterfaceContractId @CredentialRequest rejectedRequest)
      holder; requestedType = "VerifiableCredential"
      registryAdmin = admin; anchorers = credential.anchorers; factory; credential; registration
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @CredentialRequest rejectedRequest) CredentialRequest_Cancel
  _ <- submit holder do
    exerciseCmd (toInterfaceContractId @CredentialOffer rejectedOffer) CredentialOffer_Reject
  rejectedInvisible <- queryInterfaceContractId holder (toInterfaceContractId @CredentialOffer rejectedOffer)
  assertMsg "rejected offer is inactive" (rejectedInvisible == None)
  stillPending <- queryContractId holder rejectedRequest
  assertMsg "rejection leaves the request active" (stillPending /= None)
  withdrawnOffer <- submit (actAs [anchor, issuer, admin]) do
    createCmd DemoCredentialOffer with
      request = Some (toInterfaceContractId @CredentialRequest rejectedRequest)
      holder; requestedType = "VerifiableCredential"
      registryAdmin = admin; anchorers = credential.anchorers; factory; credential; registration
  submitMustFail anchor do
    exerciseCmd (toInterfaceContractId @CredentialOffer withdrawnOffer) CredentialOffer_Withdraw
  _ <- submit (actAs [anchor, issuer]) do
    exerciseCmd (toInterfaceContractId @CredentialOffer withdrawnOffer) CredentialOffer_Withdraw
  stillPendingAfterWithdraw <- queryContractId holder rejectedRequest
  assertMsg "withdrawal leaves the request active" (stillPendingAfterWithdraw /= None)
  withdrawnInvisible <- queryInterfaceContractId holder (toInterfaceContractId @CredentialOffer withdrawnOffer)
  assertMsg "withdrawn offer is inactive" (withdrawnInvisible == None)
  submitMustFail (actAs [anchor, issuer] <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer withdrawnOffer) CredentialOffer_Accept
  mismatched <- submit (actAs [anchor, issuer, admin]) do
    createCmd DemoCredentialOffer with
      request = Some (toInterfaceContractId @CredentialRequest rejectedRequest)
      holder; requestedType = "DifferentType"
      registryAdmin = admin; anchorers = credential.anchorers; factory
      credential = credential with credentialTypes = ["DifferentType"]
      registration
  submitMustFail (actAs [holder] <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer mismatched) CredentialOffer_Accept
  _ <- submit holder do
    exerciseCmd (toInterfaceContractId @CredentialRequest rejectedRequest) CredentialRequest_Cancel
  submitMustFail (actAs [holder] <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer mismatched) CredentialOffer_Accept

holderDisclosedFactoryTextAnchor : Script ()
holderDisclosedFactoryTextAnchor = script do
  admin <- allocateParty "TextOfferAdmin"
  anchor <- allocateParty "TextOfferAnchor"
  holder <- allocateParty "TextOfferHolder"
  now <- getTime
  factoryCid <- submit admin do
    createCmd DemoCredentialRegistryFactory with
      registryAdminParty = admin; anchorers = NonEmpty anchor []
  let factory = toInterfaceContractId @CredentialRegistryFactory factoryCid
  let credential = (seedBaseCredential anchor holder now) with
        credentialTypes = ["VerifiableCredential", "Qualification"]
        credentialSubject = NonEmpty (CredentialSubject None
          (TextMap.fromList [("demo.example/qualification", Metadata.AV_Text "issued")])) []
  let registration = RegisteredCredentialView admin now (Some (addRelTime now (days 3))) TextMap.empty
  request <- submit holder do
    createCmd DemoCredentialRequest with
      holder; requestedIssuer = anchor; requestedType = "Qualification"; registryAdmin = admin
      anchorers = NonEmpty anchor []
  offer <- submit (actAs [anchor, admin]) do
    createCmd DemoCredentialOffer with
      request = Some (toInterfaceContractId @CredentialRequest request)
      holder; requestedType = "Qualification"; registryAdmin = admin
      anchorers = NonEmpty anchor []; factory; credential; registration
  factoryDisclosure <- disclosureOf admin factoryCid
  issued <- submit (actAs [holder] <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  actual <- queryContractId holder (fromInterfaceContractId @DemoCredential @RegisteredCredential issued)
  assertMsg "textual issuer routes to Anchor and preserves independent registration expiry"
    (fmap (.credential) actual == Some credential && fmap registeredView actual == Some registration)

unsolicitedOfferPartyIssue : Script ()
unsolicitedOfferPartyIssue = script do
  admin <- allocateParty "UnsolicitedAdmin"
  issuer <- allocateParty "UnsolicitedIssuer"
  holder <- allocateParty "UnsolicitedHolder"
  other <- allocateParty "UnsolicitedOther"
  now <- getTime
  factoryCid <- submit admin do
    createCmd DemoCredentialRegistryFactory with
      registryAdminParty = admin; anchorers = NonEmpty issuer []
  let factory = toInterfaceContractId @CredentialRegistryFactory factoryCid
  let credential = (seedBaseCredential issuer holder now) with
        issuer = W3C_VC_Identifier_Party issuer
        securing = None
        credentialTypes = ["VerifiableCredential", "Qualification"]
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party holder))
          (TextMap.fromList [("demo.example/level", Metadata.AV_Int 7)])) []
  let registration = RegisteredCredentialView admin now None TextMap.empty
  let makeOffer c r f = DemoCredentialOffer with
        request = None; holder; requestedType = "Qualification"; registryAdmin = admin
        anchorers = NonEmpty issuer []; factory = f; credential = c; registration = r
  submitMustFail (actAs [issuer, other]) do
    createCmd (makeOffer credential registration factory)
  submitMustFail (actAs [admin, other]) do
    createCmd (makeOffer credential registration factory)
  submitMustFail (actAs [issuer, admin]) do
    createCmd (makeOffer (credential with holders = [other]) registration factory)
  submitMustFail (actAs [issuer, admin]) do
    createCmd (makeOffer (credential with issuer = W3C_VC_Identifier_Party other) registration factory)
  submitMustFail (actAs [issuer, admin]) do
    createCmd (makeOffer (credential with anchorers = NonEmpty other []) registration factory)
  submitMustFail (actAs [issuer, admin]) do
    createCmd (makeOffer credential (registration with registryAdmin = other) factory)
  offer <- submit (actAs [issuer, admin]) do
    createCmd (makeOffer credential registration factory)
  offerView <- queryInterfaceContractId holder (toInterfaceContractId @CredentialOffer offer)
  assertMsg "unsolicited offer shows entire payload and has no request"
    (fmap (.request) offerView == Some None && fmap (.credential) offerView == Some credential
      && fmap (.registration) offerView == Some registration)
  credentialsBefore <- query @DemoCredential holder
  assertMsg "no credential is issued before Accept" (null credentialsBefore)
  submitMustFail admin do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  submitMustFail issuer do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Reject
  submitMustFail holder do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Withdraw
  submitMustFail holder do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  factoryDisclosure <- disclosureOf admin factoryCid
  issued <- submit (actAs holder <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  actual <- queryContractId holder (fromInterfaceContractId @DemoCredential @RegisteredCredential issued)
  assertMsg "holder acceptance issues signed issuer claims and registry data"
    (fmap (.credential) actual == Some credential && fmap registeredView actual == Some registration)
  submitMustFail (actAs holder <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  wrongFactoryCid <- submit other do
    createCmd DemoCredentialRegistryFactory with registryAdminParty = other; anchorers = NonEmpty issuer []
  wrongDisclosure <- disclosureOf other wrongFactoryCid
  wrongOffer <- submit (actAs [issuer, admin]) do
    createCmd (makeOffer credential registration (toInterfaceContractId @CredentialRegistryFactory wrongFactoryCid))
  submitMustFail (actAs holder <> disclose wrongDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer wrongOffer) CredentialOffer_Accept
  rejected <- submit (actAs [issuer, admin]) do
    createCmd (makeOffer credential registration factory)
  _ <- submit holder do
    exerciseCmd (toInterfaceContractId @CredentialOffer rejected) CredentialOffer_Reject
  submitMustFail (actAs holder <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer rejected) CredentialOffer_Accept
  withdrawn <- submit (actAs [issuer, admin]) do
    createCmd (makeOffer credential registration factory)
  submitMustFail admin do
    exerciseCmd (toInterfaceContractId @CredentialOffer withdrawn) CredentialOffer_Withdraw
  _ <- submit issuer do
    exerciseCmd (toInterfaceContractId @CredentialOffer withdrawn) CredentialOffer_Withdraw
  submitMustFail (actAs holder <> disclose factoryDisclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer withdrawn) CredentialOffer_Accept

unsolicitedOfferTextAnchor : Script ()
unsolicitedOfferTextAnchor = script do
  admin <- allocateParty "UnsolicitedTextAdmin"
  anchor <- allocateParty "UnsolicitedTextAnchor"
  holder <- allocateParty "UnsolicitedTextHolder"
  now <- getTime
  factoryCid <- submit admin do
    createCmd DemoCredentialRegistryFactory with registryAdminParty = admin; anchorers = NonEmpty anchor []
  let factory = toInterfaceContractId @CredentialRegistryFactory factoryCid
  let credential = seedBaseCredential anchor holder now
  let registration = RegisteredCredentialView admin now None TextMap.empty
  offer <- submit (actAs [anchor, admin]) do
    createCmd DemoCredentialOffer with
      request = None; holder; requestedType = "VerifiableCredential"; registryAdmin = admin
      anchorers = NonEmpty anchor []; factory; credential; registration
  disclosure <- disclosureOf admin factoryCid
  issued <- submit (actAs holder <> disclose disclosure) do
    exerciseCmd (toInterfaceContractId @CredentialOffer offer) CredentialOffer_Accept
  actual <- queryContractId holder (fromInterfaceContractId @DemoCredential @RegisteredCredential issued)
  assertMsg "textual unsolicited offer anchors only after Accept"
    (fmap (.credential) actual == Some credential && fmap registeredView actual == Some registration)
