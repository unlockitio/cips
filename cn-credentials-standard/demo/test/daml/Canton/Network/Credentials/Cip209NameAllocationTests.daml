-- Draft CIP #209 name allocation scenarios in this demo, not conformance tests.
-- No contract holds the namespace. These scripts cover the per-request
-- structural checks the ledger does enforce, and demonstrate that the ledger
-- does NOT prevent the registry from approving one name twice.
module Canton.Network.Credentials.Cip209NameAllocationTests where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.DemoNames
import Canton.Network.Credentials.TestSupport
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, days)
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

seedNameCredential : Party -> Party -> Text -> Time -> CredentialView
seedNameCredential admin subject name now = CredentialView with
  id = Some ("urn:demo:name:" <> name)
  credentialTypes = ["VerifiableCredential", "DemoPartyName"]
  issuer = W3C_VC_Identifier_Party admin
  validFrom = Some now
  validUntil = Some (addRelTime now (days 180))
  credentialSubject = NonEmpty (CredentialSubject
    (Some (W3C_VC_Identifier_Party subject))
    (TextMap.fromList [("demo.example/name", Metadata.AV_Text name)])) []
  holders = [subject]
  anchorers = NonEmpty admin []

main : Script ()
main = script do
  anchor <- allocateParty "Anchor"
  holder <- allocateParty "Holder"
  admin <- allocateParty "Admin"
  other <- allocateParty "Other"
  subject <- allocateParty "Subject"
  custodian <- allocateParty "Custodian"
  now <- getTime
  let credential = CredentialView with
        id = Some "urn:test:external-issuer"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier "https://external.example/issuer"
        validFrom = Some now
        validUntil = Some (addRelTime now (days 30))
        credentialSubject = NonEmpty (CredentialSubject None TextMap.empty) []
        holders = [holder]
        anchorers = NonEmpty anchor []
  let registration = RegisteredCredentialView admin now (Some (addRelTime now (days 12))) TextMap.empty
  nameFactory <- createCredentialFactory admin (NonEmpty admin [])
  let nameCredential = credential with
        issuer = W3C_VC_Identifier_Party admin
        anchorers = NonEmpty admin []
        holders = [holder]
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party subject)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "alice")])) []
  let nameRegistration = registration with registryAdmin = admin

  -- Reject consumes the request and issues nothing.
  rejectedFirst <- createNameRequest holder admin "alice" nameCredential nameRegistration
  rejectNameRequest admin rejectedFirst
  assertNameCredentialCount admin "alice" 0 "reject issues no name credential"

  -- Authority: registry acceptance and holder consent are both required; only
  -- the registry administrator may reject.
  request <- createNameRequest holder admin "alice" nameCredential nameRegistration
  acceptNameRequestAsRegistryIssuedRejects "Other cannot accept registry-issued request for Admin" [other, holder] request nameFactory
  acceptNameRequestAsRegistryIssuedRejects "Admin alone cannot bind Holder to alice" [admin] request nameFactory
  rejectNameRequestRejects "Other cannot reject request for Admin" other request

  -- Registry-issued happy path: issuer, holder, and subject are distinct roles.
  nameIssued <- acceptNameRequestAsRegistryIssued [admin, holder] request nameFactory
  issuedName <- queryInterfaceContractId admin (toInterfaceContractId @Credential . fromInterfaceContractId @DemoCredential @RegisteredCredential $ nameIssued)
  assertMsg "registry-issued alice carries registry issuer" (fmap (.issuer) issuedName == Some (W3C_VC_Identifier_Party admin))
  assertMsg "registry-issued alice carries independent holder" (fmap (.holders) issuedName == Some [holder])
  assertMsg "registry-issued alice names independent subject id"
    (fmap (\v -> case v.credentialSubject of NonEmpty s [] -> s.id; _ -> None) issuedName == Some (Some (W3C_VC_Identifier_Party subject)))
  assertNameCredentialCount admin "alice" 1 "registry-issued acceptance issues exactly one alice"

  -- Rejecting a later request for an already-issued name reserves nothing and
  -- revokes nothing.
  duplicate <- createNameRequest holder admin "alice" nameCredential nameRegistration
  rejectNameRequest admin duplicate
  rejected <- queryContractId admin duplicate
  assertMsg "reject consumes request" (rejected == None)
  assertNameCredentialCount admin "alice" 1 "reject reserves nothing and revokes nothing"

  -- Non-canonical input is refused at request creation, not rewritten.
  createNameRequestRejects "Holder cannot request noncanonical Alice" holder admin "Alice"
    (nameCredential with credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party holder)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "Alice")])) [])
    nameRegistration

  -- A Party subject id is required.
  createNameRequestRejects "Holder cannot request a name without a Party subject id" holder admin "dave"
    (nameCredential with credentialSubject = NonEmpty (CredentialSubject None (TextMap.fromList [("demo.example/name", Metadata.AV_Text "dave")])) [])
    nameRegistration

  -- The name claim must match the requested name.
  createNameRequestRejects "Holder cannot request alice while claiming eve" holder admin "alice"
    (nameCredential with credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party holder)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "eve")])) [])
    nameRegistration

  -- Requester-issued happy path: the applicant is the Party issuer and both
  -- the applicant and the registry authorize acceptance.
  let requesterCredential = nameCredential with
        issuer = W3C_VC_Identifier_Party holder
        anchorers = NonEmpty holder [admin]
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party holder)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "bob")])) []
  requesterRequest <- createNameRequest holder admin "bob" requesterCredential nameRegistration
  assertNameCredentialCount admin "bob" 0 "pending request issues nothing"
  acceptNameRequestAsRegistryIssuedRejects "Admin cannot accept requester-issuer bob as registry-issued" [admin, holder] requesterRequest nameFactory
  acceptNameRequestAsRequesterIssuedRejects "Admin alone cannot issue Holder's bob claim" [admin] requesterRequest nameFactory
  requesterIssued <- acceptNameRequestAsRequesterIssued [admin, holder] requesterRequest nameFactory
  requesterResult <- queryInterfaceContractId admin (toInterfaceContractId @Credential . fromInterfaceContractId @DemoCredential @RegisteredCredential $ requesterIssued)
  assertMsg "requester-issued credential carries requester issuer" (fmap (.issuer) requesterResult == Some (W3C_VC_Identifier_Party holder))
  assertMsg "requester-issued holder may equal issuer" (fmap (.holders) requesterResult == Some [holder])
  assertMsg "requester-issued subject id is explicit"
    (fmap (\v -> case v.credentialSubject of NonEmpty s [] -> s.id; _ -> None) requesterResult == Some (Some (W3C_VC_Identifier_Party holder)))

  -- The applicant may issue to a different holder, while the subject remains independent.
  let delegatedCredential = requesterCredential with
        holders = [custodian]
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party subject)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "delegated")])) []
  delegatedRequest <- createNameRequest holder admin "delegated" delegatedCredential nameRegistration
  acceptNameRequestAsRequesterIssuedRejects "Applicant and registry cannot bind Custodian without consent" [admin, holder] delegatedRequest nameFactory
  delegatedIssued <- acceptNameRequestAsRequesterIssued [admin, holder, custodian] delegatedRequest nameFactory
  delegatedView <- queryInterfaceContractId admin (toInterfaceContractId @Credential . fromInterfaceContractId @DemoCredential @RegisteredCredential $ delegatedIssued)
  assertMsg "delegated requester remains the issuer" (fmap (.issuer) delegatedView == Some (W3C_VC_Identifier_Party holder))
  assertMsg "delegated custodian is the holder" (fmap (.holders) delegatedView == Some [custodian])
  assertMsg "delegated subject id is independently specified"
    (fmap (\v -> case v.credentialSubject of NonEmpty s [] -> s.id; _ -> None) delegatedView == Some (Some (W3C_VC_Identifier_Party subject)))

  -- Each acceptance path refuses the other's issuer form.
  let registryCredential = nameCredential with
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party holder)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "carol")])) []
  registryRequest <- createNameRequest holder admin "carol" registryCredential nameRegistration
  acceptNameRequestAsRequesterIssuedRejects "Admin and Holder cannot accept registry-issuer carol as requester-issued" [admin, holder] registryRequest nameFactory
  registryIssued <- acceptNameRequestAsRegistryIssued [admin, holder] registryRequest nameFactory
  registryResult <- queryInterfaceContractId admin (toInterfaceContractId @Credential . fromInterfaceContractId @DemoCredential @RegisteredCredential $ registryIssued)
  assertMsg "registry-issued credential carries registry issuer" (fmap (.issuer) registryResult == Some (W3C_VC_Identifier_Party admin))

  bobRegistryRequest <- createNameRequest holder admin "bob" (requesterCredential with issuer = W3C_VC_Identifier_Party admin) nameRegistration
  acceptNameRequestAsRequesterIssuedRejects "requester-issued path refuses a registry-issuer bob credential" [admin, holder] bobRegistryRequest nameFactory
  carolRequesterRequest <- createNameRequest holder admin "carol" (registryCredential with issuer = W3C_VC_Identifier_Party holder) nameRegistration
  acceptNameRequestAsRegistryIssuedRejects "registry-issued path refuses a requester-issuer carol credential" [admin, holder] carolRequesterRequest nameFactory
  rejectNameRequest admin bobRegistryRequest
  rejectNameRequest admin carolRequesterRequest

  -- Consumers discriminate the two assertion kinds by issuer.
  let issuedCredentials = [requesterResult, registryResult]
  let requesterMatches = [c | Some c <- issuedCredentials, c.issuer == W3C_VC_Identifier_Party holder]
  let registryMatches = [c | Some c <- issuedCredentials, c.issuer == W3C_VC_Identifier_Party admin]
  assertMsg "issuer filter selects only requester-issued name" (requesterMatches == [requesterCredential])
  assertMsg "issuer filter selects only registry-issued name" (registryMatches == [registryCredential])

-- Models the registry's off-ledger approval decision using ledger state visible
-- to the registry. Both requests are already pending when it makes the first decision.
registryRejectsSecondPendingNameWhenTaken : Script ()
registryRejectsSecondPendingNameWhenTaken = script do
  holder <- allocateParty "Holder"
  rival <- allocateParty "Rival"
  admin <- allocateParty "Admin"
  now <- getTime
  nameFactory <- createCredentialFactory admin (NonEmpty admin [])
  let nameRegistration = RegisteredCredentialView admin now (Some (addRelTime now (days 12))) TextMap.empty
  let nameCredentialFor subject = CredentialView with
        id = Some "urn:test:pending-name"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier_Party admin
        validFrom = Some now
        validUntil = Some (addRelTime now (days 30))
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party subject)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "taken")])) []
        holders = []
        anchorers = NonEmpty admin []

  firstRequest <- createNameRequest holder admin "taken" (nameCredentialFor holder) nameRegistration
  secondRequest <- createNameRequest rival admin "taken" (nameCredentialFor rival) nameRegistration
  firstPending <- queryContractId admin firstRequest
  secondPending <- queryContractId admin secondRequest
  assertMsg "registry fetches both pending requests for taken before deciding"
    (fmap (.name) firstPending == Some "taken" && fmap (.name) secondPending == Some "taken")
  assertNameCredentialCount admin "taken" 0 "pending requests have not allocated taken"

  firstIssued <- registryDecidePendingName admin "taken" firstRequest nameFactory
  assertMsg "registry approves the first pending request" (firstIssued /= None)
  assertNameCredentialCount admin "taken" 1 "first approval allocates taken"
  secondIssued <- registryDecidePendingName admin "taken" secondRequest nameFactory
  assertMsg "registry rejects the second request because taken is allocated" (secondIssued == None)
  secondRemaining <- queryContractId admin secondRequest
  assertMsg "rejected second request is consumed" (secondRemaining == None)
  assertNameCredentialCount admin "taken" 1 "only one approved taken credential remains"

registryDecidePendingName : Party -> Text -> ContractId DemoNameRequest -> ContractId CredentialRegistryFactory -> Script (Optional (ContractId RegisteredCredential))
registryDecidePendingName admin name request factory = do
  existing <- queryFilter admin (\(c : DemoCredential) -> credentialHasName name c.credential)
  case existing of
    [] -> do
      issued <- acceptNameRequestAsRegistryIssued [admin] request factory
      pure (Some issued)
    _ -> do
      rejectNameRequest admin request
      pure None

-- Demonstrates the ABSENCE of a ledger-side uniqueness guarantee. Uniqueness is
-- the registry's off-ledger operational responsibility; when the registry fails
-- to check, the ledger accepts a second approval of the same name and two valid
-- credentials for one name coexist. Consumers must handle that ambiguity; the
-- resolution API answers 409.
ledgerDoesNotPreventDuplicateNames : Script ()
ledgerDoesNotPreventDuplicateNames = script do
  holder <- allocateParty "Holder"
  rival <- allocateParty "Rival"
  admin <- allocateParty "Admin"
  now <- getTime
  nameFactory <- createCredentialFactory admin (NonEmpty admin [])
  let nameRegistration = RegisteredCredentialView admin now (Some (addRelTime now (days 12))) TextMap.empty
  let nameCredentialFor subject = CredentialView with
        id = Some "urn:test:duplicate-name"
        credentialTypes = ["VerifiableCredential"]
        issuer = W3C_VC_Identifier_Party admin
        validFrom = Some now
        validUntil = Some (addRelTime now (days 30))
        credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party subject)) (TextMap.fromList [("demo.example/name", Metadata.AV_Text "alice")])) []
        holders = []
        anchorers = NonEmpty admin []

  firstRequest <- createNameRequest holder admin "alice" (nameCredentialFor holder) nameRegistration
  firstIssued <- acceptNameRequestAsRegistryIssued [admin] firstRequest nameFactory
  assertNameCredentialCount admin "alice" 1 "first approval issues one alice"

  -- The registry approves the same name again, for a different subject. Nothing
  -- on the ledger refuses this: no contract holds the namespace.
  secondRequest <- createNameRequest rival admin "alice" (nameCredentialFor rival) nameRegistration
  secondIssued <- acceptNameRequestAsRegistryIssued [admin] secondRequest nameFactory
  assertNameCredentialCount admin "alice" 2 "ledger does not prevent a second alice"

  first <- queryContractId admin (fromInterfaceContractId @DemoCredential @RegisteredCredential firstIssued)
  second <- queryContractId admin (fromInterfaceContractId @DemoCredential @RegisteredCredential secondIssued)
  assertMsg "both duplicate name credentials are active" (first /= None && second /= None)
  assertMsg "the two credentials bind the same name to different subjects"
    (fmap (\c -> c.credential.credentialSubject) first /= fmap (\c -> c.credential.credentialSubject) second)
