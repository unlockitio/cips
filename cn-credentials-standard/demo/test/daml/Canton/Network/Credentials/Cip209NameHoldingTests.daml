-- Draft CIP #209 name scenarios model a registry-allocated name as a credential
-- AND a non-divisible CIP-56 token holding. CIP-56 is a real interface dependency
-- of this demo, not a claim that CIP #209 formally requires it or that these
-- scenarios prove conformance. They project the REAL Splice.Api.Token.HoldingV1.Holding
-- interface view, not a local record. The layering:
--   NAME    amount = 1.0, one owner Party, indivisible. One name, one answer.
--   EQUITY  a DIFFERENT InstrumentId with fractional amount : Decimal.
--   CONTROL of the owning Party is Canton topology and threshold signing,
--           entirely out of scope on-ledger here.
-- owner maps to the credential subject Party, never to the issuer or holders.
--
-- TRANSFER is registry re-issuance, not a token transfer. The subject is the
-- issuer's assertion; TransferFactory_Transfer is controlled by
-- transfer.sender alone and the token standard knows nothing of credentials,
-- so a raw holding transfer would leave the credential asserting the old
-- subject while owner moved.
module Canton.Network.Credentials.Cip209NameHoldingTests where

import Canton.Network.Credentials.DemoNameHolding
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import Daml.Script
import Splice.Api.Token.HoldingV1 qualified as Holding
import Splice.Api.Token.MetadataV1 qualified as Metadata

nameCredential : Party -> Party -> Optional W3C_VC_Identifier -> [Party] -> Text -> CredentialView
nameCredential issuer registryAdmin subjectId holders name = CredentialView with
  id = Some ("urn:demo:name-holding:" <> name)
  credentialTypes = ["VerifiableCredential"]
  issuer = W3C_VC_Identifier_Party issuer
  validFrom = None
  validUntil = None
  credentialSubject = NonEmpty (CredentialSubject subjectId (TextMap.fromList [("demo.example/name", Metadata.AV_Text name)])) []
  credentialSchema = []
  securing = None
  holders
  anchorers = NonEmpty registryAdmin []

createNameHolding : Party -> Text -> Party -> Decimal -> Optional Holding.Lock -> CredentialView -> Script (ContractId DemoNameHolding)
createNameHolding registryAdmin name owner amount lock credential = submit registryAdmin do
  createCmd DemoNameHolding with registryAdminParty = registryAdmin; name; owner; amount; lock; credential

-- Labelled rejection helpers: the reason documents intent. submitMustFail
-- passes for ANY failure cause, so it is not proof of a specific reason.
nameHoldingRejects : Text -> Party -> Text -> Party -> Decimal -> Optional Holding.Lock -> CredentialView -> Script ()
nameHoldingRejects reason registryAdmin name owner amount lock credential = do
  debug reason
  submitMustFail registryAdmin do
    createCmd DemoNameHolding with registryAdminParty = registryAdmin; name; owner; amount; lock; credential

transferRejects : Text -> [Party] -> ContractId DemoNameHolding -> Party -> CredentialView -> Script ()
transferRejects reason actors cid newOwner newCredential = do
  debug reason
  submitMustFail (actAs actors) do
    exerciseCmd cid DemoNameHolding_TransferByReissuance with newOwner; newCredential

-- Real HoldingV1 projection through the interface contract id.
holdingView : Party -> ContractId DemoNameHolding -> Script Holding.HoldingView
holdingView reader cid = do
  result <- queryInterfaceContractId reader (toInterfaceContractId @Holding.Holding cid)
  case result of
    Some view -> pure view
    None -> abort "holding interface view missing"

equityView : Party -> ContractId DemoEquityHolding -> Script Holding.HoldingView
equityView reader cid = do
  result <- queryInterfaceContractId reader (toInterfaceContractId @Holding.Holding cid)
  case result of
    Some view -> pure view
    None -> abort "equity holding interface view missing"

-- One contract, two projections: the credential view and the real HoldingView.
nameIsCredentialAndIndivisibleHolding : Script ()
nameIsCredentialAndIndivisibleHolding = script do
  registryAdmin <- allocateParty "NameHoldingRegistryAdmin"
  company <- allocateParty "CompanyParty"
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party company)) [] "empresa.canton"
  cid <- createNameHolding registryAdmin "empresa.canton" company 1.0 None credential
  record <- queryContractId registryAdmin cid
  view <- holdingView registryAdmin cid
  case record of
    None -> abort "name holding missing"
    Some holding -> assertMsg "credential subject Party equals holding owner"
      (subjectParty holding.credential == Some company && view.owner == company)
  assertMsg "name is a single indivisible unit" (view.amount == 1.0)
  assertMsg "instrument is the registry-administered canonical name"
    (view.instrumentId == Holding.InstrumentId registryAdmin "empresa.canton")
  -- Issuing a name does not own it.
  assertMsg "registry issuer is not the owner"
    (credential.issuer == W3C_VC_Identifier_Party registryAdmin && view.owner /= registryAdmin)

-- Shared operation without division: several holders, still one owner.
multipleOperatorsSingleOwner : Script ()
multipleOperatorsSingleOwner = script do
  registryAdmin <- allocateParty "MultiOperatorRegistryAdmin"
  company <- allocateParty "MultiOperatorCompany"
  opA <- allocateParty "OperatorA"
  opB <- allocateParty "OperatorB"
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party company)) [opA, opB] "operada.canton"
  cid <- createNameHolding registryAdmin "operada.canton" company 1.0 None credential
  view <- holdingView registryAdmin cid
  assertMsg "owner is unaffected by multiple holders" (view.owner == company && view.amount == 1.0)
  assertMsg "holders are not owners" (opA /= view.owner && opB /= view.owner)
  -- CIP-56 HoldingView has no holders field; this meta carry is demo-local.
  assertMsg "holders carried in demo-local holding meta"
    (TextMap.lookup demoHoldersMetaKey view.meta.values == Some (demoHoldersMetaValue [opA, opB]))

-- Shared control WITHOUT fractionalising the name. This demo neither enforces
-- nor releases locks; the lock is carried data only.
sharedControlByLockNotDivision : Script ()
sharedControlByLockNotDivision = script do
  registryAdmin <- allocateParty "LockRegistryAdmin"
  company <- allocateParty "LockedCompany"
  shareholderA <- allocateParty "ShareholderA"
  shareholderB <- allocateParty "ShareholderB"
  let lock = Holding.Lock [shareholderA, shareholderB] None None (Some "demo: shared control, not division")
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party company)) [] "bloqueada.canton"
  cid <- createNameHolding registryAdmin "bloqueada.canton" company 1.0 (Some lock) credential
  view <- holdingView registryAdmin cid
  assertMsg "locked name remains one indivisible unit with one owner"
    (view.amount == 1.0 && view.owner == company)
  assertMsg "lock names several controlling parties"
    (case view.lock of
      Some actual -> actual.holders == [shareholderA, shareholderB]
      None -> False)

nameHoldingRejectsInvalidShapes : Script ()
nameHoldingRejectsInvalidShapes = script do
  registryAdmin <- allocateParty "RejectRegistryAdmin"
  company <- allocateParty "RejectCompany"
  other <- allocateParty "RejectOtherParty"
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party company)) [] "rechazada.canton"
  nameHoldingRejects "fractional name holding is rejected: a name is not fungible" registryAdmin "rechazada.canton" company 0.5 None credential
  nameHoldingRejects "duplicate-unit name holding is rejected: one name, one answer" registryAdmin "rechazada.canton" company 2.0 None credential
  nameHoldingRejects "owner differing from the subject Party is rejected" registryAdmin "rechazada.canton" other 1.0 None credential
  let absent = nameCredential registryAdmin registryAdmin None [] "rechazada.canton"
  nameHoldingRejects "absent subject id is rejected: no Party to own the name" registryAdmin "rechazada.canton" company 1.0 None absent
  let textual = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier "did:example:not-a-party")) [] "rechazada.canton"
  nameHoldingRejects "textual subject id is rejected: a holding owner must be a Canton Party" registryAdmin "rechazada.canton" company 1.0 None textual

-- Transfer moves subject and owner TOGETHER, because owner follows the subject.
transferMovesSubjectAndOwnerTogether : Script ()
transferMovesSubjectAndOwnerTogether = script do
  registryAdmin <- allocateParty "TransferRegistryAdmin"
  seller <- allocateParty "SellerCompany"
  buyer <- allocateParty "BuyerCompany"
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party seller)) [] "traspasada.canton"
  cid <- createNameHolding registryAdmin "traspasada.canton" seller 1.0 None credential
  let reissued = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party buyer)) [] "traspasada.canton"
  newCid <- submit (actAs [registryAdmin, seller, buyer]) do
    exerciseCmd cid DemoNameHolding_TransferByReissuance with newOwner = buyer; newCredential = reissued
  oldRecord <- queryContractId registryAdmin cid
  assertMsg "the old name contract is consumed by re-issuance" (oldRecord == None)
  newRecord <- queryContractId registryAdmin newCid
  view <- holdingView registryAdmin newCid
  assertMsg "subject and owner moved together to the new Party"
    (fmap (\h -> subjectParty h.credential) newRecord == Some (Some buyer) && view.owner == buyer)
  assertMsg "the re-issued name is still one indivisible unit under the same instrument"
    (view.amount == 1.0 && view.instrumentId == Holding.InstrumentId registryAdmin "traspasada.canton")
  -- The registry remains the issuer across a transfer: only the registry can
  -- re-assert the binding.
  assertMsg "issuer is unchanged by the transfer"
    (fmap (\h -> h.credential.issuer) newRecord == Some (W3C_VC_Identifier_Party registryAdmin))
  active <- queryFilter registryAdmin (\(h : DemoNameHolding) -> h.name == "traspasada.canton")
  assertMsg "exactly one active name contract remains" (length active == 1)
  -- Intent label only: submitMustFail accepts any failure cause.
  transferRejects "a non-registry Party cannot transfer the name" [seller, buyer] newCid seller credential

-- Ownership and operation are independent axes.
ownerAndHoldersMoveIndependently : Script ()
ownerAndHoldersMoveIndependently = script do
  registryAdmin <- allocateParty "AxesRegistryAdmin"
  company <- allocateParty "AxesCompany"
  successor <- allocateParty "AxesSuccessorCompany"
  opA <- allocateParty "AxesOperatorA"
  opB <- allocateParty "AxesOperatorB"
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party company)) [opA] "ejes.canton"
  cid <- createNameHolding registryAdmin "ejes.canton" company 1.0 None credential
  -- Holders change, owner does not.
  holdersChanged <- submit (actAs [registryAdmin, company, opB]) do
    exerciseCmd cid DemoNameHolding_ReplaceHolders with newHolders = [opB]
  afterHolders <- holdingView registryAdmin holdersChanged
  changedRecord <- queryContractId registryAdmin holdersChanged
  assertMsg "replacing holders leaves the owner untouched"
    (afterHolders.owner == company && fmap (\h -> h.credential.holders) changedRecord == Some [opB])
  -- Owner changes, holders do not.
  let reissued = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party successor)) [opB] "ejes.canton"
  ownerChanged <- submit (actAs [registryAdmin, company, successor]) do
    exerciseCmd holdersChanged DemoNameHolding_TransferByReissuance with newOwner = successor; newCredential = reissued
  afterOwner <- holdingView registryAdmin ownerChanged
  ownerRecord <- queryContractId registryAdmin ownerChanged
  assertMsg "transferring the owner leaves the holders untouched"
    (afterOwner.owner == successor && fmap (\h -> h.credential.holders) ownerRecord == Some [opB])

-- The structural argument for why a raw holding transfer cannot move a name.
-- This is NOT an executed TransferFactory_Transfer: TransferFactory and
-- TransferInstruction are interfaces needing a registry implementation, and no
-- demo TransferFactory exists here. What is executed is the template's ensure
-- rejecting the exact state a sender-authorised holding transfer would produce,
-- namely owner moved while the credential still asserts the old subject.
rawHoldingTransferCannotProduceValidName : Script ()
rawHoldingTransferCannotProduceValidName = script do
  registryAdmin <- allocateParty "RawTransferRegistryAdmin"
  sender <- allocateParty "RawTransferSender"
  receiver <- allocateParty "RawTransferReceiver"
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party sender)) [] "cruda.canton"
  cid <- createNameHolding registryAdmin "cruda.canton" sender 1.0 None credential
  view <- holdingView registryAdmin cid
  assertMsg "the sender is the holding owner a token transfer would move"
    (view.owner == sender)
  nameHoldingRejects
    "moving only the holding owner is rejected: the credential would still assert the old subject"
    registryAdmin "cruda.canton" receiver 1.0 None credential
  debug "TransferFactory_Transfer is controlled by transfer.sender and the token standard has no credential awareness; a valid name move therefore requires registry re-issuance"

-- The three-layer argument, executable: equity moves, the name does not.
shareSaleDoesNotChangeNameResolution : Script ()
shareSaleDoesNotChangeNameResolution = script do
  registryAdmin <- allocateParty "EquityRegistryAdmin"
  company <- allocateParty "EquityCompany"
  shareholderA <- allocateParty "EquityShareholderA"
  shareholderB <- allocateParty "EquityShareholderB"
  let credential = nameCredential registryAdmin registryAdmin (Some (W3C_VC_Identifier_Party company)) [] "empresa.canton"
  nameCid <- createNameHolding registryAdmin "empresa.canton" company 1.0 None credential
  before <- holdingView registryAdmin nameCid
  -- EQUITY is a different instrument with fractional amounts.
  firstA <- submit shareholderA do
    createCmd DemoEquityHolding with registryAdminParty = registryAdmin; instrumentName = "empresa.equity"; owner = shareholderA; amount = 0.6
  firstB <- submit shareholderB do
    createCmd DemoEquityHolding with registryAdminParty = registryAdmin; instrumentName = "empresa.equity"; owner = shareholderB; amount = 0.4
  initialA <- equityView shareholderA firstA
  initialB <- equityView shareholderB firstB
  assertMsg "equity starts fractional under a separate instrument"
    (initialA.amount == 0.6 && initialB.amount == 0.4
      && initialA.instrumentId == Holding.InstrumentId registryAdmin "empresa.equity")
  assertMsg "name instrument differs from the equity instrument"
    (before.instrumentId /= Holding.InstrumentId registryAdmin "empresa.equity")
  -- DEMO SHORTCUT: archive and recreate to redistribute equity. This is not a
  -- CIP-56 transfer; no TransferInstruction protocol exists in this demo.
  submit shareholderA do exerciseCmd firstA DemoEquityHolding_Archive
  submit shareholderB do exerciseCmd firstB DemoEquityHolding_Archive
  secondA <- submit shareholderA do
    createCmd DemoEquityHolding with registryAdminParty = registryAdmin; instrumentName = "empresa.equity"; owner = shareholderA; amount = 0.1
  secondB <- submit shareholderB do
    createCmd DemoEquityHolding with registryAdminParty = registryAdmin; instrumentName = "empresa.equity"; owner = shareholderB; amount = 0.9
  movedA <- equityView shareholderA secondA
  movedB <- equityView shareholderB secondB
  assertMsg "equity fractions changed hands" (movedA.amount == 0.1 && movedB.amount == 0.9)
  after <- holdingView registryAdmin nameCid
  stillThere <- queryContractId registryAdmin nameCid
  assertMsg "the name holding contract and owner are unchanged by the share sale"
    (after == before && after.owner == company && after.amount == 1.0)
  assertMsg "the name contract itself was never archived or replaced"
    (fmap (.owner) stillThere == Some company)
