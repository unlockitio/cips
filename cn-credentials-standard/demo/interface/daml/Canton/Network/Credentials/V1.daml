module Canton.Network.Credentials.V1 where

import DA.List (unique)
import DA.NonEmpty (NonEmpty, toList)
import DA.Optional (isSome)
import DA.TextMap (TextMap)
import Splice.Api.Token.MetadataV1 qualified as Api.Token.MetadataV1

-- Candidate reference interfaces for the Canton Network Credentials Standard.

data W3C_VC_Identifier
  = W3C_VC_Identifier_Party Party
  | W3C_VC_Identifier Text
  deriving (Eq, Ord, Show)

issuerParty : W3C_VC_Identifier -> [Party]
issuerParty issuer = case issuer of
  W3C_VC_Identifier_Party party -> [party]
  W3C_VC_Identifier _ -> []

partyIssuerIsAnchorer : CredentialView -> Bool
partyIssuerIsAnchorer credential = case credential.issuer of
  W3C_VC_Identifier_Party party -> elem party (toList credential.anchorers)
  W3C_VC_Identifier _ -> True

data CredentialSubject = CredentialSubject with
  id : Optional W3C_VC_Identifier
  claims : TextMap Api.Token.MetadataV1.AnyValue
 deriving (Eq, Show)

-- | W3C VC Data Model 2.0 `credentialSchema` entry. `schemaType` carries the
-- JSON `type` member, which is a Daml keyword.
data CredentialSchema = CredentialSchema with
  id : Text
  schemaType : Text
  digestSRI : Optional Text
 deriving (Eq, Show)

-- | Derived index over one Data Integrity `proof`. `proofValue` is deliberately
-- absent: the signed bytes live in `EmbeddedProof.securedDocument` and MUST NOT
-- be duplicated here.
data DataIntegrityProofSummary = DataIntegrityProofSummary with
  proofId : Optional Text
  proofType : Text
  cryptosuite : Optional Text
  created : Optional Text
  expires : Optional Text
  verificationMethod : Optional Text
  proofPurpose : Text
  previousProof : [Text]
 deriving (Eq, Show)

-- | The securing mechanism of a conforming W3C VC: either enveloping
-- (VC-JOSE-COSE) or embedded (Data Integrity). `encoded` and `securedDocument`
-- preserve the exact secured bytes; every typed field above is only an index.
data CredentialSecuring
  = EnvelopedProof with
      mediaType : Text
      encoded : Text
  | EmbeddedProof with
      securedDocument : Text
      proofs : NonEmpty DataIntegrityProofSummary
 deriving (Eq, Show)

-- | Media types VC-JOSE-COSE defines for enveloped verifiable credentials.
envelopeMediaTypes : [Text]
envelopeMediaTypes = ["application/vc+jwt", "application/vc+sd-jwt", "application/vc+cose"]

dataIntegrityProofWellFormed : DataIntegrityProofSummary -> Bool
dataIntegrityProofWellFormed proof =
  proof.proofType /= ""
    && proof.proofPurpose /= ""
    -- `cryptosuite` is REQUIRED for DataIntegrityProof.
    && (proof.proofType /= "DataIntegrityProof" || isSome proof.cryptosuite)

-- | Structural check only. No signature, JWS, COSE or cryptosuite verification
-- happens on-ledger.
securingWellFormed : Optional CredentialSecuring -> Bool
securingWellFormed securing = case securing of
  None -> True
  Some (EnvelopedProof {mediaType = mediaType, encoded = encoded}) ->
    elem mediaType envelopeMediaTypes && encoded /= ""
  Some (EmbeddedProof {securedDocument = securedDocument, proofs = proofs}) ->
    securedDocument /= "" && all dataIntegrityProofWellFormed (toList proofs)

credentialSchemaWellFormed : [CredentialSchema] -> Bool
credentialSchemaWellFormed = all (\schema -> schema.id /= "" && schema.schemaType /= "")

-- | A textual (external) issuer cannot sign a Canton transaction, so the only
-- evidence of issuance is the securing mechanism; it is therefore REQUIRED.
-- A Canton Party issuer authorizes by signing, and MAY also carry securing.
textualIssuerIsSecured : CredentialView -> Bool
textualIssuerIsSecured credential = case credential.issuer of
  W3C_VC_Identifier_Party _ -> True
  W3C_VC_Identifier _ -> isSome credential.securing

credentialStructurallyValid : CredentialView -> Bool
credentialStructurallyValid credential =
  textualIssuerIsSecured credential
    && securingWellFormed credential.securing
    && credentialSchemaWellFormed credential.credentialSchema

-- | Renewal changes the credential's validity, so securing that signed the old
-- validity must not survive it. `newSecuring` is the securing the replacement
-- credential carries, and `None` means explicitly cleared. A textual issuer MUST
-- supply new securing; a Party issuer that had securing MUST either replace it
-- or clear it.
renewalSecuringValid : CredentialView -> Optional CredentialSecuring -> Bool
renewalSecuringValid credential newSecuring =
  securingWellFormed newSecuring
    && case credential.issuer of
      W3C_VC_Identifier _ -> isSome newSecuring && newSecuring /= credential.securing
      W3C_VC_Identifier_Party _ ->
        credential.securing == None || newSecuring /= credential.securing

data CredentialView = CredentialView with
  id : Optional Text
  credentialTypes : [Text]
  issuer : W3C_VC_Identifier
  validFrom : Optional Time
  validUntil : Optional Time
  credentialSubject : NonEmpty CredentialSubject
  -- | Zero or more W3C VC `credentialSchema` entries. Not evaluated on-ledger.
  credentialSchema : [CredentialSchema]
  -- | The securing mechanism, REQUIRED for a textual issuer and OPTIONAL for a
  -- Canton Party issuer.
  securing : Optional CredentialSecuring
  -- | Unique list of parties (represented as a list for better JSON encoding). Entries MUST be unique.
  holders : [Party]
  -- | Nonempty list of parties. Entries MUST be unique.
  anchorers : NonEmpty Party
 deriving (Eq, Show)

data Credential_RemoveSelfAsHolderResult = Credential_RemoveSelfAsHolderResult with
  replacementCredential : ContractId Credential
 deriving (Eq, Show)

data Credential_ArchiveResult = Credential_ArchiveResult with
  archivedCredential : CredentialView
  meta : Api.Token.MetadataV1.Metadata
 deriving (Eq, Show)

interface Credential where
  viewtype CredentialView

  credential_publicFetchImpl : ContractId Credential -> Credential_PublicFetch -> Update CredentialView

  nonconsuming choice Credential_PublicFetch : CredentialView
    with
      actor : Party
    controller actor
    do
      credential_publicFetchImpl this self arg

  credential_removeSelfAsHolderImpl : ContractId Credential -> Credential_RemoveSelfAsHolder -> Update Credential_RemoveSelfAsHolderResult

  choice Credential_RemoveSelfAsHolder : Credential_RemoveSelfAsHolderResult
    with
      holder : Party
    controller holder
    do
      let currentHolders = (view this).holders
      assertMsg "exercising party is not a credential holder" (elem holder currentHolders)
      credential_removeSelfAsHolderImpl this self arg

  credential_archiveAsAllHoldersImpl : ContractId Credential -> Credential_ArchiveAsAllHolders -> Update Credential_ArchiveResult

  choice Credential_ArchiveAsAllHolders : Credential_ArchiveResult
    controller (if null (view this).holders then toList (view this).anchorers else (view this).holders)
    do
      credential_archiveAsAllHoldersImpl this self arg

  choice Credential_ArchiveAsAnchorers : Credential_ArchiveResult
    controller (toList (view this).anchorers)
    do
      credential_archiveAsAllHoldersImpl this self Credential_ArchiveAsAllHolders

data CredentialLifecycle_RenewResult = CredentialLifecycle_RenewResult with
  replacementCredential : ContractId CredentialLifecycle
 deriving (Eq, Show)

interface CredentialLifecycle requires Credential where
  viewtype CredentialView

  credentialLifecycle_renewImpl : ContractId CredentialLifecycle -> CredentialLifecycle_Renew -> Update CredentialLifecycle_RenewResult

  choice CredentialLifecycle_Renew : CredentialLifecycle_RenewResult
    with
      validUntil : Time
      -- | Securing for the renewed validity; `None` explicitly clears it.
      newSecuring : Optional CredentialSecuring
    controller (toList (view this).anchorers)
    do
      let credential = view this
      assertMsg "renewal requires an existing validUntil" (credential.validUntil /= None)
      assertMsg "renewal validUntil must be strictly later" (Some validUntil > credential.validUntil)
      assertMsg "renewal requires securing that covers the new validity" (renewalSecuringValid credential newSecuring)
      credentialLifecycle_renewImpl this self arg

data RegisteredCredentialView = RegisteredCredentialView with
  registryAdmin : Party
  registeredAt : Time
  expiresAt : Optional Time
  meta : TextMap Api.Token.MetadataV1.AnyValue
 deriving (Eq, Show)

data RegisteredCredential_PublicFetchResult = RegisteredCredential_PublicFetchResult with
  credential : CredentialView
  registration : RegisteredCredentialView
 deriving (Eq, Show)

interface RegisteredCredential requires Credential where
  viewtype RegisteredCredentialView

  registeredCredential_publicFetchImpl : ContractId RegisteredCredential -> RegisteredCredential_PublicFetch -> Update RegisteredCredential_PublicFetchResult

  nonconsuming choice RegisteredCredential_PublicFetch : RegisteredCredential_PublicFetchResult
    with
      expectedRegistryAdmin : Party
      actor : Party
    controller actor
    do
      result <- registeredCredential_publicFetchImpl this self arg
      assertMsg "unexpected registry administrator" (expectedRegistryAdmin == result.registration.registryAdmin)
      pure result

data RegisteredCredentialLifecycle_RenewResult = RegisteredCredentialLifecycle_RenewResult with
  replacementCredential : ContractId RegisteredCredentialLifecycle
 deriving (Eq, Show)

data RegisteredCredentialLifecycle_ExtendRegistrationResult = RegisteredCredentialLifecycle_ExtendRegistrationResult with
  replacementCredential : ContractId RegisteredCredentialLifecycle
 deriving (Eq, Show)

interface RegisteredCredentialLifecycle requires RegisteredCredential, CredentialLifecycle, Credential where
  viewtype RegisteredCredentialView

  registeredCredentialLifecycle_renewImpl : ContractId RegisteredCredentialLifecycle -> RegisteredCredentialLifecycle_Renew -> Update RegisteredCredentialLifecycle_RenewResult

  choice RegisteredCredentialLifecycle_Renew : RegisteredCredentialLifecycle_RenewResult
    with
      expectedCredential : CredentialView
      registryAdmin : Party
      validUntil : Time
      -- | Securing for the renewed validity; `None` explicitly clears it.
      newSecuring : Optional CredentialSecuring
      profileAuthorization : Optional (TextMap Api.Token.MetadataV1.AnyValue)
      paymentEvidence : Optional (TextMap Api.Token.MetadataV1.AnyValue)
    controller (toList expectedCredential.anchorers <> [registryAdmin])
    do
      assertMsg "renewal requires an existing validUntil" (expectedCredential.validUntil /= None)
      assertMsg "renewal validUntil must be strictly later" (Some validUntil > expectedCredential.validUntil)
      assertMsg "renewal requires securing that covers the new validity" (renewalSecuringValid expectedCredential newSecuring)
      assertMsg "party is not the registry administrator" (registryAdmin == (view this).registryAdmin)
      registeredCredentialLifecycle_renewImpl this self arg

  registeredCredentialLifecycle_extendRegistrationImpl : ContractId RegisteredCredentialLifecycle -> RegisteredCredentialLifecycle_ExtendRegistration -> Update RegisteredCredentialLifecycle_ExtendRegistrationResult

  choice RegisteredCredentialLifecycle_ExtendRegistration : RegisteredCredentialLifecycle_ExtendRegistrationResult
    with
      expectedCredential : CredentialView
      registryAdmin : Party
      expiresAt : Time
    controller (toList expectedCredential.anchorers <> [registryAdmin])
    do
      assertMsg "party is not the registry administrator" (registryAdmin == (view this).registryAdmin)
      assertMsg "extension requires an existing expiresAt" ((view this).expiresAt /= None)
      assertMsg "extension expiresAt must be strictly later" (Some expiresAt > (view this).expiresAt)
      registeredCredentialLifecycle_extendRegistrationImpl this self arg

-- A request discloses only the holder's intended type and routing authorities.
data CredentialRequestView = CredentialRequestView with
  holder : Party
  requestedType : Text
  registryAdmin : Party
  anchorers : NonEmpty Party
 deriving (Eq, Show)

interface CredentialRequest where
  viewtype CredentialRequestView

  credentialRequest_fulfillImpl : ContractId CredentialRequest -> CredentialRequest_Fulfill -> Update ()
  credentialRequest_cancelImpl : ContractId CredentialRequest -> CredentialRequest_Cancel -> Update ()

  choice CredentialRequest_Fulfill : ()
    controller (view this).holder
    do credentialRequest_fulfillImpl this self arg

  choice CredentialRequest_Cancel : ()
    controller (view this).holder
    do credentialRequest_cancelImpl this self arg

-- Offer stakeholders see the full issuer-supplied payload, unlike request stakeholders.
data CredentialOfferView = CredentialOfferView with
  request : ContractId CredentialRequest
  holder : Party
  requestedType : Text
  registryAdmin : Party
  anchorers : NonEmpty Party
  factory : ContractId CredentialRegistryFactory
  credential : CredentialView
  registration : RegisteredCredentialView
 deriving (Eq, Show)

interface CredentialOffer where
  viewtype CredentialOfferView

  credentialOffer_acceptImpl : ContractId CredentialOffer -> CredentialOffer_Accept -> Update (ContractId RegisteredCredential)
  credentialOffer_rejectImpl : ContractId CredentialOffer -> CredentialOffer_Reject -> Update ()
  credentialOffer_withdrawImpl : ContractId CredentialOffer -> CredentialOffer_Withdraw -> Update ()

  choice CredentialOffer_Accept : ContractId RegisteredCredential
    controller (view this).holder
    do credentialOffer_acceptImpl this self arg

  choice CredentialOffer_Reject : ()
    controller (view this).holder
    do credentialOffer_rejectImpl this self arg

  choice CredentialOffer_Withdraw : ()
    controller (toList (view this).anchorers)
    do credentialOffer_withdrawImpl this self arg

data CredentialRegistryFactoryView = CredentialRegistryFactoryView with
  registryAdmin : Party
  anchorers : NonEmpty Party
 deriving (Eq, Show)

data CredentialRegistryFactory_IssueResult = CredentialRegistryFactory_IssueResult with
  issuedCredential : ContractId RegisteredCredential
 deriving (Eq, Show)

interface CredentialRegistryFactory where
  viewtype CredentialRegistryFactoryView

  credentialRegistryFactory_issueImpl : ContractId CredentialRegistryFactory -> CredentialRegistryFactory_Issue -> Update CredentialRegistryFactory_IssueResult
  credentialRegistryFactory_anchorImpl : ContractId CredentialRegistryFactory -> CredentialRegistryFactory_Anchor -> Update CredentialRegistryFactory_IssueResult

  nonconsuming choice CredentialRegistryFactory_Issue : CredentialRegistryFactory_IssueResult
    with
      credential : CredentialView
      registration : RegisteredCredentialView
    controller (toList credential.anchorers <> credential.holders <> issuerParty credential.issuer)
    do
      let factory = view this
      assertMsg "Issue requires a Canton Party issuer" (case credential.issuer of
        W3C_VC_Identifier_Party _ -> True
        W3C_VC_Identifier _ -> False)
      assertMsg "credential holders must be unique" (unique credential.holders)
      assertMsg "credential anchorers must be unique" (unique (toList credential.anchorers))
      assertMsg "securing mechanism is malformed" (securingWellFormed credential.securing)
      assertMsg "credentialSchema entries require a non-empty id and type" (credentialSchemaWellFormed credential.credentialSchema)
      assertMsg "registration administrator does not match the factory" (registration.registryAdmin == factory.registryAdmin)
      credentialRegistryFactory_issueImpl this self arg

  nonconsuming choice CredentialRegistryFactory_Anchor : CredentialRegistryFactory_IssueResult
    with
      credential : CredentialView
      registration : RegisteredCredentialView
    controller (toList credential.anchorers <> credential.holders)
    do
      let factory = view this
      assertMsg "Anchor requires an external textual issuer" (case credential.issuer of
        W3C_VC_Identifier _ -> True
        W3C_VC_Identifier_Party _ -> False)
      assertMsg "credential holders must be unique" (unique credential.holders)
      assertMsg "credential anchorers must be unique" (unique (toList credential.anchorers))
      assertMsg "a textual issuer requires a securing mechanism" (textualIssuerIsSecured credential)
      assertMsg "securing mechanism is malformed" (securingWellFormed credential.securing)
      assertMsg "credentialSchema entries require a non-empty id and type" (credentialSchemaWellFormed credential.credentialSchema)
      assertMsg "registration administrator does not match the factory" (registration.registryAdmin == factory.registryAdmin)
      credentialRegistryFactory_anchorImpl this self arg
