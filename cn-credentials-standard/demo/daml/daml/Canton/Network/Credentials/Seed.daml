module Canton.Network.Credentials.Seed where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

seedCount : Int
seedCount = 360

seedValue : Int
seedValue = 20260918

main : Script [ContractId DemoCredential]
main = script do
  issuer <- allocatePartyByHint (PartyIdHint "DemoIssuer")
  holderA <- allocatePartyByHint (PartyIdHint "DemoHolderA")
  holderB <- allocatePartyByHint (PartyIdHint "DemoHolderB")
  registryAdmin <- allocatePartyByHint (PartyIdHint "DemoRegistryAdmin")
  now <- getTime
  submit issuer do
    mapA (createCredential issuer holderA holderB registryAdmin now) [0 .. seedCount - 1]

createCredential : Party -> Party -> Party -> Party -> Time -> Int -> Commands (ContractId DemoCredential)
createCredential issuer holderA holderB registryAdmin now n = do
  let holders = if n % 3 == 0 then NonEmpty holderA [holderB] else NonEmpty holderA []
  let subjectId = if n % 5 == 0 then None else Some (W3C_VC_Identifier ("urn:demo:subject:" <> show (pseudoRandom n % 97)))
  let view = CredentialView with
        id = Some (logicalId n)
        credentialTypes = ["VerifiableCredential", credentialCategory n]
        issuer = W3C_VC_Identifier_Party issuer
        validFrom = Some now
        validUntil = None
        credentialSubject = NonEmpty (CredentialSubject subjectId (mkClaims n)) []
        holders
  createCmd DemoCredential with
    issuerParty = issuer
    authorityParty = holderA
    holderParties = holders
    registryAdminParty = registryAdmin
    credential = view
    registration = RegistrationMetadata with
      registryAdmin
      registeredAt = Some now
      expiresAt = None
      meta = Metadata.Metadata (TextMap.fromList [("demo.example/seed", show seedValue)])

logicalId : Int -> Text
logicalId n = "urn:demo:credential:" <> pad3 n

pad3 : Int -> Text
pad3 n
  | n < 10 = "00" <> show n
  | n < 100 = "0" <> show n
  | otherwise = show n

-- A deterministic integer mixer. It varies fixtures without relying on runtime randomness.
pseudoRandom : Int -> Int
pseudoRandom n = (n * 1103515245 + seedValue) % 2147483647
