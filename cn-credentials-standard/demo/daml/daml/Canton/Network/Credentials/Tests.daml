module Canton.Network.Credentials.Tests where

import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import Daml.Script
import Splice.Api.Token.MetadataV1 qualified as Metadata

main : Script ()
main = script do
  issuer <- allocateParty "TestIssuer"
  holderA <- allocateParty "TestHolderA"
  holderB <- allocateParty "TestHolderB"
  registryAdmin <- allocateParty "TestRegistryAdmin"

  testTwoHolderSelfRemoval issuer holderA holderB registryAdmin
  testAuthorityTransfer issuer holderA holderB registryAdmin
  testSingleHolderSelfRemovalRejects issuer holderA registryAdmin
  testAllHolderArchiveIsDistinct issuer holderA holderB registryAdmin

testTwoHolderSelfRemoval : Party -> Party -> Party -> Party -> Script ()
testTwoHolderSelfRemoval issuer holderA holderB registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holderA [holderB]
  let credential = credentialView issuer holders now "urn:test:credential:self-removal"
  let registration = registrationMetadata registryAdmin now

  cid <- submit issuer do
    createCmd DemoCredential with
      issuerParty = issuer
      authorityParty = holderA
      holderParties = holders
      registryAdminParty = registryAdmin
      credential
      registration

  result <- submit holderB do
    exerciseCmd
      (toInterfaceContractId @Credential cid)
      Credential_RemoveSelfAsHolder with holder = holderB

  let replacementCid =
        fromInterfaceContractId @DemoCredential @Credential result.replacementCredential
  old <- queryContractId holderA cid
  assertMsg "self-removal consumes the original contract" (old == None)

  replacement <- queryContractId holderA replacementCid
  case replacement of
    None -> abort "replacement credential should be active"
    Some actual -> do
      let expectedHolders = NonEmpty holderA []
      assertMsg "replacement removes only the exercising holder"
        (actual.holderParties == expectedHolders)
      assertMsg "credential holders match the replacement holders"
        (actual.credential.holders == expectedHolders)
      assertMsg "authority remains with the remaining authority holder"
        (actual.authorityParty == holderA)
      assertMsg "logical credential data is preserved"
        (actual.credential == credential with holders = expectedHolders)
      assertMsg "registration metadata is preserved"
        (actual.registration == registration)

testAuthorityTransfer : Party -> Party -> Party -> Party -> Script ()
testAuthorityTransfer issuer holderA holderB registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holderA [holderB]
  let credential = credentialView issuer holders now "urn:test:credential:authority-transfer"
  let registration = registrationMetadata registryAdmin now

  cid <- submit issuer do
    createCmd DemoCredential with
      issuerParty = issuer
      authorityParty = holderA
      holderParties = holders
      registryAdminParty = registryAdmin
      credential
      registration

  result <- submit holderA do
    exerciseCmd
      (toInterfaceContractId @Credential cid)
      Credential_RemoveSelfAsHolder with holder = holderA

  let replacementCid =
        fromInterfaceContractId @DemoCredential @Credential result.replacementCredential
  replacement <- queryContractId holderB replacementCid
  case replacement of
    None -> abort "replacement credential should be visible to the remaining holder"
    Some actual -> do
      let expectedHolders = NonEmpty holderB []
      assertMsg "removed authority holder is absent"
        (actual.holderParties == expectedHolders)
      assertMsg "authority transfers to the remaining holder"
        (actual.authorityParty == holderB)
      assertMsg "logical credential data survives authority transfer"
        (actual.credential == credential with holders = expectedHolders)
      assertMsg "registration metadata survives authority transfer"
        (actual.registration == registration)

testSingleHolderSelfRemovalRejects : Party -> Party -> Party -> Script ()
testSingleHolderSelfRemovalRejects issuer holder registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holder []
  let credential = credentialView issuer holders now "urn:test:credential:single-holder"
  let registration = registrationMetadata registryAdmin now

  cid <- submit issuer do
    createCmd DemoCredential with
      issuerParty = issuer
      authorityParty = holder
      holderParties = holders
      registryAdminParty = registryAdmin
      credential
      registration

  submitMustFail holder do
    exerciseCmd
      (toInterfaceContractId @Credential cid)
      Credential_RemoveSelfAsHolder with holder

testAllHolderArchiveIsDistinct : Party -> Party -> Party -> Party -> Script ()
testAllHolderArchiveIsDistinct issuer holderA holderB registryAdmin = script do
  now <- getTime
  let holders = NonEmpty holderA [holderB]
  let credential = credentialView issuer holders now "urn:test:credential:archive"
  let registration = registrationMetadata registryAdmin now

  cid <- submit issuer do
    createCmd DemoCredential with
      issuerParty = issuer
      authorityParty = holderA
      holderParties = holders
      registryAdminParty = registryAdmin
      credential
      registration

  result <- submitMulti [holderA, holderB] [] do
    exerciseCmd
      (toInterfaceContractId @Credential cid)
      Credential_ArchiveAsAllHolders

  assertMsg "all-holder archive returns the archived logical credential"
    (result.archivedCredential == credential)
  assertMsg "all-holder archive remains distinct and returns no replacement"
    (result.meta == Metadata.emptyMetadata)
  old <- queryContractId holderA cid
  assertMsg "all-holder archive consumes the credential" (old == None)

credentialView : Party -> NonEmpty Party -> Time -> Text -> CredentialView
credentialView issuer holders now credentialId = CredentialView with
  id = Some credentialId
  credentialTypes = ["VerifiableCredential", "TestCredential"]
  issuer = W3C_VC_Identifier_Party issuer
  validFrom = Some now
  validUntil = None
  credentialSubject = NonEmpty
    (CredentialSubject
      (Some (W3C_VC_Identifier "urn:test:subject:001"))
      (TextMap.fromList
        [ ("test.example/name", Metadata.AV_Text "Alice")
        , ("test.example/active", Metadata.AV_Bool True)
        ]))
    []
  holders

registrationMetadata : Party -> Time -> RegistrationMetadata
registrationMetadata registryAdmin now = RegistrationMetadata with
  registryAdmin
  registeredAt = Some now
  expiresAt = None
  meta = Metadata.emptyMetadata
