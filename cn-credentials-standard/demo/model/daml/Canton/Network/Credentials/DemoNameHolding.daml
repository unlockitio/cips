-- A registry-allocated name is a credential that is ALSO a CIP-56 token
-- holding, but a non-divisible one. CIP #209's NameRecord co-implements
-- RegistryV1.Credential and HoldingV1.Holding with quantity 1, so
-- co-implementation is the shared position rather than a novelty here. This
-- module implements the REAL Splice.Api.Token.HoldingV1.Holding interface.
--
-- A name must resolve to exactly ONE answer. Two fractional holdings of
-- alice.canton would mean two resolution answers, that is a designed-in 409.
-- HoldingView.owner is a singular Party, not a list, so fractional holdings
-- would mean several contracts sharing one instrumentId, exactly the
-- duplication that #209 spends 256 shards avoiding.
--
-- Three layers, deliberately kept separate:
--   NAME    amount = 1.0, owned by one Party, indivisible.
--   EQUITY  a DIFFERENT InstrumentId with fractional amount : Decimal.
--   CONTROL of the Party is Canton topology and threshold signing, not a
--           fractionalised name. #209's own DRO is the precedent: a
--           multi-hosted Party with a DecentralizedNamespaceDefinition and
--           k-of-n signing rather than a split DRO.
-- A share sale therefore must not change name resolution.
--
-- owner maps to the credential SUBJECT, the Party the name resolves to, not
-- the issuer and not the holders.
--
-- TRANSFER: a name cannot be moved by moving the holding. owner is pinned to
-- credentialSubject.id, and the subject is the ISSUER'S ASSERTION, not a
-- mutable field. TransferFactory_Transfer is controlled by transfer.sender
-- alone, and the token standard has zero references to Credential or
-- RegistryV1, so a raw holding transfer would move owner while the credential
-- kept asserting the old subject, leaving the two views disagreeing. The
-- ensure clause below rejects exactly that state, which is why name transfer
-- must be registry RE-ISSUANCE instead.
module Canton.Network.Credentials.DemoNameHolding where

import Canton.Network.Credentials.DemoNames (canonicalName, credentialHasName)
import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import Splice.Api.Token.HoldingV1 qualified as Holding
import Splice.Api.Token.MetadataV1 qualified as Metadata

-- The Party a single-subject credential resolves to, when the subject id is
-- an explicit Party. Textual and absent subject ids have no owner.
subjectParty : CredentialView -> Optional Party
subjectParty credential = case credential.credentialSubject of
  NonEmpty subject [] -> case subject.id of
    Some (W3C_VC_Identifier_Party party) -> Some party
    _ -> None
  _ -> None

-- CIP-56 HoldingView has no holders field, and HoldingV1 meta values are Text,
-- so the credential's multi-operator holders list is carried as a joined text
-- under this demo-local key. That is a demo-local carry, not a standard mapping.
demoHoldersMetaKey : Text
demoHoldersMetaKey = "demo.example/holding-holders"

demoHoldersMetaValue : [Party] -> Text
demoHoldersMetaValue holders = case holders of
  [] -> ""
  party :: rest -> foldl (\acc next -> acc <> ";" <> partyToText next) (partyToText party) rest

-- No transfer, split, merge or burn choices through the holding: Holding
-- declares none, and transfer is registry re-issuance below.
template DemoNameHolding
  with
    registryAdminParty : Party
    name : Text
    owner : Party
    amount : Decimal
    lock : Optional Holding.Lock
    credential : CredentialView
  where
    signatory registryAdminParty
    observer owner :: credential.holders
    ensure canonicalName name
      && credentialHasName name credential
      -- A name is not fungible: exactly one indivisible unit.
      && amount == 1.0
      -- owner is asserted against the subject Party, never inferred from the
      -- issuer or the holders. A raw holding transfer cannot satisfy this.
      && subjectParty credential == Some owner

    interface instance Holding.Holding for DemoNameHolding where
      view = Holding.HoldingView with
        owner
        instrumentId = Holding.InstrumentId registryAdminParty name
        amount
        lock
        meta = Metadata.Metadata with
          values = TextMap.fromList [(demoHoldersMetaKey, demoHoldersMetaValue credential.holders)]

    -- Name transfer as registry RE-ISSUANCE. The registry re-asserts the
    -- binding, so only the registry can move a name; the issuer remains the
    -- approval point. Holders are not consulted for ownership and may change
    -- independently.
    choice DemoNameHolding_TransferByReissuance : ContractId DemoNameHolding
      with
        newOwner : Party
        newCredential : CredentialView
      controller registryAdminParty :: owner :: [newOwner]
      do
        assertMsg "re-issued name must keep the same canonical name"
          (canonicalName name && credentialHasName name newCredential)
        assertMsg "re-issued subject must be the new owner"
          (subjectParty newCredential == Some newOwner)
        create this with owner = newOwner; credential = newCredential

    -- Holders may change without touching ownership: the two axes are
    -- independent.
    choice DemoNameHolding_ReplaceHolders : ContractId DemoNameHolding
      with
        newHolders : [Party]
      controller registryAdminParty :: owner :: newHolders
      do create this with credential = credential with holders = newHolders

-- EQUITY is the divisible layer: a DIFFERENT instrument id with fractional
-- amounts. This is the honest use of amount : Decimal, and the honest fungible
-- Holding implementation. There is no CIP-56 transfer protocol here, so the
-- tests archive and recreate equity holdings as a demo shortcut.
template DemoEquityHolding
  with
    registryAdminParty : Party
    instrumentName : Text
    owner : Party
    amount : Decimal
  where
    signatory owner
    observer registryAdminParty
    ensure amount > 0.0

    interface instance Holding.Holding for DemoEquityHolding where
      view = Holding.HoldingView with
        owner
        instrumentId = Holding.InstrumentId registryAdminParty instrumentName
        amount
        lock = None
        meta = Metadata.emptyMetadata

    choice DemoEquityHolding_Archive : ()
      controller owner
      do pure ()
