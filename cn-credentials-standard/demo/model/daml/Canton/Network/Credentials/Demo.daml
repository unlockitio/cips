module Canton.Network.Credentials.Demo where

import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.NonEmpty qualified as NonEmpty
import DA.TextMap qualified as TextMap
import Splice.Api.Token.MetadataV1 qualified as Metadata

-- A deliberately simple authority model for this non-normative demo.
template DemoCredential
  with
    issuerParty : Party
    authorityParty : Party
    holderParties : NonEmpty Party
    registryAdminParty : Party
    credential : CredentialView
    registeredAt : Time
    expiresAt : Optional Time
    registryMeta : TextMap.TextMap Metadata.AnyValue
  where
    signatory issuerParty
    observer NonEmpty.toList holderParties, registryAdminParty

    ensure credential.issuer == W3C_VC_Identifier_Party issuerParty
      && elem authorityParty (NonEmpty.toList holderParties)
      && credential.holders == holderParties

    interface instance Credential for DemoCredential where
      view = credential

      credential_removeSelfAsHolderImpl _ arg = do
        let remaining = filter (/= arg.holder) (NonEmpty.toList holderParties)
        newHolders <- case remaining of
          [] -> abort "the final holder cannot relinquish the credential"
          first :: rest -> pure (NonEmpty first rest)
        let NonEmpty firstRemaining _ = newHolders
        let newAuthority = if authorityParty == arg.holder then firstRemaining else authorityParty
        replacement <- create this with
          authorityParty = newAuthority
          holderParties = newHolders
          credential = credential with holders = newHolders
        pure Credential_RemoveSelfAsHolderResult with
          replacementCredential = toInterfaceContractId @Credential replacement

      credential_archiveAsAllHoldersImpl _ _ =
        pure Credential_ArchiveResult with
          archivedCredential = credential
          meta = Metadata.emptyMetadata

    interface instance CredentialLifecycle for DemoCredential where
      view = credential

      credentialLifecycle_renewImpl _ arg = do
        assertLater "credential" credential.validUntil arg.validUntil
        replacement <- create this with
          credential = credential with validUntil = Some arg.validUntil
        pure CredentialLifecycle_RenewResult with
          replacementCredential = toInterfaceContractId @CredentialLifecycle replacement

    interface instance RegisteredCredential for DemoCredential where
      view = registeredView this

      registeredCredential_publicFetchImpl _ _ = pure (registeredView this)

    interface instance RegisteredCredentialLifecycle for DemoCredential where
      view = registeredView this

      registeredCredentialLifecycle_renewImpl _ arg = do
        assertMsg "credential view does not match the current contract" (arg.expectedCredential == credential)
        assertMsg "party is not the credential issuer" (arg.issuer == issuerParty)
        assertMsg "party is not the registry administrator" (arg.registryAdmin == registryAdminParty)
        assertLater "credential" credential.validUntil arg.validUntil
        assertLater "registration" expiresAt arg.validUntil
        replacement <- create this with
          credential = credential with validUntil = Some arg.validUntil
          expiresAt = Some arg.validUntil
        pure RegisteredCredentialLifecycle_RenewResult with
          replacementCredential = toInterfaceContractId @RegisteredCredentialLifecycle replacement

template DemoCredentialRegistryFactory
  with
    registryAdminParty : Party
    issuerParty : Party
  where
    signatory registryAdminParty
    observer issuerParty

    interface instance CredentialRegistryFactory for DemoCredentialRegistryFactory where
      view = CredentialRegistryFactoryView with
        registryAdmin = registryAdminParty
        issuer = issuerParty

      credentialRegistryFactory_issueImpl _ arg = do
        issued <- createRegisteredCredential issuerParty arg.credential arg.registration
        pure CredentialRegistryFactory_IssueResult with
          issuedCredential = toInterfaceContractId @RegisteredCredential issued

createRegisteredCredential : Party -> CredentialView -> RegisteredCredentialView -> Update (ContractId DemoCredential)
createRegisteredCredential issuerParty credential registration = do
  let NonEmpty authorityParty _ = credential.holders
  create DemoCredential with
    issuerParty
    authorityParty
    holderParties = credential.holders
    registryAdminParty = registration.registryAdmin
    credential
    registeredAt = registration.registeredAt
    expiresAt = registration.expiresAt
    registryMeta = registration.meta

assertLater : Text -> Optional Time -> Time -> Update ()
assertLater field current replacement = case current of
  None -> abort (field <> " renewal requires an existing expiry")
  Some existing -> assertMsg (field <> " renewal must be strictly later") (replacement > existing)

registeredView : DemoCredential -> RegisteredCredentialView
registeredView credential = RegisteredCredentialView with
  registryAdmin = credential.registryAdminParty
  registeredAt = credential.registeredAt
  expiresAt = credential.expiresAt
  meta = credential.registryMeta

mkClaims : Int -> TextMap.TextMap Metadata.AnyValue
mkClaims n = TextMap.fromList
  [ ("demo.example/category", Metadata.AV_Text (credentialCategory n))
  , ("demo.example/sequence", Metadata.AV_Int n)
  , ("demo.example/active", Metadata.AV_Bool True)
  ]

credentialCategory : Int -> Text
credentialCategory n = case n % 4 of
  0 -> "membership"
  1 -> "training"
  2 -> "eligibility"
  _ -> "attestation"
