module Canton.Network.Credentials.Demo where

import Canton.Network.Credentials.V1
import DA.List (unique)
import DA.NonEmpty (NonEmpty(..))
import DA.NonEmpty qualified as NonEmpty
import DA.TextMap qualified as TextMap
import Splice.Api.Token.MetadataV1 qualified as Metadata

-- A deliberately simple authority model for this non-normative demo.
template DemoCredential
  with
    registryAdminParty : Party
    credential : CredentialView
    registeredAt : Time
    expiresAt : Optional Time
    registryMeta : TextMap.TextMap Metadata.AnyValue
  where
    signatory credentialSignatories credential
    observer registryAdminParty
    ensure unique credential.holders && unique (NonEmpty.toList credential.anchorers)
      && partyIssuerIsAnchorer credential && credentialStructurallyValid credential

    interface instance Credential for DemoCredential where
      view = credential

      credential_publicFetchImpl _ _ = pure credential

      credential_removeSelfAsHolderImpl _ arg = do
        let remaining = filter (/= arg.holder) credential.holders
        replacement <- create this with
          credential = credential with holders = remaining
        pure Credential_RemoveSelfAsHolderResult with
          replacementCredential = toInterfaceContractId @Credential replacement

      credential_archiveAsAllHoldersImpl _ _ =
        pure Credential_ArchiveResult with
          archivedCredential = credential
          meta = Metadata.emptyMetadata

    interface instance CredentialLifecycle for DemoCredential where
      view = credential

      credentialLifecycle_renewImpl _ _ =
        abort "registered credential requires explicit registry authorization for intrinsic renewal"

    interface instance RegisteredCredential for DemoCredential where
      view = registeredView this

      registeredCredential_publicFetchImpl _ _ = pure RegisteredCredential_PublicFetchResult with
        credential
        registration = registeredView this

    interface instance RegisteredCredentialLifecycle for DemoCredential where
      view = registeredView this

      registeredCredentialLifecycle_renewImpl _ arg = do
        assertMsg "credential view does not match the current contract" (arg.expectedCredential == credential)
        assertMsg "party is not the registry administrator" (arg.registryAdmin == registryAdminParty)
        assertLater "credential" credential.validUntil arg.validUntil
        replacement <- create this with
          credential = credential with validUntil = Some arg.validUntil; securing = arg.newSecuring
        pure RegisteredCredentialLifecycle_RenewResult with
          replacementCredential = toInterfaceContractId @RegisteredCredentialLifecycle replacement

      registeredCredentialLifecycle_extendRegistrationImpl _ arg = do
        assertMsg "credential view does not match the current contract" (arg.expectedCredential == credential)
        assertMsg "party is not the registry administrator" (arg.registryAdmin == registryAdminParty)
        assertLater "registration" expiresAt arg.expiresAt
        replacement <- create this with expiresAt = Some arg.expiresAt
        pure RegisteredCredentialLifecycle_ExtendRegistrationResult with
          replacementCredential = toInterfaceContractId @RegisteredCredentialLifecycle replacement

template DemoCredentialRegistryFactory
  with
    registryAdminParty : Party
    anchorers : NonEmpty Party
  where
    signatory registryAdminParty
    observer NonEmpty.toList anchorers

    interface instance CredentialRegistryFactory for DemoCredentialRegistryFactory where
      view = CredentialRegistryFactoryView with
        registryAdmin = registryAdminParty
        anchorers

      credentialRegistryFactory_issueImpl _ arg = do
        issued <- createRegisteredCredential arg.credential arg.registration
        pure CredentialRegistryFactory_IssueResult with
          issuedCredential = toInterfaceContractId @RegisteredCredential issued

      credentialRegistryFactory_anchorImpl _ arg = do
        issued <- createRegisteredCredential arg.credential arg.registration
        pure CredentialRegistryFactory_IssueResult with
          issuedCredential = toInterfaceContractId @RegisteredCredential issued

-- A request exposes only routing and the requested type, never a proposed credential.
template DemoCredentialRequest
  with
    holder : Party
    requestedType : Text
    registryAdmin : Party
    anchorers : NonEmpty Party
  where
    signatory holder
    observer registryAdmin, NonEmpty.toList anchorers
    ensure requestedType /= "" && unique (NonEmpty.toList anchorers)

    interface instance CredentialRequest for DemoCredentialRequest where
      view = CredentialRequestView with holder; requestedType; registryAdmin; anchorers

      credentialRequest_fulfillImpl _ _ = pure ()
      credentialRequest_cancelImpl _ _ = pure ()

-- The offer signatories preauthorize the complete immutable payload. The holder
-- supplies only acceptance authority, plus disclosure of the factory if needed.
template DemoCredentialOffer
  with
    request : ContractId CredentialRequest
    holder : Party
    requestedType : Text
    registryAdmin : Party
    anchorers : NonEmpty Party
    factory : ContractId CredentialRegistryFactory
    credential : CredentialView
    registration : RegisteredCredentialView
  where
    signatory NonEmpty.toList anchorers <> issuerParty credential.issuer <> [registryAdmin]
    observer holder
    ensure unique (NonEmpty.toList anchorers)
      && unique (NonEmpty.toList credential.anchorers)
      && unique credential.holders
      && partyIssuerIsAnchorer credential
      && credentialStructurallyValid credential
      && elem requestedType credential.credentialTypes
      && elem holder credential.holders
      && anchorers == credential.anchorers
      && registryAdmin == registration.registryAdmin

    interface instance CredentialOffer for DemoCredentialOffer where
      view = CredentialOfferView with
        request; holder; requestedType; registryAdmin; anchorers; factory; credential; registration

      credentialOffer_acceptImpl _ _ = do
        requested <- fetch request
        let routing = view requested
        assertMsg "offer does not match the active request"
          (routing.holder == holder && routing.requestedType == requestedType
            && routing.registryAdmin == registryAdmin && routing.anchorers == anchorers)
        exercise request CredentialRequest_Fulfill
        result <- case credential.issuer of
          W3C_VC_Identifier_Party _ -> exercise factory CredentialRegistryFactory_Issue with credential; registration
          W3C_VC_Identifier _ -> exercise factory CredentialRegistryFactory_Anchor with credential; registration
        pure result.issuedCredential

      credentialOffer_rejectImpl _ _ = pure ()
      credentialOffer_withdrawImpl _ _ = pure ()

credentialSignatories : CredentialView -> [Party]
credentialSignatories credential = NonEmpty.toList credential.anchorers <> credential.holders

createRegisteredCredential : CredentialView -> RegisteredCredentialView -> Update (ContractId DemoCredential)
createRegisteredCredential credential registration = do
  create DemoCredential with
    registryAdminParty = registration.registryAdmin
    credential
    registeredAt = registration.registeredAt
    expiresAt = registration.expiresAt
    registryMeta = registration.meta

assertLater : Text -> Optional Time -> Time -> Update ()
assertLater field current replacement = case current of
  None -> abort (field <> " renewal requires an existing expiry")
  Some existing -> assertMsg (field <> " renewal must be strictly later") (replacement > existing)

registeredView : DemoCredential -> RegisteredCredentialView
registeredView credential = RegisteredCredentialView with
  registryAdmin = credential.registryAdminParty
  registeredAt = credential.registeredAt
  expiresAt = credential.expiresAt
  meta = credential.registryMeta

mkClaims : Int -> TextMap.TextMap Metadata.AnyValue
mkClaims n = TextMap.fromList
  [ ("demo.example/category", Metadata.AV_Text (credentialCategory n))
  , ("demo.example/sequence", Metadata.AV_Int n)
  , ("demo.example/active", Metadata.AV_Bool True)
  ]

credentialCategory : Int -> Text
credentialCategory n = case n % 4 of
  0 -> "membership"
  1 -> "training"
  2 -> "eligibility"
  _ -> "attestation"
