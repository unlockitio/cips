module Canton.Network.Credentials.DemoProfiles where

import Canton.Network.Credentials.V1
import DA.NonEmpty (NonEmpty(..))
import DA.TextMap qualified as TextMap
import Splice.Api.Token.MetadataV1 qualified as Metadata

-- One subject with several claims, or one subject and claim per credential.
-- The issuer and the subject are independent of the holder.
partyProfileCredential : CredentialView -> Party -> Party -> TextMap.TextMap Metadata.AnyValue -> CredentialView
partyProfileCredential base issuer subject claims = base with
  issuer = W3C_VC_Identifier_Party issuer
  credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier_Party subject)) claims) []
